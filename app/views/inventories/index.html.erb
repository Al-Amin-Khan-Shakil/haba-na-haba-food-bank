<h1 class="text-xl font-bold mb-4">Inventories</h1>
<table class="min-w-full bg-white border border-gray-200 shadow-sm rounded">
  <thead>
    <tr class="bg-gray-100">
      <th class="text-left px-4 py-2">Name</th>
      <th class="text-left px-4 py-2">Amount</th>
      <th class="text-left px-4 py-2">Expire Date</th>
      <th class="text-left px-4 py-2">Collection Place</th>
      <th class="text-left px-4 py-2">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @inventories.each do |inventory| %>
      <tr class="border-t hover:bg-gray-50">
        <td class="px-4 py-2"><%= inventory.name %></td>
        <td class="px-4 py-2"><%= inventory.amount %></td>
        <td class="px-4 py-2"><%= inventory.expire_date %></td>
        <td class="px-4 py-2"><%= inventory.collection_place %></td>
        <td class="px-4 py-2">
          <%= link_to "Show", inventory_path(inventory), class: "text-blue-600 hover:underline" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
