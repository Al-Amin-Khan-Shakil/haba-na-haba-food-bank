<div class="overflow-x-auto">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Expire Date</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Cost of Item</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% inventories.each do |inventory| %>
        <tr>
          <td class="px-6 py-4 whitespace-nowrap"><%= inventory.name %></td>
          <td class="px-6 py-4 whitespace-nowrap"><%= inventory.expire_date %></td>
          <td class="px-6 py-4 whitespace-nowrap"><%= inventory.amount %></td>
          <td class="px-6 py-4 whitespace-nowrap"><%= inventory.cost_of_item %></td>
          <td class="px-6 py-4 whitespace-nowrap">
            <%= link_to 'View', inventory, class: 'text-blue-600 hover:text-blue-800' %>
            <%= link_to 'Edit', edit_inventory_path(inventory), class: "text-indigo-600 hover:text-indigo-900" %>
            <%= button_to 'Delete', inventory_path(inventory), method: :delete, data: { confirm: 'Are you sure?' }, class: "text-red-600 hover:text-red-900" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>