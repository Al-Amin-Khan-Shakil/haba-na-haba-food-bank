<div class="overflow-x-auto">
  <table class="min-w-full max-h-fit bg-white shadow-md rounded-lg border-x border-gray-100 data-table">
    <thead>
      <tr class="text-primarytext bg-sky-50">
        <th class="px-6 py-3 text-left font-Outfit text-base font-bold tracking-wider w-1/5">Name</th>
        <th class="px-6 py-3 text-left font-Outfit text-base font-bold tracking-wider w-1/5">Amount</th>
        <th class="px-6 py-3 text-left font-Outfit text-base font-bold tracking-wider w-1/5">Expire Date</th>
        <th class="px-6 py-3 text-left font-Outfit text-base font-bold tracking-wider w-1/5">Phone</th>
        <th class="px-6 py-3 text-center font-Outfit text-base font-bold tracking-wider w-1/5">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @inventories.each do |inventory| %>
        <tr class="hover:bg-gray-100 border-b border-b-gray-100">
          <td class="px-6 py-4 text-sm font-semibold font-Outfit text-[#5a607a] w-1/5"><%= inventory&.name %></td>
          <td class="px-6 py-4 text-sm font-semibold font-Outfit text-[#5a607a] w-1/5"><%= inventory&.amount %></td>
          <td class="px-6 py-4 text-sm font-semibold font-Outfit text-[#5a607a] w-1/5"><%= inventory&.expire_date %></td>
          <td class="px-6 py-4 text-sm font-semibold font-Outfit text-[#5a607a] w-1/5"><%= inventory&.phone_number %></td>
          <td class="px-6 py-3 text-center text-sm font-Outfit text-[#5a607a] w-1/5">
            <div class="relative">
              <button data-dropdown-toggle="dropdown-<%= inventory.id %>" class="text-gray-600 focus:outline-none focus:ring-2 focus:ring-gray-300 border border-lightGreen rounded" type="button">
                <div class="p-1 flex flex-row justify-center items-center  space-between">
                  <span class="hidden md:block lg:block mr-1" >Actions</span>
                  <i class="fa-solid fa-chevron-down"></i>
                </div>
              </button>
              <div id="dropdown-<%= inventory.id %>" class="absolute right-0 mt-2 w-32 bg-white border rounded-lg shadow-lg z-10 hidden overflow-hidden font-Outfit font-semibold">
                <%= link_to 'Details', inventory_path(inventory), class: 'block px-4 py-2 text-primarycolor hover:bg-gray-100' %>
                <%= link_to 'Edit', edit_inventory_path(inventory), class: 'block px-4 py-2 text-primarytext hover:bg-gray-100' %>
                <%= button_to 'Delete', inventory_path(inventory), method: :delete, data: { confirm: 'Are you sure?' }, class: 'block px-10 py-2 text-red-600 hover:bg-gray-100 text-center' %>
              </div>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>