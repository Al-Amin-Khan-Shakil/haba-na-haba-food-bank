<% form_url = if @inventory&.persisted?
                inventory_path(@inventory)
              elsif @event
                event_inventories_path(@event)
              else
                request_inventory_path(@request)
              end %>
<% method = @inventory&.persisted? ? :patch : :post %>
<%= form_with(model: @inventory, url: form_url, method: method, local: true, data: { controller: "location", turbo: true }) do |f| %>
  <section class="custom-select md:p-10 sm:px-6 lg:px-8 py-8 sm:text-sm md:text-base lg:text-lg">
    <div class="bg-gradient-to-tr from-white from-40% via-primarycolor/50 via-90% to-red-600/40 to-100% transition duration-300 hover:shadow-xl md:p-12 p-4 rounded-lg shadow-lg">
      <div class="flex justify-between items-center h-auto gap-4 my-4">
        <button onclick="history.go(-1)" class="border rounded-lg flex items-center text-sm sm:text-base bg-gray-50 px-5 py-2 transition duration-300 ease-in-out">
          <i class="fa-solid fa-arrow-left"></i>
          <span class="ml-2 hidden lg:inline-block">Back</span>
        </button>
        <h2 class="text-3xl text-primarytextcolor font-bold text-center leading-tight">
          <span>
            <%= @inventory.persisted? ? "Edit" : "Create" %>
          </span>
          <span class="hidden md:inline-block">
            Inventory
          </span>
        </h2>
      </div>
      <div class="bg-white/50 md:px-8 md:py-4 py-2 px-4 border rounded-lg">
        <h3 class="text-xl my-4 font-semibold text-primarytextcolor mb-3 hover:text-gray-900 transition duration-200 underline">Basic Information</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="mb-4">
            <%= f.label :name, class: "block text-gray-700 font-bold mb-2" %>
            <%= f.text_field :name, value: @inventory&.name || @inventory&.donation&.donation_name || @request&.donation&.donation_name, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
          </div>
          <div class="mb-4">
            <%= f.label :amount, class: "block text-gray-700 font-bold mb-2" %>
            <%= f.number_field :amount, value: @inventory&.amount || @inventory&.donation&.amount || @request&.donation&.amount, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
          </div>
          <div class="mb-4">
            <%= f.label :cost_of_item, class: "block text-gray-700 font-bold mb-2" %>
            <%= f.number_field :cost_of_item, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
          </div>
          <div class="mb-4">
            <%= f.label :expire_date, class: "block text-gray-700 font-bold mb-2" %>
            <%= f.date_field :expire_date, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
          </div>
        </div>
        <h3 class="text-xl my-4 font-semibold text-primarytextcolor mb-3 hover:text-gray-900 transition duration-200 underline">Contact Information</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="mb-4">
            <%= f.label :collection_place, class: "block text-gray-700 font-bold mb-2" %>
            <%= f.text_field :collection_place, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
          </div>
          <div class="mb-4">
            <%= f.label :phone_number, class: "block text-gray-700 font-bold mb-2" %>
            <%= f.text_field :phone_number, value: @inventory&.phone_number || @request&.donation&.phone_number, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
          </div>
          <div class="mb-4 md:col-span-2">
            <%= f.label :donor_name, class: "block text-gray-700 font-bold mb-2" %>
            <%= f.text_field :donor_name, value: @inventory&.donor_name || @request&.donation&.donor_name, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
          </div>
        </div>
        <h3 class="text-xl my-4 font-semibold text-primarytextcolor mb-3 hover:text-gray-900 transition duration-200 underline">Location Information</h3>
        <div data-controller="location" data-location-base-path-value="<%= controller.controller_name %>">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="mb-4">
              <%= f.label :district_id, "District", class: "block text-gray-700 font-bold mb-2" %>
              <%= f.collection_select :district_id, @districts, :id, :name, {
                include_blank: "Select District", selected: @inventory.district_id || @request&.district_id },
                { class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor",
                  data: {
                    location_target: "district",
                    action: "change->location#loadCounties"
                  }
                } %>
            </div>
            <div class="mb-4">
              <%= f.label :county_id, "County", class: "block text-gray-700 font-bold mb-2" %>
              <%= f.select :county_id,
                options_from_collection_for_select(@counties, :id, :name,
                  @inventory&.county_id || @request&.county_id),
                  { include_blank: "Select County" },
                  { class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor",
                    data: {
                      location_target: "county",
                      action: "change->location#loadSubCounties",
                      initial_selection: (@inventory&.county_id || @request&.county_id)
                    }
                  } %>
            </div>
            <div class="mb-4">
              <%= f.label :sub_county_id, "Sub-county", class: "block text-gray-700 font-bold mb-2" %>
              <%= f.select :sub_county_id,
                options_from_collection_for_select(@sub_counties, :id, :name,
                  @inventory&.sub_county_id || @request&.sub_county_id),
                  { include_blank: "Select Sub-county" },
                  { class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor",
                    data: {
                      location_target: "subCounty",
                      initial_selection: (@inventory&.sub_county_id || @request&.sub_county_id)
                    }
                  } %>
            </div>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="mb-4">
            <%= f.label :branch_id, "Branch", class: "block text-gray-700 font-bold mb-2" %>
            <%= f.collection_select :branch_id, @branches, :id, :name,
              { selected: @inventory&.branch_id || @request&.branch_id, prompt: "Select Branch" },
              class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
          </div>
          <div class="mb-4">
            <%= f.label :event_id, "Event", class: "block text-gray-700 font-bold mb-2" %>
            <%= f.collection_select :event_id, @events, :id, :title,
              { prompt: "Select Event" },
              class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
          </div>
        </div>
        <div class="mb-4">
          <%= f.hidden_field :donation_id, value: @inventory.donation_id || @request&.donation&.id %>
          <label class="block text-gray-700 font-bold mb-2">Donated by</label>
          <p class="bg-gray-50 border border-gray-300 rounded-lg p-2">
            <%= @inventory.donation&.donor_type&.humanize || @request&.donation&.donor_type&.humanize || "Collected from #{@event.title}" %>
          </p>
        </div>
        <div class="flex justify-center md:justify-end text-sm items-center mt-12 cursor-pointer">
          <%= link_to "Cancel", :back, class: "bg-gray-200 hover:bg-gray-300 text-gray-700 font-medium py-2 px-4 rounded text-sm transition duration-200 transform hover:scale-105" %>
          <%= f.submit @inventory.persisted? ? "Update" : "Create", class: "ml-2 bg-primarycolor hover:bg-hoverprimarycolor text-white font-bold py-2 px-6 rounded" %>
        </div>
      </div>
    </div>
  </section>
<% end %>