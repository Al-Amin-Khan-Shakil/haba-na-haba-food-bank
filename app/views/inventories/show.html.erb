<div class="sm:p-4 md:p-6 lg:p-8 bg-gray-50">
  <div class="min-w-full bg-gradient-to-tr from-white from-40% via-primarycolor/50 via-90% to-red-600/40 to-100% text-white shadow-xl rounded-xl p-3 sm:p-8 mb-8">
    <div class="flex justify-between items-center mb-4">
      <button onclick="history.go(-1)" class="flex items-center text-sm sm:text-base text-gray-500 py-1 px-4 rounded bg-gray-200 hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400 transition duration-300 ease-in-out">
        <i class="fa-solid fa-arrow-left"></i>
        <span class="ml-2 hidden lg:inline-block">Back</span>
      </button>
      <h2 class="text-lg lg:text-3xl text-primarytext font-bold text-center leading-tight">Details</h2>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 md:gap-6 lg:gap-8">
      <div class="bg-white p-3 sm:p-6 rounded-lg shadow-lg hover:shadow-2xl transition-all duration-300 ease-in-out">
        <h3 class="text-lg sm:text-xl font-semibold text-primarytext mb-4 underline">Inventory Information</h3>
        <div class="space-y-4">
          <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
            <div class="flex items-start gap-1 sm:gap-3 w-fit">
              <div class="w-[23px]"><i class="fa-solid fa-cart-flatbed text-sm text-primarycolor sm:text-lg"></i></div>
              <p class="font-medium text-sm sm:text-base text-gray-700">Name</p>
            </div>
            <div class="flex-1 flex justify-end items-start">
              <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= @inventory&.name %></p>
            </div>
          </div>
          <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
            <div class="flex items-start gap-1 sm:gap-3 w-fit">
              <div class="w-[23px]"><i class="fa-solid fa-chart-column text-sm text-primarycolor sm:text-lg"></i></div>
              <p class="font-medium text-sm sm:text-base text-gray-700">Amount</p>
            </div>
            <div class="flex-1 flex justify-end items-start">
              <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= @inventory&.amount %></p>
            </div>
          </div>
          <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
            <div class="flex items-start gap-1 sm:gap-3 w-fit">
              <div class="w-[23px]"><i class="fa-solid fa-triangle-exclamation text-sm text-primarycolor sm:text-lg"></i></div>
              <p class="font-medium text-sm sm:text-base text-gray-700">Expire Date</p>
            </div>
            <div class="flex-1 flex justify-end items-start">
              <p class="text-sm sm:text-base font-medium text-[#5a607a]"><%= @inventory&.expire_date %></p>
            </div>
          </div>
          <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
            <div class="flex items-start gap-1 sm:gap-3 w-fit">
              <div class="w-[23px]"><i class="fa-solid fa-sack-xmark text-sm text-primarycolor sm:text-lg"></i></div>
              <p class="font-medium text-sm sm:text-base text-gray-700">Cost of Item</p>
            </div>
            <div class="flex-1 flex justify-end items-start">
              <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= @inventory&.cost_of_item %></p>
            </div>
          </div>
        </div>
      </div>
      <div class="bg-white p-3 sm:p-6 rounded-lg shadow-lg hover:shadow-2xl transition-all duration-300 ease-in-out">
        <h3 class="text-lg sm:text-xl font-semibold text-primarytext mb-4 underline">Donor Information</h3>
        <div class="space-y-4">
          <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
            <div class="flex items-start gap-1 sm:gap-3 w-fit">
              <div class="w-[23px]"><i class="fa-solid fa-user text-sm text-primarycolor sm:text-lg"></i></div>
              <p class="font-medium text-sm sm:text-base text-gray-700">Name</p>
            </div>
            <div class="flex-1 flex justify-end items-start">
              <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= @inventory&.donor_name %></p>
            </div>
          </div>
          <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
            <div class="flex items-start gap-1 sm:gap-3 w-fit">
              <div class="w-[23px]"><i class="fa-solid fa-handshake text-sm text-primarycolor sm:text-lg"></i></div>
              <p class="font-medium text-sm sm:text-base text-gray-700">Type</p>
            </div>
            <div class="flex-1 flex justify-end items-start">
              <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= @inventory&.donation&.donor_type %></p>
            </div>
          </div>
          <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
            <div class="flex items-start gap-1 sm:gap-3 w-fit">
              <div class="w-[23px]"><i class="fa-solid fa-phone text-sm text-primarycolor sm:text-lg"></i></div>
              <p class="font-medium text-sm sm:text-base text-gray-700">Phone</p>
            </div>
            <div class="flex-1 flex justify-end items-start">
              <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= @inventory&.phone_number %></p>
            </div>
          </div>
          <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
            <div class="flex items-start gap-1 sm:gap-3 w-fit">
              <div class="w-[23px]"><i class="fa-solid fa-map-marker-alt text-sm text-primarycolor sm:text-lg"></i></div>
              <p class="font-medium text-sm sm:text-base text-gray-700">Collection Place</p>
            </div>
            <div class="flex-1 flex justify-end items-start">
              <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= @inventory&.collection_place %></p>
            </div>
          </div>
        </div>
      </div>
      <div class="bg-white p-3 sm:p-6 rounded-lg shadow-lg hover:shadow-2xl transition-all duration-300 ease-in-out col-span-1 lg:col-span-2">
        <h3 class="text-lg sm:text-xl font-semibold text-primarytext mb-4 underline">Collection Location</h3>
        <div class="space-y-4">
          <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
            <div class="flex items-start gap-1 sm:gap-3 w-fit">
              <div class="w-[23px]"><i class="fa-solid fa-map text-sm text-primarycolor sm:text-lg"></i></div>
              <p class="font-medium text-sm sm:text-base text-gray-700">District</p>
            </div>
            <div class="flex-1 flex justify-end items-start">
              <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= @inventory&.district.name %></p>
            </div>
          </div>
          <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
            <div class="flex items-start gap-1 sm:gap-3 w-fit">
              <div class="w-[23px]"><i class="fa-solid fa-map-pin text-sm text-primarycolor sm:text-lg"></i></div>
              <p class="font-medium text-sm sm:text-base text-gray-700">County</p>
            </div>
            <div class="flex-1 flex justify-end items-start">
              <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= @inventory&.county.name %></p>
            </div>
          </div>
          <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
            <div class="flex items-start gap-1 sm:gap-3 w-fit">
              <div class="w-[23px]"><i class="fa-solid fa-location text-sm text-primarycolor sm:text-lg"></i></div>
              <p class="font-medium text-sm sm:text-base text-gray-700">Sub-County</p>
            </div>
            <div class="flex-1 flex justify-end items-start">
              <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= @inventory&.sub_county.name %></p>
            </div>
          </div>
          <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
            <div class="flex items-start gap-1 sm:gap-3 w-fit">
              <div class="w-[23px]"><i class="fa-solid fa-map-marked-alt text-sm text-primarycolor sm:text-lg"></i></div>
              <p class="font-medium text-sm sm:text-base text-gray-700">Branch</p>
            </div>
            <div class="flex-1 flex justify-end items-start">
              <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= @inventory&.branch&.name %></p>
            </div>
          </div>
          <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
            <div class="flex items-start gap-1 sm:gap-3 w-fit">
              <div class="w-[23px]"><i class="fa-solid fa-calendar-days text-sm text-primarycolor sm:text-lg"></i></div>
              <p class="font-medium text-sm sm:text-base text-gray-700">Event</p>
            </div>
            <div class="flex-1 flex justify-end items-start">
              <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= @inventory&.event&.title %></p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="mt-8 flex justify-end items-center gap-4 ">
      <%= link_to 'Edit', edit_inventory_path(@inventory), class: 'cursor-pointer bg-primarycolor text-white py-1 px-4 w-fit rounded hover:bg-hoverprimarycolor transition-all text-sm sm:text-base' %>
      <%= button_to 'Destroy', inventory_path(@inventory), method: :delete, data: { confirm: 'Are you sure?' }, class: 'cursor-pointer bg-red-600 text-white py-1 px-4 w-fit rounded hover:bg-red-700 transition-all text-sm sm:text-base' %>
    </div>
  </div>
</div>