<%# app/views/family_beneficiaries/show.html.erb %>
<div class="px-4 py-8 mx-auto max-w-4xl sm:px-6 lg:px-8">
  <div class="overflow-hidden bg-white shadow sm:rounded-lg">
    <div class="px-4 py-5 border-b border-gray-200 sm:px-6">
      <div class="flex justify-between items-center">
        <h1 class="text-2xl font-bold text-gray-900">
          Family Case: <%= @family_beneficiary.case_name.presence || 'No Name Provided' %>
        </h1>
        
      </div>
    </div>

    <div class="px-4 py-5 sm:p-6">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        <div>
          <h2 class="mb-4 text-lg font-medium text-gray-900">Family Composition</h2>
          <dl class="grid grid-cols-1 gap-x-4 gap-y-4 sm:grid-cols-2">
            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Total Members</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @family_beneficiary.family_members %></dd>
            </div>
            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Males</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @family_beneficiary.male %></dd>
            </div>
            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Females</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @family_beneficiary.female %></dd>
            </div>
            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Children</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @family_beneficiary.children %></dd>
            </div>
            <div class="sm:col-span-2">
              <dt class="text-sm font-medium text-gray-500">Adult Age Range</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @family_beneficiary.adult_age_range %></dd>
            </div>
            <div class="sm:col-span-2">
              <dt class="text-sm font-medium text-gray-500">Children Age Range</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @family_beneficiary.children_age_range %></dd>
            </div>
          </dl>
        </div>

        <div>
          <h2 class="mb-4 text-lg font-medium text-gray-900">Case Information</h2>
          <dl class="space-y-4">
            <div>
              <dt class="text-sm font-medium text-gray-500">Case Name</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @family_beneficiary.case_name %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Description</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @family_beneficiary.case_description || 'No description provided' %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Phone Number</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @family_beneficiary.phone_number %></dd>
            </div>
          </dl>
        </div>

        <div class="md:col-span-2">
          <h2 class="mb-4 text-lg font-medium text-gray-900">Address</h2>
          <dl class="grid grid-cols-1 gap-x-4 gap-y-4 sm:grid-cols-3">
            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Village</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @family_beneficiary.village %></dd>
            </div>
            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Parish</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @family_beneficiary.parish %></dd>
            </div>
            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Residence Address</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @family_beneficiary.residence_address %></dd>
            </div>
          </dl>
        </div>

        <div class="md:col-span-2">
          <h2 class="mb-4 text-lg font-medium text-gray-900">Parental Information</h2>
          <dl class="grid grid-cols-1 gap-x-4 gap-y-4 sm:grid-cols-2">
            <div>
              <dt class="text-sm font-medium text-gray-500">Father's Name</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @family_beneficiary.fathers_name %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Father's Occupation</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @family_beneficiary.fathers_occupation %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Mother's Name</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @family_beneficiary.mothers_name %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Mother's Occupation</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @family_beneficiary.mothers_occpation %></dd>
            </div>
          </dl>
        </div>

        <div class="md:col-span-2">
          <h2 class="mb-4 text-lg font-medium text-gray-900">Meals & Essentials</h2>
          <dl class="grid grid-cols-1 gap-x-4 gap-y-4 sm:grid-cols-2">
            <div>
              <dt class="text-sm font-medium text-gray-500">Meals at Home (per day)</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @family_beneficiary.number_of_meals_home %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Meals at School (per day)</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @family_beneficiary.number_of_meals_school %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Basic FEH</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @family_beneficiary.basic_FEH %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Basic FES</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @family_beneficiary.basic_FES %></dd>
            </div>
            <%= button_to 'Delete Family Beneficiary', family_beneficiary_path(@family_beneficiary), method: :delete, data: { confirm: 'Are you sure you want to delete this record?' }, class: "btn btn-danger" %>
          </dl>
        </div>
      </div>
    </div>
  </div>
</div>
