 <div class="mb-6 font-Outfit text-[#5a607a]">
    <div class="filter-form space-y-4 mt-4 ">
    <% input_classes = "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
    <% select_classes = "form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
    
    <%= form_with url: family_beneficiaries_path, method: :get, local: true, class: "space-y-4" do |form| %>
      <div class="flex flex-wrap gap-4">
        <%# Parent Names %>
        <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
          <%= form.label :fathers_name, "Father", class: "block text-gray-700" %>
          <%= form.text_field :fathers_name, value: params[:fathers_name], class: input_classes %>
        </div>
    
        <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
          <%= form.label :mothers_name, "Mother", class: "block text-gray-700" %>
          <%= form.text_field :mothers_name, value: params[:mothers_name], class: input_classes %>
        </div>
    
        <%# Case and Contact Info %>
        <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
          <%= form.label :case_name, "Case", class: "block text-gray-700" %>
          <%= form.text_field :case_name, value: params[:case_name], class: input_classes %>
        </div>
    
        <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
          <%= form.label :phone_number, "Phone", class: "block text-gray-700" %>
          <%= form.text_field :phone_number, value: params[:phone_number], class: input_classes %>
        </div>
    
        <%# Members count %>
        <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
          <%= form.label :min_member, "Min Member", class: "block text-gray-700" %>
          <%= form.number_field :min_member, value: params[:min_member], class: input_classes %>
        </div>
    
        <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
          <%= form.label :max_member, "Max Member", class: "block text-gray-700" %>
          <%= form.number_field :max_member, value: params[:max_member], class: input_classes %>
        </div>
    
        <%# Location-based filters %>
        <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
          <%= form.label :district_id, "District", class: "block text-gray-700" %>
          <%= form.collection_select :district_id, @districts, :id, :name, { prompt: "Select District" }, { class: "#{select_classes} district-select", 'data-context-path': "family_beneficiaries" } %>
        </div>
    
        <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
          <%= form.label :county_id, "County", class: "block text-gray-700" %>
          <%= form.collection_select :county_id, @counties, :id, :name, { prompt: "Select County" }, { class: "#{select_classes} county-select", 'data-context-path': "family_beneficiaries" } %>
        </div>
    
        <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
          <%= form.label :sub_county_id, "Sub-County", class: "block text-gray-700" %>
          <%= form.collection_select :sub_county_id, @sub_counties, :id, :name, { prompt: "Select Sub-County" }, { class: "#{select_classes} sub-county-select" } %>
        </div>
    
        <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
          <%= form.label :branch_id, "Branch", class: "block text-gray-700" %>
          <%= form.collection_select :branch_id, @branches, :id, :name, { prompt: "Select Branch" }, { class: select_classes } %>
        </div>
    
        <%# Date range %>
        <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
          <%= form.label :start_date, "Start Date", class: "block text-gray-700" %>
          <%= form.date_field :start_date, value: params[:start_date], class: input_classes %>
        </div>
    
        <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
          <%= form.label :end_date, "End Date", class: "block text-gray-700" %>
          <%= form.date_field :end_date, value: params[:end_date], class: input_classes %>
        </div>
    
        <%# Provided Food status %>
        <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
          <%= form.label :provided_food, "Provided", class: "block text-gray-700" %>
          <%= form.select :provided_food,
                          [["-- Select --", ""], ["Provided", "provided"], ["Not Provided", "not_provided"]],
                          {}, class: select_classes %>
        </div>
      </div>
    
      <!-- Submit & Reset Buttons -->
      <div class="mt-4 flex gap-2">
        <%= form.submit "Filter", class: "bg-blue-600 text-white py-1 px-4 rounded hover:bg-lime-500" %>
        <%= link_to "Reset", family_beneficiaries_path, class: "bg-blue-600 text-white py-1 px-4 rounded hover:bg-lime-500" %>
      </div>
    <% end %>
    
    </div>
  </div>
<div class="px-4 py-8 mx-auto max-w-7xl sm:px-6 lg:px-8">
  <div class="mb-8 sm:flex sm:items-center sm:justify-between">
    <h1 class="text-2xl font-bold leading-tight text-gray-900">Family Beneficiaries</h1>
  </div>
  <div class="overflow-hidden bg-white shadow sm:rounded-lg">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-xs font-medium tracking-wider text-left text-gray-500 uppercase">Name</th>
            <th scope="col" class="px-6 py-3 text-xs font-medium tracking-wider text-left text-gray-500 uppercase">Total Members</th>
            <th scope="col" class="px-6 py-3 text-xs font-medium tracking-wider text-left text-gray-500 uppercase">Male</th>
            <th scope="col" class="px-6 py-3 text-xs font-medium tracking-wider text-left text-gray-500 uppercase">Female</th>
            <th scope="col" class="hidden px-6 py-3 text-xs font-medium tracking-wider text-left text-gray-500 uppercase md:table-cell">Phone</th>
            <th scope="col" class="hidden px-6 py-3 text-xs font-medium tracking-wider text-left text-gray-500 uppercase sm:table-cell">District</th>
            <th scope="col" class="px-6 py-3 text-xs font-medium tracking-wider text-right text-gray-500 uppercase">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @family_beneficiaries.each do |beneficiary| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900">
                  <%= beneficiary.case_name %>
                </div>
              </td>
              <td class="px-6 py-4 text-sm text-gray-500 whitespace-nowrap">
                <%= beneficiary.family_members %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-500 whitespace-nowrap">
                <%= beneficiary.male %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-500 whitespace-nowrap">
                <%= beneficiary.female %>
              </td>
              <td class="hidden px-6 py-4 text-sm text-gray-500 whitespace-nowrap md:table-cell">
                <%= beneficiary.phone_number %>
              </td>
              <td class="hidden px-6 py-4 text-sm text-gray-500 whitespace-nowrap sm:table-cell">
                <%= beneficiary.district&.name %>
              </td>
              <td class="px-6 py-4 text-sm font-medium text-right whitespace-nowrap">
                <div class="flex justify-end space-x-2">
                  <%= link_to 'View', family_beneficiary_path(beneficiary), class: "text-blue-600 hover:text-blue-900" %>
                  <%= link_to 'Edit', edit_family_beneficiary_path(beneficiary), class: "text-indigo-600 hover:text-indigo-900" %>
                  <%= button_to 'Delete', family_beneficiary_path(beneficiary), method: :delete, data: { confirm: 'Are you sure?' }, class: "text-red-600 hover:text-red-900" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
