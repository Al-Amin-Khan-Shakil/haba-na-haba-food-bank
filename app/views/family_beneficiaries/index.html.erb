<div class="p-4 md:p-8">
  <h2 class="text-2xl font-bold leading-tight text-primarytext">Family Beneficiaries</h2>
  <div class="px-4 py-8 mx-auto max-w-7xl sm:px-6 lg:px-8">
 <div class="mb-6 font-Outfit text-[#5a607a]">
    <div class="filter-form space-y-4 mt-4 ">
    <% input_classes = "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-primarycolor focus:border-primarycolor" %>
    <% select_classes = "form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-primarycolor focus:border-primarycolor" %>
    
    <div class="filter-form bg-white p-6 rounded-lg shadow-md ">
    <%= form_with url: family_beneficiaries_path, method: :get, local: true, class: "space-y-6" do |form| %>
      <h3  class="text-lg font-semibold text-gray-800 mb-4">Filter Family Beneficiaries</h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Parent Information -->
        <div class="space-y-2">
          <%= form.label :fathers_name, "Father's Name", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :fathers_name, value: params[:fathers_name], class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
        </div>
        
        <div class="space-y-2">
          <%= form.label :mothers_name, "Mother's Name", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :mothers_name, value: params[:mothers_name], class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
        </div>
        
        <!-- Case and Contact Info -->
        <div class="space-y-2">
          <%= form.label :case_name, "Case Name", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :case_name, value: params[:case_name], class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
        </div>
        
        <div class="space-y-2">
          <%= form.label :phone_number, "Phone Number", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :phone_number, value: params[:phone_number], class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
        </div>
        
        <!-- Family Members Count -->
        <div class="space-y-2">
          <%= form.label :min_member, "Minimum Members", class: "block text-sm font-medium text-gray-700" %>
          <%= form.number_field :min_member, value: params[:min_member], class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
        </div>
        
        <div class="space-y-2">
          <%= form.label :max_member, "Maximum Members", class: "block text-sm font-medium text-gray-700" %>
          <%= form.number_field :max_member, value: params[:max_member], class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
        </div>
        
        <!-- Location Information -->
        <div class="space-y-2">
          <%= form.label :district_id, "District", class: "block text-sm font-medium text-gray-700" %>
          <%= form.collection_select :district_id, @districts, :id, :name, { prompt: "Select District" }, { class: "district-select mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50", 'data-context-path': "family_beneficiaries" } %>
        </div>
        
        <div class="space-y-2">
          <%= form.label :county_id, "County", class: "block text-sm font-medium text-gray-700" %>
          <%= form.collection_select :county_id, @counties, :id, :name, { prompt: "Select County" }, { class: "county-select mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50", 'data-context-path': "family_beneficiaries" } %>
        </div>
        
        <div class="space-y-2">
          <%= form.label :sub_county_id, "Sub-County", class: "block text-sm font-medium text-gray-700" %>
          <%= form.collection_select :sub_county_id, @sub_counties, :id, :name, { prompt: "Select Sub-County" }, { class: "sub-county-select mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" } %>
        </div>
        
        <!-- Additional Fields -->
        <div class="space-y-2">
          <%= form.label :branch_id, "Branch", class: "block text-sm font-medium text-gray-700" %>
          <%= form.collection_select :branch_id, @branches, :id, :name, { prompt: "Select Branch" }, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" } %>
        </div>
        
        <!-- Date Range -->
        <div class="space-y-2">
          <%= form.label :start_date, "Start Date", class: "block text-sm font-medium text-gray-700" %>
          <%= form.date_field :start_date, value: params[:start_date], class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
        </div>
        
        <div class="space-y-2">
          <%= form.label :end_date, "End Date", class: "block text-sm font-medium text-gray-700" %>
          <%= form.date_field :end_date, value: params[:end_date], class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
        </div>
        
        <!-- Food Provision Status -->
        <div class="space-y-2">
          <%= form.label :provided_food, "Food Provided", class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :provided_food,
                          [["-- Select --", ""], ["Provided", "provided"], ["Not Provided", "not_provided"]],
                          {}, 
                          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
        </div>
      </div>
      
      <!-- Action Buttons -->
      <div class="flex justify-end space-x-3 pt-4">
        <%= link_to "Reset", family_beneficiaries_path, class: "px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primarycolor" %>
        <%= form.submit "Filter", class: "px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-primarycolor hover:bg-green-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primarycolor" %>
      </div>
    <% end %>
  </div>
    </div>
  </div>
  <%= render "list", beneficiaries: @family_beneficiaries %>
</div>
