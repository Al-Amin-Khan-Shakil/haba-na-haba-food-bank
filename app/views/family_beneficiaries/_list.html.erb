<div class="overflow-x-auto">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fathar Name</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Mother Name</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Case Name</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Phone</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% beneficiaries.each do |beneficiary| %>
        <tr>
          <td class="px-6 py-4 whitespace-nowrap"><%= beneficiary.name %></td>
          <td class="px-6 py-4 whitespace-nowrap"><%= beneficiary.age %></td>
          <td class="px-6 py-4 whitespace-nowrap"><%= beneficiary.gender %></td>
          <td class="px-6 py-4 whitespace-nowrap"><%= beneficiary.phone_number %></td>
          <td class="px-6 py-4 whitespace-nowrap">
            <%= link_to 'View', beneficiary, class: 'text-blue-600 hover:text-blue-800' %>
            <%= link_to 'Edit', edit_family_beneficiary_path(beneficiary), class: "text-indigo-600 hover:text-indigo-900" %>
            <%= button_to 'Delete', family_beneficiary_path(beneficiary), method: :delete, data: { confirm: 'Are you sure?' }, class: "text-red-600 hover:text-red-900" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>