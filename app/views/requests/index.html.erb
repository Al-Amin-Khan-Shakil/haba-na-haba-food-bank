<div class="sm:p-4 md:p-6 lg:p-8 bg-gray-50">
  <div class="bg-gradient-to-tr from-white from-40% via-primarycolor/50 via-90% to-red-600/40 to-100% shadow-xl rounded-xl p-2 sm:p-3 lg:p-8" data-controller="filter-form">
    <div class="flex justify-between items-end mt-2 mb-4">
      <%= link_to new_request_path, class: "flex items-center gap-2 bg-primarycolor text-white px-1.5 py-1 lg:px-1 rounded hover:bg-hoverprimarycolor" do %>
        <i class="fa-regular fa-plus text-2xl lg:text-base"></i>
        <span class="hidden lg:inline-block">Add New</span>
      <% end %>
      <h2 class="text-xl md:text-2xl lg:text-3xl text-primarytext font-bold text-center">Requests</h2>
      <div class="flex justify-end gap-2">
        <button data-filter-form-target="filterButton" data-action="click->filter-form#toggleForm" class="bg-primarycolor text-white py-1 px-2 rounded hover:bg-hoverprimarycolor">
          <i class="fa-solid fa-filter"></i>
          <span class="hidden mr-1 lg:inline-block">Filter</span>
        </button>
        <%= link_to requests_path, data: { filter_form_target: "clearButton", action: "click->filter-form#hideForm" }, class: "cursor-pointer text-gray-500 py-1 px-2 bg-gray-100 border-gray-100 rounded hover:bg-gray-200" do %>
          <i class="fa-solid fa-arrows-rotate"></i> <span class="ml-1 hidden lg:inline-block">Clear</span>
        <% end %>
      </div>
    </div>
    <div data-filter-form-target="form" class="space-y-4 hidden bg-white/50 my-4 rounded-lg p-4 shadow-md text-gray-600">
      <%= form_with url: requests_path, method: :get, local: true, class: "space-y-4",
          data: {
      controller: "location", 
      location_base_path_value: "requests",
      location_context_path_value: requests_path
    } do |form| %>
        <div class="flex flex-wrap gap-4">
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :name, "Name", class: "block text-gray-700" %>
            <%= form.text_field :name, value: params[:name], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-primarycolor focus:border-primarycolor" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :phone_number, "Phone", class: "block text-gray-700" %>
            <%= form.text_field :phone_number, value: params[:phone_number], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-primarycolor focus:border-primarycolor" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :request_type, "Request Type", class: "block text-gray-700" %>
            <%= form.select :request_type, options_for_select(Request.request_types.keys.map { |k| [k.titleize, k] }, params[:request_type]), { prompt: "Select Request Type" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-1 focus:ring-primarycolor focus:border-primarycolor" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :is_selected, "Approved?", class: "block text-gray-700" %>
            <%= form.select :is_selected, options_for_select([["Yes", true], ["No", false]], params[:is_selected]),
              { include_blank: "Select" }, class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-primarycolor focus:border-primarycolor" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :branch_id, "Branch", class: "block text-gray-700" %>
            <%= form.collection_select :branch_id, @branches, :id, :name, { prompt: "Select branch", selected: params[:branch_id] }, { class: 'form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-primarycolor focus:border-primarycolor' } %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :district_id, "District", class: "block text-gray-700" %>
            <%= form.collection_select :district_id, @districts, :id, :name, { prompt: "Select District", selected: params[:district_id] }, { class: 'district-select form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-primarycolor focus:border-primarycolor', 'data-context-path': "individual_beneficiaries",  data: {
                        location_target: "district",
                        action: "change->location#loadCounties"
                      }} %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :county_id, "County", class: "block text-gray-700" %>
            <%= form.collection_select :county_id, @counties, :id, :name, { prompt: "Select County", selected: params[:county_id] }, { class: 'county-select form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-primarycolor focus:border-primarycolor', 'data-context-path': "individual_beneficiaries",data: {
                        location_target: "county",
                        action: "change->location#loadSubCounties",
                        initial_selection: @request&.county_id
                      } } %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :sub_county_id, "Sub-County", class: "block text-gray-700" %>
            <%= form.collection_select :sub_county_id, @sub_counties, :id, :name, { prompt: "Select Sub-County", selected: params[:sub_county_id] }, { class: 'sub-county-select form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-primarycolor focus:border-primarycolor', data: {
                        location_target: "subCounty",
                        initial_selection: @request&.sub_county_id
                      } } %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :start_date, "Start Date", class: "block text-gray-700" %>
            <%= form.date_field :start_date, value: params[:start_date], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-primarycolor focus:border-primarycolor" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :end_date, "End Date", class: "block text-gray-700" %>
            <%= form.date_field :end_date, value: params[:end_date], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-primarycolor focus:border-primarycolor" %>
          </div>
        </div>
        <div class="mt-4">
          <%= form.submit "Filter", data: { filter_form_target: "submitButton", action: "click->filter-form#hideForm" }, class: "inline-block bg-primarycolor text-white py-1 px-4 rounded hover:bg-hoverprimarycolor" %>
        </div>
      <% end %>
    </div>
    <div class="overflow-x-auto rounded-lg">
      <table class="min-w-full max-h-fit bg-white/80 shadow-md rounded-lg border-x border-gray-100 data-table">
        <thead>
          <tr class="text-primarytext bg-sky-50">
            <th class="px-6 py-3 text-left font-Outfit text-base font-bold tracking-wider w-1/4">Name</th>
            <th class="px-6 py-3 text-left font-Outfit text-base font-bold tracking-wider w-1/5">Phone</th>
            <th class="px-6 py-3 text-left font-Outfit text-base font-bold tracking-wider w-1/5">Assigned Branch</th>
            <th class="px-6 py-3 text-left font-Outfit text-base font-bold tracking-wider w-1/5">Request Type</th>
            <th class="px-6 py-3 text-center font-Outfit text-base font-bold tracking-wider w-1/6">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @requests.each do |request| %>
            <tr class=" border-b border-b-gray-100 
            <%= if request.is_selected == nil && request.user_id
                  "bg-yellow-200/20"
                elsif request.is_selected == false
                'bg-red-500/20'
                elsif request.is_selected == true
                  'bg-primarycolor/20'
                else 
                  'bg-white'
              
                end %>">
              <td class="px-6 py-4 text-sm font-semibold font-Outfit text-[#5a607a] w-1/5"><%= request&.name %></td>
              <td class="px-6 py-4 text-sm font-semibold font-Outfit text-[#5a607a] w-1/5"><%= request&.phone_number %></td>
              <td class="px-6 py-4 text-sm font-semibold font-Outfit text-[#5a607a] w-1/5"><%= request&.branch.name %></td>
              <td class="px-6 py-4 text-sm font-semibold font-Outfit text-[#5a607a] w-1/5"><%= request&.request_type.humanize %></td>
              <td class="px-6 py-3 text-center text-sm font-Outfit text-[#5a607a] w-1/6">
                <div class="relative">
                  <button data-dropdown-toggle="dropdown-<%= request.id %>" class="text-gray-600 focus:outline-none focus:ring-2 focus:ring-gray-300 border border-primarycolor rounded" type="button">
                    <div class="p-1 flex flex-row justify-center items-center  space-between">
                      <span class="hidden md:block lg:block mr-1" >Actions</span>
                      <i class="fa-solid fa-chevron-down"></i>
                    </div>
                  </button>
                  <div id="dropdown-<%= request.id %>" class="absolute right-0 mt-2 w-36 bg-white border rounded-lg shadow-lg z-10 hidden overflow-hidden font-Outfit font-semibold text-left">
                    <%= link_to 'Details', request_path(request), class: 'cursor-pointer block px-4 py-2 text-primarycolor hover:bg-gray-100' %>
                    <%= link_to 'Edit', edit_request_path(request), class: 'cursor-pointer block px-4 py-2 text-primarytext hover:bg-gray-100' %>
                    <%= button_to 'Delete', request_path(request), method: :delete, data: { confirm: 'Are you sure?' }, class: 'block px-4 py-2 text-red-600 hover:bg-gray-100 text-left' %>
                    <% if request.request_type == 'food_request' %>
                      <%= link_to '+ Individual', new_request_individual_beneficiary_path(request), class: 'cursor-pointer block px-4 py-2 text-primarytext hover:bg-gray-100' %>
                      <%= link_to '+ Family', new_request_family_beneficiary_path(request), class: 'cursor-pointer block px-4 py-2 text-primarytext hover:bg-gray-100' %>
                      <%= link_to '+ Organization', new_request_organization_beneficiary_path(request), class: 'cursor-pointer block px-4 py-2 text-primarytext hover:bg-gray-100' %>
                    <% end %>
                    <% if request.request_type == 'donation_request' %>
                      <%= link_to '+ Inventory', new_request_inventory_path(request), class: 'cursor-pointer block px-4 py-2 text-primarytext hover:bg-gray-100' %>
                    <% end %>
                  </div>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>