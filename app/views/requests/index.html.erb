<h1 class="mb-4 text-xl font-bold">Requests</h1>
<%= link_to 'New Request', new_request_path, class: "bg-orange-600 hover:bg-blue-700 text-white px-4 py-2 rounded mb-4 inline-block" %>

<%= form_tag requests_path, method: :get, class: "space-y-4" do %>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <!-- Name Filter -->
    <div>
      <%= label_tag "filter[name]", "Name", class: "block text-sm font-medium text-gray-700" %>
      <%= text_field_tag "filter[name]", params.dig(:filter, :name), class: "mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" %>
    </div>

    <!-- Phone Number -->
    <div>
      <%= label_tag "filter[phone_number]", "Phone Number", class: "block text-sm font-medium text-gray-700" %>
      <%= text_field_tag "filter[phone_number]", params.dig(:filter, :phone_number), class: "mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" %>
    </div>

    <!-- Request Type -->
    <div>
    <%= label_tag "filter[request_type]", "Request Type", class: "block text-sm font-medium text-gray-700" %>
    <%= select_tag "filter[request_type]",
          options_for_select(
            Request.request_types.keys.map { |k| [k.humanize.titleize, k] },
            params.dig(:filter, :request_type)
          ),
          include_blank: "Select",
          class: "mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" %>
    </div>

    <!-- District -->
    <div>
      <%= label_tag "filter[district_id]", "District", class: "block text-sm font-medium text-gray-700" %>
      <%= select_tag "filter[district_id]",
            options_from_collection_for_select(@districts, :id, :name, params.dig(:filter, :district_id)),
            prompt: "Select a district",
            class: "district-select mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" %>
    </div>

    <!-- County -->
    <div>
      <%= label_tag "filter[county_id]", "County", class: "block text-sm font-medium text-gray-700" %>
      <%= select_tag "filter[county_id]",
            options_from_collection_for_select(@counties, :id, :name, params.dig(:filter, :county_id)),
            prompt: "Select a county",
            class: "county-select mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" %>
    </div>

    <!-- Sub County -->
    <div>
      <%= label_tag "filter[sub_county_id]", "Sub County", class: "block text-sm font-medium text-gray-700" %>
      <%= select_tag "filter[sub_county_id]",
            options_from_collection_for_select(@sub_counties, :id, :name, params.dig(:filter, :sub_county_id)),
            prompt: "Select a sub-county",
            class: "sub-county-select mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" %>
    </div>

    <!-- Approved -->
    <div>
      <%= label_tag "filter[is_selected]", "Approved?", class: "block text-sm font-medium text-gray-700" %>
      <%= select_tag "filter[is_selected]",
            options_for_select([["Yes", true], ["No", false]], params.dig(:filter, :is_selected)),
            include_blank: "Select",
            class: "mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" %>
    </div>

    <!-- Branch -->
    <div>
      <%= label_tag "filter[branch_id]", "Branch", class: "block text-sm font-medium text-gray-700" %>
      <%= select_tag "filter[branch_id]",
            options_from_collection_for_select(Branch.all, :id, :name, params.dig(:filter, :branch_id)),
            prompt: "Select a branch",
            class: "mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" %>
    </div>

    <!-- Start and End Dates -->
    <div>
      <%= label_tag "filter[start_date]", "Start Date", class: "block text-sm font-medium text-gray-700" %>
      <%= date_field_tag "filter[start_date]", params.dig(:filter, :start_date), class: "mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" %>
    </div>
    <div>
      <%= label_tag "filter[end_date]", "End Date", class: "block text-sm font-medium text-gray-700" %>
      <%= date_field_tag "filter[end_date]", params.dig(:filter, :end_date), class: "mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" %>
    </div>
  </div>

  <!-- Buttons -->
  <div class="flex space-x-4 mt-4">
    <%= submit_tag "Filter", class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-lime-500" %>
    <%= link_to "Clear", requests_path, class: "px-4 py-2 bg-gray-300 text-black rounded-md hover:bg-gray-400" %>
    <%= " #{@requests.size} results" %>
  </div>
<% end %>

<table class="mt-2 min-w-full border">
  <thead>
    <tr>
      <th class="px-4 py-2 border">Name</th>
      <th class="px-4 py-2 border">Phone Number</th>
      <th class="px-4 py-2 border">Type</th>
      <th class="px-4 py-2 border">Created Date</th>
      <th class="px-4 py-2 border">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @requests.each do |request| %>
      <tr>
        <td class="px-4 py-2 border"><%= request.name %></td>
        <td class="px-4 py-2 border"><%= request.phone_number %></td>
        <td class="px-4 py-2 border"><%= request.request_type.humanize %></td>
        <!-- add time to test -->
        <td class="px-4 py-2 border"><%= request.created_at %></td>
        <td class="px-4 py-2 border">
          <%= link_to 'Show', request_path(request), class: "text-blue-600 hover:underline mr-2" %>
          <%= link_to 'Edit', edit_request_path(request), class: "text-yellow-600 hover:underline mr-2" %>
          <%= button_to 'Delete', request_path(request), method: :delete, data: { confirm: "Are you sure?" }, class: "text-red-600 hover:underline" %>
          <%= link_to 'Family Beneficiary', new_request_family_beneficiary_path(request), class: 'block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100' %>
          <%= link_to 'Organization Beneficiary', new_request_organization_beneficiary_path(request), class: 'block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100' %>
          <%= link_to 'Individual Beneficiary', new_request_individual_beneficiary_path(request), class: 'block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>