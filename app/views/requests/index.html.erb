<h1 class="mb-4 text-xl font-bold">Requests</h1>
<%= link_to 'New Request', new_request_path, class: "bg-orange-600 hover:bg-blue-700 text-white px-4 py-2 rounded mb-4 inline-block" %>

<%= form_with url: requests_path, method: :get, local: true, class: "space-y-4" do |form| %>
  <div class="flex flex-wrap gap-4">
    <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
      <%= form.label :name, "Name", class: "block text-gray-700" %>
      <%= form.text_field :name, value: params[:name], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
    </div>

    <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
      <%= form.label :phone_number, "Phone Number", class: "block text-gray-700" %>
      <%= form.text_field :phone_number, value: params[:phone_number], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
    </div>

    <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
      <%= form.label :request_type, "Request Type", class: "block text-gray-700" %>
      <%= form.select :request_type,
          options_for_select(Request.request_types.keys.map { |k| [k.humanize.titleize, k] }, params[:request_type]),
          { include_blank: "Select" },
          class: "form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
    </div>

    <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
      <%= form.label :district_id, "District", class: "block text-gray-700" %>
      <%= form.select :district_id,
          options_from_collection_for_select(@districts, :id, :name, params[:district_id]),
          { prompt: "Select a district" },
          class: "district-select form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
    </div>

    <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
      <%= form.label :county_id, "County", class: "block text-gray-700" %>
      <%= form.select :county_id,
          options_from_collection_for_select(@counties, :id, :name, params[:county_id]),
          { prompt: "Select a county" },
          class: "county-select form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
    </div>

    <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
      <%= form.label :sub_county_id, "Sub County", class: "block text-gray-700" %>
      <%= form.select :sub_county_id,
          options_from_collection_for_select(@sub_counties, :id, :name, params[:sub_county_id]),
          { prompt: "Select a sub-county" },
          class: "sub-county-select form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
    </div>

    <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
      <%= form.label :is_selected, "Approved?", class: "block text-gray-700" %>
      <%= form.select :is_selected,
          options_for_select([["Yes", true], ["No", false]], params[:is_selected]),
          { include_blank: "Select" },
          class: "form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
    </div>

    <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
      <%= form.label :branch_id, "Branch", class: "block text-gray-700" %>
      <%= form.select :branch_id,
          options_from_collection_for_select(Branch.all, :id, :name, params[:branch_id]),
          { prompt: "Select a branch" },
          class: "form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
    </div>

    <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
      <%= form.label :start_date, "Start Date", class: "block text-gray-700" %>
      <%= form.date_field :start_date, value: params[:start_date], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
    </div>

    <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
      <%= form.label :end_date, "End Date", class: "block text-gray-700" %>
      <%= form.date_field :end_date, value: params[:end_date], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
    </div>
  </div>

  <div class="mt-4">
    <%= form.submit "Filter", class: "inline-block bg-blue-600 text-white py-1 px-4 rounded hover:bg-lime-500" %>
    <%= link_to "Clear", requests_path, class: "inline-block bg-gray-300 text-black py-1 px-4 rounded hover:bg-gray-400" %>
    <span class="ml-4 text-sm text-gray-600"><%= "#{@requests.size} results" %></span>
  </div>
<% end %>


<table class="mt-2 min-w-full border">
  <thead>
    <tr>
      <th class="px-4 py-2 border">Name</th>
      <th class="px-4 py-2 border">Phone Number</th>
      <th class="px-4 py-2 border">Type</th>
      <th class="px-4 py-2 border">Created Date</th>
      <th class="px-4 py-2 border">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @requests.each do |request| %>
      <tr>
        <td class="px-4 py-2 border"><%= request.name %></td>
        <td class="px-4 py-2 border"><%= request.phone_number %></td>
        <td class="px-4 py-2 border"><%= request.request_type.humanize %></td>
        <!-- add time to test -->
        <td class="px-4 py-2 border"><%= request.created_at %></td>
        <td class="px-4 py-2 border">
          <%= link_to 'Show', request_path(request), class: "text-blue-600 hover:underline mr-2" %>
          <%= link_to 'Edit', edit_request_path(request), class: "text-yellow-600 hover:underline mr-2" %>
          <%= button_to 'Delete', request_path(request), method: :delete, data: { confirm: "Are you sure?" }, class: "text-red-600 hover:underline" %>
          <%= link_to 'Family Beneficiary', new_request_family_beneficiary_path(request), class: 'block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100' %>
          <%= link_to 'Organization Beneficiary', new_request_organization_beneficiary_path(request), class: 'block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100' %>
          <%= link_to 'Individual Beneficiary', new_request_individual_beneficiary_path(request), class: 'block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>