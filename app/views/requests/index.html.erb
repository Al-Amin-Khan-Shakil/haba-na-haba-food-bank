<h1 class="text-xl font-bold mb-4">Requests</h1>
<%= link_to 'New Request', new_request_path, class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded mb-4 inline-block" %>
<table class="min-w-full border mt-2">
  <thead>
    <tr>
      <th class="border px-4 py-2">Name</th>
      <th class="border px-4 py-2">Phone Number</th>
      <th class="border px-4 py-2">Type</th>
      <th class="border px-4 py-2">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @requests.each do |request| %>
      <tr>
        <td class="border px-4 py-2"><%= request.name %></td>
        <td class="border px-4 py-2"><%= request.phone_number %></td>
        <td class="border px-4 py-2"><%= request.request_type.humanize %></td>
        <td class="border px-4 py-2">
          <%= link_to 'Show', request_path(request), class: "text-blue-600 hover:underline mr-2" %>
          <%= link_to 'Edit', edit_request_path(request), class: "text-yellow-600 hover:underline mr-2" %>
          <%= button_to 'Delete', request_path(request), method: :delete, data: { confirm: "Are you sure?" }, class: "text-red-600 hover:underline" %>
          <%= link_to 'Individual Beneficiary', new_request_individual_beneficiary_path(request), class: 'block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
