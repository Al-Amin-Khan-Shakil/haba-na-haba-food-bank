<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold mb-6">Requests</h1>
  <%= link_to 'New Request', new_request_path, class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 mb-6 inline-block" %>
  <div class="filter-form bg-white p-6 rounded-lg shadow-md my-5">
    <%= form_with url: requests_path, method: :get, local: true, class: "space-y-6", data: { controller: "filter", action: "submit->filter#handleFilterSubmit" } do |form| %>
      <h3 class="text-lg font-semibold text-gray-800 mb-4">Filter Requests</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Basic Information -->
        <div class="space-y-2">
          <%= form.label :name, "Name", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :name, value: params[:name], class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
        </div>
        <div class="space-y-2">
          <%= form.label :phone_number, "Phone Number", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :phone_number, value: params[:phone_number], class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
        </div>
        <div class="space-y-2">
          <%= form.label :request_type, "Request Type", class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :request_type,
              options_for_select(Request.request_types.keys.map { |k| [k.humanize.titleize, k] }, params[:request_type]),
              { include_blank: "Select" },
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
        </div>
        <!-- Location Information -->
        <div class="space-y-2">
          <%= form.label :district_id, "District", class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :district_id,
              options_from_collection_for_select(@districts, :id, :name, params[:district_id]),
              { prompt: "Select District" },
              class: "district-select mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
        </div>
        <div class="space-y-2">
          <%= form.label :county_id, "County", class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :county_id,
              options_from_collection_for_select(@counties, :id, :name, params[:county_id]),
              { prompt: "Select County" },
              class: "county-select mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
        </div>
        <div class="space-y-2">
          <%= form.label :sub_county_id, "Sub County", class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :sub_county_id,
              options_from_collection_for_select(@sub_counties, :id, :name, params[:sub_county_id]),
              { prompt: "Select Sub-County" },
              class: "sub-county-select mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
        </div>
        <!-- Status and Branch -->
        <div class="space-y-2">
          <%= form.label :is_selected, "Approved?", class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :is_selected,
              options_for_select([["Yes", true], ["No", false]], params[:is_selected]),
              { include_blank: "Select" },
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
        </div>
        <div class="space-y-2">
          <%= form.label :branch_id, "Branch", class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :branch_id,
              options_from_collection_for_select(Branch.all, :id, :name, params[:branch_id]),
              { prompt: "Select Branch" },
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
        </div>
        <!-- Date Range -->
        <div class="space-y-2">
          <%= form.label :start_date, "Start Date", class: "block text-sm font-medium text-gray-700" %>
          <%= form.date_field :start_date, value: params[:start_date], class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
        </div>
        <div class="space-y-2">
          <%= form.label :end_date, "End Date", class: "block text-sm font-medium text-gray-700" %>
          <%= form.date_field :end_date, value: params[:end_date], class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
        </div>
      </div>
      <!-- Action Buttons -->
      <div class="flex justify-end space-x-3 pt-4">
        <%= link_to "Reset", requests_path, class: "px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primarycolor" %>
        <%= form.submit "Filter", class: "px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-primarycolor hover:bg-green-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primarycolor" %>
        <span class="self-center text-sm text-gray-600"><%= "#{@requests.size} results" %></span>
      </div>
    <% end %>
    <h1 class="mb-4 text-xl font-bold">Requests</h1>
    <%= link_to 'New Request', new_request_path, class: "bg-orange-600 hover:bg-blue-700 text-white px-4 py-2 rounded mb-4 inline-block" %>
    <table class="mt-2 min-w-full border">
      <thead>
        <tr>
          <th class="px-4 py-2 border">Name</th>
          <th class="px-4 py-2 border">Phone Number</th>
          <th class="px-4 py-2 border">Type</th>
          <th class="px-4 py-2 border">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @requests.each do |request| %>
          <tr>
            <td class="px-4 py-2 border"><%= request.name %></td>
            <td class="px-4 py-2 border"><%= request.phone_number %></td>
            <td class="px-4 py-2 border"><%= request.request_type.humanize %></td>
            <td class="px-4 py-2 border">
              <%= link_to 'Show', request_path(request), class: "text-blue-600 hover:underline mr-2" %>
              <%= link_to 'Edit', edit_request_path(request), class: "text-yellow-600 hover:underline mr-2" %>
              <%= button_to 'Delete', request_path(request), method: :delete, data: { confirm: "Are you sure?" }, class: "text-red-600 hover:underline" %>
              <%= link_to 'Family Beneficiary', new_request_family_beneficiary_path(request), class: 'block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100' %>
              <%= link_to 'Organization Beneficiary', new_request_organization_beneficiary_path(request), class: 'block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100' %>
              <%= link_to 'Individual Beneficiary', new_request_individual_beneficiary_path(request), class: 'block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100' %>
              <%= link_to 'Inventory', new_request_inventory_path(request), class: 'block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100' %>
            </td>
          </tr>
        <% end %>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full bg-white rounded-lg overflow-hidden">
          <thead class="bg-gray-100">
            <tr>
              <th class="py-3 px-4 text-left">Name</th>
              <th class="py-3 px-4 text-left">Phone Number</th>
              <th class="py-3 px-4 text-left">Type</th>
              <th class="py-3 px-4 text-left">Created Date</th>
              <th class="py-3 px-4 text-left">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @requests.each do |request| %>
              <tr class="border-t border-gray-200 hover:bg-gray-50">
                <td class="py-3 px-4"><%= request.name %></td>
                <td class="py-3 px-4"><%= request.phone_number %></td>
                <td class="py-3 px-4"><%= request.request_type.humanize %></td>
                <td class="py-3 px-4"><%= request.created_at.to_formatted_s %></td>
                <td class="py-3 px-4 flex flex-wrap gap-2">
                  <%= link_to 'Show', request_path(request), class: "text-blue-600 hover:text-blue-800" %>
                  <%= link_to 'Edit', edit_request_path(request), class: "text-yellow-600 hover:text-yellow-800" %>
                  <%= button_to 'Delete', request_path(request), method: :delete, data: { confirm: "Are you sure?" }, class: "text-red-600 hover:text-red-800" %>
                  <div class="w-full mt-1">
                    <%= link_to 'Family Beneficiary', new_request_family_beneficiary_path(request), class: "text-sm text-gray-600 hover:text-gray-800" %>
                  </div>
                  <div class="w-full">
                    <%= link_to 'Organization Beneficiary', new_request_organization_beneficiary_path(request), class: "text-sm text-gray-600 hover:text-gray-800" %>
                  </div>
                  <div class="w-full">
                    <%= link_to 'Individual Beneficiary', new_request_individual_beneficiary_path(request), class: "text-sm text-gray-600 hover:text-gray-800" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
