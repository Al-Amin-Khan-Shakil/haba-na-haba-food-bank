<h1 class="text-xl font-bold mb-4">Request Details</h1>
<p><strong>Name:</strong> <%= @request.name %></p>
<p><strong>Phone Number:</strong> <%= @request.phone_number %></p>
<p><strong>Request Type:</strong> <%= @request.request_type.humanize %></p>
<% if @request.donation_request? && @request.donation %>
  <h2 class="text-lg font-semibold mt-4">Donation Details</h2>
  <p><strong>Donation Type:</strong> <%= @request.donation.donation_type.humanize %></p>
  <p><strong>Donation Name:</strong> <%= @request.donation.donation_name %></p>
  <p><strong>Amount:</strong> <%= @request.donation.amount %></p>
<% end %>
<div class="mt-4">
  <%= link_to 'Edit', edit_request_path(@request), class: "bg-yellow-500 text-white px-4 py-2 rounded mr-2" %>
  <%= link_to 'Back', requests_path, class: "bg-gray-300 px-4 py-2 rounded" %>
</div>
