<div class="sm:p-4 md:p-6 lg:p-8 bg-gray-50">
  <div class="min-w-full bg-gradient-to-tr from-white from-40% via-primarycolor/50 via-90% to-red-600/40 to-100% text-white shadow-xl rounded-xl p-3 sm:p-8 mb-8">
    <div class="flex justify-between items-center mb-4">
      <%= link_to requests_path, class: "cursor-pointer flex items-center text-sm sm:text-base text-gray-500 py-1 px-4 rounded bg-gray-200 hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400 transition duration-300 ease-in-out" do %>
        <i class="fa-solid fa-arrow-left"></i>
        <span class="ml-2 hidden lg:inline-block">Back</span>
      <% end %>
      <h2 class="text-lg lg:text-3xl text-primarytext font-bold text-center leading-tight">Details</h2>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 md:gap-6 lg:gap-8">
      <div class="bg-white p-3 sm:p-6 rounded-lg shadow-lg hover:shadow-2xl transition-all duration-300 ease-in-out">
        <h3 class="text-lg sm:text-xl font-semibold text-primarytext mb-4 underline">Request Information</h3>
        <div class="space-y-4">
          <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
            <div class="flex items-start gap-1 sm:gap-3 w-fit">
              <div class="w-[23px]"><i class="fa-solid fa-user text-sm text-primarycolor sm:text-lg"></i></div>
              <p class="font-medium text-sm sm:text-base text-gray-700">Name</p>
            </div>
            <div class="flex-1 flex justify-end items-start">
              <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= @request&.name %></p>
            </div>
          </div>
          <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
            <div class="flex items-start gap-1 sm:gap-3 w-fit">
              <div class="w-[23px]"><i class="fa-solid fa-award text-sm text-primarycolor sm:text-lg"></i></div>
              <p class="font-medium text-sm sm:text-base text-gray-700">Type</p>
            </div>
            <div class="flex-1 flex justify-end items-start">
              <p class="text-sm sm:text-base font-medium text-[#5a607a]"><%= @request&.request_type.humanize %></p>
            </div>
          </div>
          <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
            <div class="flex items-start gap-1 sm:gap-3 w-fit">
              <div class="w-[23px]"><i class="fa-solid fa-phone text-sm text-primarycolor sm:text-lg"></i></div>
              <p class="font-medium text-sm sm:text-base text-gray-700">Phone</p>
            </div>
            <div class="flex-1 flex justify-end items-start">
              <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= @request&.phone_number %></p>
            </div>
          </div>
          <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
            <div class="flex items-start gap-1 sm:gap-3 w-fit">
              <div class="w-[23px]"><i class="fa-solid fa-file-circle-check text-sm text-primarycolor sm:text-lg"></i></div>
              <p class="font-medium text-sm sm:text-base text-gray-700">Approved?</p>
            </div>
            <div class="flex-1 flex justify-end items-start">
              <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize <%= @request&.is_selected ? 'text-green-500' : 'text-red-500' %>"><%= @request&.is_selected ? 'Yes' : 'No' %></p>
            </div>
          </div>
          <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
            <div class="flex items-start gap-1 sm:gap-3 w-fit">
              <div class="w-[23px]"><i class="fa-solid fa-building text-sm text-primarycolor sm:text-lg"></i></div>
              <p class="font-medium text-sm sm:text-base text-gray-700">Assigned Branch</p>
            </div>
            <div class="flex-1 flex justify-end items-start">
              <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= @request&.branch.name %></p>
            </div>
          </div>
          <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
            <div class="flex items-start gap-1 sm:gap-3 w-fit">
              <div class="w-[23px]"><i class="fa-solid fa-user text-sm text-primarycolor sm:text-lg"></i></div>
              <p class="font-medium text-sm sm:text-base text-gray-700">Assigned Voluenter</p>
            </div>
            <div class="flex-1 flex justify-end items-start">
              <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= @request&.user&.first_name %></p>
            </div>
          </div>
        </div>
      </div>
      <div class="bg-white p-3 sm:p-6 rounded-lg shadow-lg hover:shadow-2xl transition-all duration-300 ease-in-out">
        <h3 class="text-lg sm:text-xl font-semibold text-primarytext mb-4 underline">Request Location</h3>
        <div class="space-y-4">
          <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
            <div class="flex items-start gap-1 sm:gap-3 w-fit">
              <div class="w-[23px]"><i class="fa-solid fa-map text-sm text-primarycolor sm:text-lg"></i></div>
              <p class="font-medium text-sm sm:text-base text-gray-700">District</p>
            </div>
            <div class="flex-1 flex justify-end items-start">
              <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= @request&.district.name %></p>
            </div>
          </div>
          <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
            <div class="flex items-start gap-1 sm:gap-3 w-fit">
              <div class="w-[23px]"><i class="fa-solid fa-map-pin text-sm text-primarycolor sm:text-lg"></i></div>
              <p class="font-medium text-sm sm:text-base text-gray-700">County</p>
            </div>
            <div class="flex-1 flex justify-end items-start">
              <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= @request&.county.name %></p>
            </div>
          </div>
          <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
            <div class="flex items-start gap-1 sm:gap-3 w-fit">
              <div class="w-[23px]"><i class="fa-solid fa-location text-sm text-primarycolor sm:text-lg"></i></div>
              <p class="font-medium text-sm sm:text-base text-gray-700">Sub-County</p>
            </div>
            <div class="flex-1 flex justify-end items-start">
              <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= @request&.sub_county.name %></p>
            </div>
          </div>
          <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
            <div class="flex items-start gap-1 sm:gap-3 w-fit">
              <div class="w-[23px]"><i class="fa-solid fa-home text-sm text-primarycolor sm:text-lg"></i></div>
              <p class="font-medium text-sm sm:text-base text-gray-700">Village</p>
            </div>
            <div class="flex-1 flex justify-end items-start">
              <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= @request&.village %></p>
            </div>
          </div>
          <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
            <div class="flex items-start gap-1 sm:gap-3 w-fit">
              <div class="w-[23px]"><i class="fa-solid fa-church text-sm text-primarycolor sm:text-lg"></i></div>
              <p class="font-medium text-sm sm:text-base text-gray-700">Parish</p>
            </div>
            <div class="flex-1 flex justify-end items-start">
              <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= @request&.parish %></p>
            </div>
          </div>
          <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
            <div class="flex items-start gap-1 sm:gap-3 w-fit">
              <div class="w-[23px]"><i class="fa-solid fa-street-view text-sm text-primarycolor sm:text-lg"></i></div>
              <p class="font-medium text-sm sm:text-base text-gray-700">Note</p>
            </div>
            <div class="flex-1 flex justify-end items-start">
              <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= @request&.address_note %></p>
            </div>
          </div>
        </div>
      </div>
      <% if @request&.donation %>
        <div class="bg-white p-3 sm:p-6 rounded-lg shadow-lg hover:shadow-2xl transition-all duration-300 ease-in-out col-span-1 lg:col-span-2">
          <h3 class="text-lg sm:text-xl font-semibold text-primarytext mb-4 underline">Donation Information</h3>
          <div class="space-y-4">
            <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
              <div class="flex items-start gap-1 sm:gap-3 w-fit">
                <div class="w-[23px]"><i class="fa-solid fa-user text-sm text-primarycolor sm:text-lg"></i></div>
                <p class="font-medium text-sm sm:text-base text-gray-700">Donor Name</p>
              </div>
              <div class="flex-1 flex justify-end items-start">
                <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= @request&.donation.donor_name %></p>
              </div>
            </div>
            <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
              <div class="flex items-start gap-1 sm:gap-3 w-fit">
                <div class="w-[23px]"><i class="fa-solid fa-handshake text-sm text-primarycolor sm:text-lg"></i></div>
                <p class="font-medium text-sm sm:text-base text-gray-700">Donor Type</p>
              </div>
              <div class="flex-1 flex justify-end items-start">
                <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= @request&.donation&.donor_type.humanize %></p>
              </div>
            </div>
            <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
              <div class="flex items-start gap-1 sm:gap-3 w-fit">
                <div class="w-[23px]"><i class="fa-solid fa-hand-holding-heart text-sm text-primarycolor sm:text-lg"></i></div>
                <p class="font-medium text-sm sm:text-base text-gray-700">Donation Type</p>
              </div>
              <div class="flex-1 flex justify-end items-start">
                <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= @request&.donation.donation_type.humanize %></p>
              </div>
            </div>
            <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
              <div class="flex items-start gap-1 sm:gap-3 w-fit">
                <div class="w-[23px]"><i class="fa-solid fa-hand-holding-heart text-sm text-primarycolor sm:text-lg"></i></div>
                <p class="font-medium text-sm sm:text-base text-gray-700">Donation Name</p>
              </div>
              <div class="flex-1 flex justify-end items-start">
                <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= @request&.donation.donation_name %></p>
              </div>
            </div>
            <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
              <div class="flex items-start gap-1 sm:gap-3 w-fit">
                <div class="w-[23px]"><i class="fa-solid fa-scale-unbalanced-flip text-sm text-primarycolor sm:text-lg"></i></div>
                <p class="font-medium text-sm sm:text-base text-gray-700">Donation Amount</p>
              </div>
              <div class="flex-1 flex justify-end items-start">
                <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= @request&.donation.amount %></p>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="mt-8 flex justify-end items-center gap-4">
      <%= link_to 'Edit', edit_request_path(@request), class: 'cursor-pointer bg-primarycolor text-white py-1 px-4 w-fit rounded hover:bg-hoverprimarycolor transition-all text-sm sm:text-base' %>
      <%= button_to 'Destroy', request_path(@request), method: :delete, data: { confirm: 'Are you sure?' }, class: 'cursor-pointer bg-red-600 text-white py-1 px-4 w-fit rounded hover:bg-red-700 transition-all text-sm sm:text-base' %>
    </div>
  </div>
</div>