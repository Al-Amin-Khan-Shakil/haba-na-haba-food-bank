<%= form_with model: @request, local: true,
    data: {
      controller: "request-form",
      request_form_donation_values: (@request.donation_request? && @request.donation) ? @request.donation.to_json : 'null'
    } do |f| %>
  <% if @request.errors.any? %>
    <div class="text-red-600 mb-4"><%= @request.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="mb-4">
    <%= f.label :name, class: "block font-semibold mb-1" %>
    <%= f.text_field :name, class: "w-full p-2 border rounded" %>
  </div>
  <div class="mb-4">
    <%= f.label :phone_number, class: "block font-semibold mb-1" %>
    <%= f.text_field :phone_number, class: "w-full p-2 border rounded" %>
  </div>
  <div class="mb-4">
    <%= f.label :request_type, class: "block font-semibold mb-1" %>
    <%= f.select :request_type,
          Request.request_types.keys.map { |k| [k.titleize, k] },
          {},
          class: "w-full p-2 border rounded",
          data: {
            request_form_target: "requestTypeSelect",
            action: "change->request-form#toggleDonationFields"
          } %>
  </div>
  <div class="mb-4">
    <%= f.label :is_selected, class: "block font-semibold mb-1" %>
    <%= f.check_box :is_selected, class: "mr-2" %>
  </div>
  <div class="mb-4">
    <%= f.label :village, class: "block font-semibold mb-1" %>
    <%= f.text_field :village, class: "w-full p-2 border rounded" %>
  </div>
  <div class="mb-4">
    <%= f.label :parish, class: "block font-semibold mb-1" %>
    <%= f.text_field :parish, class: "w-full p-2 border rounded" %>
  </div>
  <div class="mb-4">
    <%= f.label :address_note, class: "block font-semibold mb-1" %>
    <%= f.text_area :address_note, class: "w-full p-2 border rounded" %>
  </div>
  <div class="mb-4">
    <%= f.label :district_id, "District", class: "block font-semibold mb-1" %>
    <%= f.collection_select :district_id, District.all, :id, :name,
        { prompt: "Select a District" },
        { class: "w-full p-2 border rounded", data: { action: "change->location#loadCounties" } } %>
  </div>
  <div class="mb-4">
    <%= f.label :county_id, "County", class: "block font-semibold mb-1" %>
    <%= f.collection_select :county_id, County.where(district_id: @request.district_id), :id, :name,
        { prompt: "Select a County" },
        { class: "w-full p-2 border rounded", data: { action: "change->location#loadSubCounties" } } %>
  </div>
  <div class="mb-4">
    <%= f.label :sub_county_id, "Sub-County", class: "block font-semibold mb-1" %>
    <%= f.collection_select :sub_county_id, SubCounty.where(county_id: @request.county_id), :id, :name,
        { prompt: "Select a Sub-County" },
        { class: "w-full p-2 border rounded" } %>
  </div>
  <div class="mb-4">
    <%= f.label :branch_id, "Branch", class: "block font-semibold mb-1" %>
    <%= f.collection_select :branch_id, Branch.all, :id, :name,
        { prompt: "Select a Branch" },
        { class: "w-full p-2 border rounded" } %>
  </div>
  <div class="mb-4">
    <%= f.label :user_id, "Handled By (User)", class: "block font-semibold mb-1" %>
    <%= f.collection_select :user_id, User.all, :id, :email,
        { prompt: "Select a User" },
        { class: "w-full p-2 border rounded" } %>
  </div>
  <!-- Donation Fields Wrapper -->
  <div id="donation-fields-wrapper" data-request-form-target="donationFieldsWrapper">
    <% if @request.donation_request? %>
      <h3 class="font-bold mt-4">Donation Info</h3>
      <%= f.fields_for :donation, @request.donation || @request.build_donation do |df| %>
        <%= df.hidden_field :id if df.object.persisted? %>
        <div class="mb-4">
          <%= df.label :donation_type %>
          <%= df.select :donation_type,
                Donation.donation_types.keys.map { |k| [k.titleize, k] },
                { include_blank: "Select type" },
                class: "input" %>
        </div>
        <div class="mb-4">
          <%= df.label :donation_name %>
          <%= df.text_field :donation_name, class: "input" %>
        </div>
        <div class="mb-4">
          <%= df.label :amount %>
          <%= df.number_field :amount, class: "input", step: "0.01" %>
        </div>
      <% end %>
    <% end %>
  </div>
  <div class="mt-6">
    <%= f.submit class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 cursor-pointer" %>
  </div>
<% end %>