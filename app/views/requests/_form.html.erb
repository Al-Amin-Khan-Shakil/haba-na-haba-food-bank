<%= form_with model: @request, local: true, data: { controller: "request-form" } do |f| %>
  <% if @request.errors.any? %>
    <div><%= @request.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="mb-4">
    <%= f.label :name %>
    <%= f.text_field :name, class: "input" %>
  </div>
  <div class="mb-4">
    <%= f.label :phone_number %>
    <%= f.text_field :phone_number, class: "input" %>
  </div>
  <div class="mb-4">
    <%= f.label :request_type %>
    <%= f.select :request_type,
          Request.request_types.keys.map { |k| [k.titleize, k] },
          {},
          class: "input",
          data: {
            request_form_target: "requestTypeSelect",
            action: "change->request-form#toggleDonationFields"
          } %>
  </div>
  <div class="mb-4">
    <%= f.label :is_selected, class: "block font-semibold" %>
    <%= f.check_box :is_selected, class: "mr-2" %>
  </div>
  <div class="mb-4">
    <%= f.label :village, class: "block font-semibold" %>
    <%= f.text_field :village, class: "w-full p-2 border rounded" %>
  </div>
  <div class="mb-4">
    <%= f.label :parish, class: "block font-semibold" %>
    <%= f.text_field :parish, class: "w-full p-2 border rounded" %>
  </div>
  <div class="mb-4">
    <%= f.label :address_note, class: "block font-semibold" %>
    <%= f.text_area :address_note, class: "w-full p-2 border rounded" %>
  </div>
  <div class="mb-4">
    <%= f.label :district_id, "District", class: "block font-semibold" %>
    <%= f.collection_select :district_id, District.all, :id, :name,
        { prompt: "Select a District" },
        { class: "w-full p-2 border rounded", data: { action: "change->location#loadCounties" } } %>
  </div>
  <div class="mb-4">
    <%= f.label :county_id, "County", class: "block font-semibold" %>
    <%= f.collection_select :county_id, County.where(district_id: request.district_id), :id, :name,
        { prompt: "Select a County" },
        { class: "w-full p-2 border rounded", data: { action: "change->location#loadSubCounties" } } %>
  </div>
  <div class="mb-4">
    <%= f.label :sub_county_id, "Sub-County", class: "block font-semibold" %>
    <%= f.collection_select :sub_county_id, SubCounty.where(county_id: request.county_id), :id, :name,
        { prompt: "Select a Sub-County" },
        { class: "w-full p-2 border rounded" } %>
  </div>
  <div class="mb-4">
    <%= f.label :branch_id, "Branch", class: "block font-semibold" %>
    <%= f.collection_select :branch_id, Branch.all, :id, :name,
        { prompt: "Select a Branch" },
        { class: "w-full p-2 border rounded" } %>
  </div>
  <div class="mb-4">
    <%= f.label :user_id, "Handled By (User)", class: "block font-semibold" %>
    <%= f.collection_select :user_id, User.all, :id, :email,
        { prompt: "Select a User" },
        { class: "w-full p-2 border rounded" } %>
  </div>
  <!-- Empty placeholder where JS will inject donation fields -->
  <div id="donation-fields-wrapper" data-request-form-target="donationFieldsWrapper"></div>
  <div class="mt-4">
    <%= f.submit class: "btn btn-primary" %>
  </div>
<% end %>
