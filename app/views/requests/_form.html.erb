<%= form_with model: @request, local: true,
    data: {
      controller: "request-form location",
      request_form_donation_values: (@request.donation_request? && @request.donation) ? @request.donation.to_json : 'null',
      location_base_path_value: "requests",
      location_context_path_value: requests_path
} do |f| %>
  <section class="custom-select md:p-10 sm:px-6 lg:px-8 py-8 sm:text-sm md:text-base lg:text-lg">
    <div class="bg-gradient-to-tr from-white from-40% via-primarycolor/50 via-90% to-red-600/40 to-100% transition duration-300 hover:shadow-xl md:p-12 p-4 rounded-lg shadow-lg">
      <div class=" flex justify-between items-center h-auto gap-4 my-4">
        <button onclick="history.go(-1)" class="border rounded-lg flex items-center text-sm sm:text-base bg-gray-50 px-5 py-2  transition duration-300 ease-in-out">
          <i class="fa-solid fa-arrow-left"></i>
          <span class="ml-2 hidden lg:inline-block ">Back</span>
        </button>
        <% if current_user %>
          <h2  class="text-lg lg:text-3xl text-primarytext font-bold text-center leading-tight">
            <span>
              <%= @request&.persisted? ? "Edit" : "Create" %>
            </span>
            <span class= "hidden md:inline-block">
              Request
            </span>
          </h2>
        <% else %>
          <div data-controller="formswitch"
     data-formswitch-type-value="<%= @type %>">
            <h2 class="text-lg lg:text-3xl text-primarytext font-bold text-center leading-tight" data-formswitch-target="title">
              <%= @type == "donate" ? "Donate Food" : "Request Food" %>
            </h2>
          </div>
        <% end %>
      </div>
      <div class="bg-white/50 md:p-8 p-4 border rounded-lg">
        <div class="flex justify-between items-center">
          <h3 class="text-xl my-4 font-semibold text-primarytextcolor mb-3 hover:text-gray-900 transition duration-200 underline">Requester Information</h3>
          <% if current_user %>
            <div data-controller="triple-toggle">
              <label class="items-center cursor-pointer flex flex-col">
                <span class= "md:text-xl text-base my-4 font-semibold text-primarytextcolor mb-3"> Is Approved ?</span>
                <input type="checkbox"
           value="unset"
           data-triple-toggle-target="checkbox"
           data-action="click->triple-toggle#toggle"
                class="sr-only peer mt-5"
                id="triple-toggle-checkbox" />
                <div class="relative w-11 h-6 bg-gray-200
                peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300
                rounded-full peer-checked:after:translate-x-full
                peer-checked:after:border-white
                after:content-[''] after:absolute after:top-[2px] after:start-[2px]
                after:bg-white after:border-gray-200 after:border after:rounded-full
                after:h-5 after:w-5 after:transition-all
                peer-checked:bg-primarycolor">
                </div>
              </label>
            </div>
          <% end %>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="mb-4">
            <%= f.label :name, class: "block text-gray-700 font-bold mb-2" %>
            <%= f.text_field :name, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
          </div>
          <div class="mb-4">
            <%= f.label :phone_number, class: "block text-gray-700 font-bold mb-2" %>
            <%= f.text_field :phone_number, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% default_value =
                if @type == "donate"
                  "donation_request"
                elsif @type == "request"
                  "food_request"
                else
                  nil
                end
            %>
          <div class="mb-4">
            <%= f.label :request_type, class: "block text-gray-700 font-bold mb-2" %>
            <%= f.select :request_type,
        Request.request_types.keys.map { |k| [k.titleize, k] },
        { include_blank: "Select Request Type", selected: default_value },
        class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor",
        data: {
          request_form_target: "requestTypeSelect",
          action: "change->request-form#toggleDonationFields"
        } %>
          </div>
        </div>
        <!-- Donation Fields Wrapper -->
        <div id="donation-fields-wrapper bg-gray-50" data-request-form-target="donationFieldsWrapper">
          <% if @request.donation_request? %>
            <h3 class="text-xl my-4 font-semibold text-primarytextcolor mb-3 hover:text-gray-900 transition duration-200 underline">Donation Information</h3>
            <%= f.fields_for :donation, @request.donation || @request.build_donation do |df| %>
              <%= df.hidden_field :id if df.object.persisted? %>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="mb-4">
                  <%= df.label :donation_type, class: "block text-gray-700 font-bold mb-2" %>
                  <%= df.select :donation_type,
                        Donation.donation_types.keys.map { |k| [k.titleize, k] },
                        { include_blank: "Select Donation Type" },
                        class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
                </div>
                <div class="mb-4">
                  <%= df.label :donor_type, class: "block text-gray-700 font-bold mb-2" %>
                  <%= df.select :donor_type,
                        Donation.donor_types.keys.map { |k| [k.titleize, k] },
                        { include_blank: "Select Donor Type" },
                        class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
                </div>
                <div class="mb-4">
                  <%= df.label :donation_name, class: "block text-gray-700 font-bold mb-2" %>
                  <%= df.text_field :donation_name, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
                </div>
                <div class="mb-4">
                  <%= df.label :amount, class: "block text-gray-700 font-bold mb-2" %>
                  <%= df.number_field :amount, step: "0.01", class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
        <h3 class="text-xl my-4 font-semibold text-primarytextcolor mb-3 hover:text-gray-900 transition duration-200 underline">Location Information</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="mb-4">
            <%= f.label :village, class: "block text-gray-700 font-bold mb-2" %>
            <%= f.text_field :village, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
          </div>
          <div class="mb-4">
            <%= f.label :parish, class: "block text-gray-700 font-bold mb-2" %>
            <%= f.text_field :parish, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
          </div>
          <div class="mb-4 md:col-span-2">
            <%= f.label :address_note, "Address Details", class: "block text-gray-700 font-bold mb-2" %>
            <%= f.text_area :address_note, rows: 3, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
          </div>
        </div>
        <div data-controller="location" data-location-base-path-value="<%= controller.controller_name %>">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="mb-4">
              <%= f.label :district_id, "District", class: "block text-gray-700 font-bold mb-2" %>
              <%= f.collection_select :district_id, @districts, :id, :name,
                    { include_blank: "Select District", selected: @request.district_id },
                    {
                      class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor",
                      data: {
                        location_target: "district",
                        action: "change->location#loadCounties"
                      }
                    } %>
            </div>
            <div class="mb-4">
              <%= f.label :county_id, "County", class: "block text-gray-700 font-bold mb-2" %>
              <%= f.collection_select :county_id, @counties, :id, :name,
                    { include_blank: "Select County", selected: @request.county_id },
                    {
                      class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor",
                      data: {
                        location_target: "county",
                        action: "change->location#loadSubCounties",
                        initial_selection: @request.county_id
                      }
                    } %>
            </div>
            <div class="mb-4">
              <%= f.label :sub_county_id, "Sub-County", class: "block text-gray-700 font-bold mb-2" %>
              <%= f.collection_select :sub_county_id, @sub_counties, :id, :name,
                    { include_blank: "Select Sub-County", selected: @request.sub_county_id },
                    {
                      class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor",
                      data: {
                        location_target: "subCounty",
                        initial_selection: @request.sub_county_id
                      }
                    } %>
            </div>
          </div>
        </div>
        <% if current_user %>
          <h3 class="text-xl my-4 font-semibold text-primarytextcolor mb-3 hover:text-gray-900 transition duration-200 underline">Assignment</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="mb-4">
              <%= f.label :branch_id, "Branch", class: "block text-gray-700 font-bold mb-2" %>
              <%= f.collection_select :branch_id, Branch.all, :id, :name,
                  { include_blank: "Select Branch" },
                  class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
            </div>
            <div class="mb-4">
              <%= f.label :user_id, "Assigned To", class: "block text-gray-700 font-bold mb-2" %>
              <%= f.collection_select :user_id, User.all, :id, :email,
                  { include_blank: "Select User" },
                  class: " bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
            </div>
          <% end %>
          </div>
          <div class="mb-4">
            <%= f.label :user_id, "Assigned To", class: "block text-gray-700 font-bold mb-2" %>
            <div data-controller="user-dropdown" class="relative inline-block w-full text-left">
              <input type="hidden" name="request[user_id]" data-user-dropdown-target="hiddenInput" value="<%= f.object.user_id %>">
              <button type="button" data-action="click->user-dropdown#toggle" data-user-dropdown-target="button"
                class="bg-gray-50 border border-gray-300 rounded-lg p-[6px] w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor  flex items-center justify-between">
                <span data-user-dropdown-target="selectedUser">
                  <% if f.object.user %>
                    <%= f.object.user.first_name %>
                  <% else %>
                    <p class="text-base">Select User</p>
                  <% end %>
                </span>
                <svg class="w-5 h-4 ml-2 text-gray-600 font-bold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
              <ul data-user-dropdown-target="menu" class="absolute z-10 mt-1 w-full bg-white border border-gray-300 rounded shadow-lg max-h-60 overflow-auto hidden">
                <% User.all.each do |user| %>
                  <li data-action="click->user-dropdown#select"
                    data-user-id="<%= user.id %>"
                    data-user-name="<%= user.first_name %>"
                    class="cursor-pointer hover:bg-gray-100 px-3 py-2 flex items-start space-x-3">
                    <% if user.profile_picture.attached? %>
                      <div class="w-12 h-12">
                        <%= image_tag user.profile_picture, class: "w-full h-full object-cover rounded-full" %>
                      </div>
                    <% end %>
                    <div class="flex flex-col">
                      <p class="font-medium"><%= "#{user.first_name} #{user.last_name}" %></p>
                      <p class="text-sm text-gray-600"><%= user.phone_number %></p>
                    </div>
                  </li>
                <% end %>
              </ul>
            </div>
          </div>

        </div>
        <div class="flex justify-center md:justify-end text-sm items-center mt-6">
          <%= link_to "Cancel", :back, class: "bg-gray-200 hover:bg-gray-300 text-gray-700 font-medium py-2 px-4 rounded text-sm transition duration-200 transform hover:scale-105" %>
          <%= f.submit @request.persisted? ? "Update" : "Create", class: "ml-2 bg-primarycolor hover:bg-hoverprimarycolor text-white font-bold py-2 px-4 rounded" %>
        </div>
      </div>
    </div>
  </section>
<% end %>