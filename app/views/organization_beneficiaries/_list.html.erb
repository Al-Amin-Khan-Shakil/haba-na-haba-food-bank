<div class="overflow-x-auto rounded-lg">
  <table class="min-w-full max-h-fit bg-white/80 shadow-md rounded-lg border-x border-gray-100 data-table">
    <thead>
      <tr class="text-primarytext bg-sky-50">
        <th class="px-6 py-3 text-left font-Outfit text-base font-bold tracking-wider w-1/3">Organization</th>
        <th class="px-6 py-3 text-left font-Outfit text-base font-bold tracking-wider w-1/12">Male</th>
        <th class="px-6 py-3 text-left font-Outfit text-base font-bold tracking-wider w-1/12">Female</th>
        <th class="px-6 py-3 text-left font-Outfit text-base font-bold tracking-wider w-1/6">Case</th>
        <th class="px-6 py-3 text-left font-Outfit text-base font-bold tracking-wider w-1/6">Phone</th>
        <th class="px-6 py-3 text-center font-Outfit text-base font-bold tracking-wider w-1/6">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @organization_beneficiaries.each do |beneficiary| %>
        <tr class="border-b border-b-gray-100 hover:bg-gray-100">
          <td class="px-6 py-4 text-sm font-semibold font-Outfit text-[#5a607a] w-1/3"><%= beneficiary.organization_name %></td>
          <td class="px-6 py-4 text-sm font-semibold font-Outfit text-[#5a607a] w-1/12"><%= beneficiary.male %></td>
          <td class="px-6 py-4 text-sm font-semibold font-Outfit text-[#5a607a] w-1/12"><%= beneficiary.female %></td>
          <td class="px-6 py-4 text-sm font-semibold font-Outfit text-[#5a607a] w-1/6"><%= beneficiary.case_name %></td>
          <td class="px-6 py-4 text-sm font-semibold font-Outfit text-[#5a607a] w-1/6"><%= beneficiary.phone_number %></td>
          <td class="px-6 py-3 text-center text-sm font-Outfit text-[#5a607a] w-1/6">
            <div class="relative">
              <button data-dropdown-toggle="dropdown-<%= beneficiary.id %>" class="text-gray-600 focus:outline-none focus:ring-2 focus:ring-gray-300 border border-primarycolor rounded" type="button">
                <div class="p-1 flex flex-row justify-center items-center  space-between">
                  <span class="hidden md:block lg:block mr-1" >Actions</span>
                  <i class="fa-solid fa-chevron-down"></i>
                </div>
              </button>
              <div id="dropdown-<%= beneficiary.id %>" class="absolute right-0 mt-2 w-32 bg-white border rounded-lg shadow-lg z-10 hidden overflow-hidden font-Outfit font-semibold">
                <%= link_to 'Details', organization_beneficiary_path(beneficiary), class: 'cursor-pointer block px-4 py-2 text-primarycolor hover:bg-gray-100' %>
                <%= link_to 'Edit', edit_organization_beneficiary_path(beneficiary), class: 'cursor-pointer block px-4 py-2 text-primarytext hover:bg-gray-100' %>
                <%= button_to 'Delete', organization_beneficiary_path(beneficiary), method: :delete, data: { confirm: 'Are you sure?' }, class: 'cursor-pointer block px-10 py-2 text-red-600 hover:bg-gray-100 text-center' %>
              </div>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>