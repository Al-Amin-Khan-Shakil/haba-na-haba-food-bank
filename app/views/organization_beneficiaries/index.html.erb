<div class="sm:p-4 md:p-6 lg:p-8 bg-gray-50">
  <div class="bg-gradient-to-tr from-white from-40% via-primarycolor/50 via-90% to-red-600/40 to-100% shadow-xl rounded-xl p-2 sm:p-3 lg:p-8" data-controller="filter-form">
    <div class="flex justify-between items-end mt-2 mb-4">
      <h2 class="text-3xl lg:text-4xl text-primarytext font-bold text-center">
        <span class="sm:hidden">Organizations</span>
        <span class="hidden sm:inline">Organization</span>
        <span class="hidden sm:inline">Beneficiaries</span>
      </h2>
      <div class="flex justify-end gap-2">
        <button data-filter-form-target="filterButton" data-action="click->filter-form#toggleForm" class="bg-primarycolor text-white py-1 px-2 rounded hover:bg-hoverprimarycolor">
          <i class="fa-solid fa-filter"></i>
          <span class="hidden mr-1 lg:inline-block">Filter</span>
        </button>
        <%= link_to organization_beneficiaries_path, data: { filter_form_target: "clearButton", action: "click->filter-form#hideForm" }, class: "text-gray-500 py-1 px-2 bg-gray-100 border-gray-100 rounded hover:bg-gray-200" do %>
          <i class="fa-solid fa-arrows-rotate"></i> <span class="ml-1 hidden lg:inline-block">Clear</span>
        <% end %>
      </div>
    </div>
    <div data-filter-form-target="form" class="space-y-4 hidden bg-white/50 my-4 rounded-lg p-4 shadow-md text-gray-600">
      <%= form_with url: organization_beneficiaries_path, method: :get, local: true, class: "space-y-4" do |f| %>
        <div class="flex flex-wrap gap-4">
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= f.label :organization_name, "Org Name", class: "block text-gray-700" %>
            <%= f.text_field :organization_name, value: params[:organization_name], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= f.label :registration_no, "Reg No.", class: "block text-gray-700" %>
            <%= f.text_field :registration_no, value: params[:registration_no], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= f.label :case_name, "Case", class: "block text-gray-700" %>
            <%= f.text_field :case_name, value: params[:case_name], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= f.label :phone_number, "Phone", class: "block text-gray-700" %>
            <%= f.text_field :phone_number, value: params[:phone_number], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= f.label :min_people, "Min People", class: "block text-gray-700" %>
            <%= f.number_field :min_people, value: params[:min_people], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= f.label :max_people, "Max People", class: "block text-gray-700" %>
            <%= f.number_field :max_people, value: params[:max_people], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= f.label :district_id, "District", class: "block text-gray-700" %>
            <%= f.collection_select :district_id, @districts, :id, :name, { prompt: "Select District" }, { class: 'district-select form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-lightGreen focus:border-lightGreen', 'data-context-path': "organization_beneficiaries" } %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= f.label :county_id, "County", class: "block text-gray-700" %>
            <%= f.collection_select :county_id, @counties, :id, :name, { prompt: "Select County" }, { class: 'county-select form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-lightGreen focus:border-lightGreen', 'data-context-path': "organization_beneficiaries" } %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= f.label :sub_county_id, "Sub-County", class: "block text-gray-700" %>
            <%= f.collection_select :sub_county_id, @sub_counties, :id, :name, { prompt: "Select Sub-County" }, { class: 'sub-county-select form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-lightGreen focus:border-lightGreen' } %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= f.label :branch_id, "Branch", class: "block text-gray-700" %>
            <%= f.collection_select :branch_id, @branches, :id, :name, { prompt: "Select branch" }, { class: 'form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-lightGreen focus:border-lightGreen' } %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= f.label :start_date, "Start Date", class: "block text-gray-700" %>
            <%= f.date_field :start_date, value: params[:start_date], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= f.label :end_date, "End Date", class: "block text-gray-700" %>
            <%= f.date_field :end_date, value: params[:end_date], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= f.label :provided_food, "Provided", class: "block text-gray-700" %>
            <%= f.select :provided_food,
                            [["-- Select --", ""], ["Provided", "provided"], ["Not Provided", "not_provided"]],
                            {},
                            class: "form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
          </div>
        </div>
        <div class="mt-4">
          <%= f.submit "Filter", data: { filter_form_target: "submitButton", action: "click->filter-form#hideForm" }, class: "inline-block bg-primarycolor text-white py-1 px-4 rounded hover:bg-hoverprimarycolor" %>
        </div>
      <% end %>
    </div>
    <%= render "list", beneficiaries: @organization_beneficiaries %>
  </div>
</div>