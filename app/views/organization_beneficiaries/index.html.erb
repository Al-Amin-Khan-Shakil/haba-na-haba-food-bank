<div class="px-4 py-8 mx-auto max-w-7xl sm:px-6 lg:px-8">
  <div class="mb-8 sm:flex sm:items-center sm:justify-between">
    <h1 class="text-2xl font-bold leading-tight text-gray-900">Organization Beneficiaries</h1>
  </div>
  <div class="overflow-hidden bg-white shadow sm:rounded-lg">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-xs font-medium tracking-wider text-left text-gray-500 uppercase">Organization Name</th>
            <th scope="col" class="px-6 py-3 text-xs font-medium tracking-wider text-left text-gray-500 uppercase">Male</th>
            <th scope="col" class="px-6 py-3 text-xs font-medium tracking-wider text-left text-gray-500 uppercase">Female</th>
            <th scope="col" class="hidden px-6 py-3 text-xs font-medium tracking-wider text-left text-gray-500 uppercase md:table-cell">Phone</th>
            <th scope="col" class="hidden px-6 py-3 text-xs font-medium tracking-wider text-left text-gray-500 uppercase sm:table-cell">District</th>
            <th scope="col" class="px-6 py-3 text-xs font-medium tracking-wider text-right text-gray-500 uppercase">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @organization_beneficiaries.each do |beneficiary| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900">
                  <%= beneficiary.organization_name %>
                </div>
              </td>
              <td class="px-6 py-4 text-sm text-gray-500 whitespace-nowrap">
                <%= beneficiary.male %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-500 whitespace-nowrap">
                <%= beneficiary.female %>
              </td>
              <td class="hidden px-6 py-4 text-sm text-gray-500 whitespace-nowrap md:table-cell">
                <%= beneficiary.phone_number %>
              </td>
              <td class="hidden px-6 py-4 text-sm text-gray-500 whitespace-nowrap sm:table-cell">
                <%= beneficiary.district&.name %>
              </td>
              <td class="px-6 py-4 text-sm font-medium text-right whitespace-nowrap">
                <div class="flex justify-end space-x-2">
                  <%= link_to 'View', organization_beneficiary_path(beneficiary), class: "text-blue-600 hover:text-blue-900" %>
                  <%= link_to 'Edit', edit_organization_beneficiary_path(beneficiary), class: "text-indigo-600 hover:text-indigo-900" %>
                  <%= button_to 'Delete', organization_beneficiary_path(beneficiary), method: :delete, data: { confirm: 'Are you sure?' }, class: "text-red-600 hover:text-red-900" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
