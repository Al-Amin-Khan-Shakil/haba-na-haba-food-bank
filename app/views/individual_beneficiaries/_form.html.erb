<% form_url = if @individual_beneficiary&.persisted?
                individual_beneficiary_path(@individual_beneficiary)
              elsif @event
                event_individual_beneficiaries_path(@event)
              else
                request_individual_beneficiary_path(@request)
              end %>
<% method = @individual_beneficiary&.persisted? ? :patch : :post %>
<%= form_with(model: @individual_beneficiary, url: form_url, method: method, local: true, data: { controller: "location", turbo: true }) do |f| %>
  <section class=" md:p-10  sm:px-6 lg:px-8 py-8 sm:text-sm md:text-base lg:text-lg">
    <div class="bg-gradient-to-tr from-white from-40% via-primarycolor/50 via-90% to-red-600/40 to-100% transition duration-300 hover:shadow-xl md:p-12 p-4 rounded-lg shadow-lg">
      <div class="flex items-center h-auto gap-4 my-4">
        <button onclick="history.go(-1)" class="flex items-center text-sm sm:text-base bg-gray-50 text-gray-500 py-2 px-4 rounded hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400 transition duration-300 ease-in-out">
          <i class="fa-solid fa-arrow-left"></i>
          <span class="ml-2 hidden lg:inline-block ">Back</span>
        </button>
        <h2 class="text-xl font-bold text-gray-900">
          <%= @individual_beneficiary&.persisted? ? "Edit Individual Beneficiary" : "Create Individual Beneficiary" %>
        </h2>
      </div>
      <div class= "bg-white md:p-8 p-4 border  rounded-lg">
        <div class="mb-4">
          <h3 class="text-xl my-4 font-semibold text-gray-700 mb-3 hover:text-gray-900 transition duration-200 underline">Personal Information</h3>
          <%= f.label :name, class: "block text-gray-700 font-bold mb-2" %>
          <%= f.text_field :name, value: @individual_beneficiary&.name.presence || @request&.name, class: "bg-gray-50 border-none rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor" %>
        </div>
        <div class="mb-4">
          <%= f.label :sur_name, class: "block text-gray-700 font-bold mb-2" %>
          <%= f.text_field :sur_name, class: "bg-gray-50 focus:border-primarycolor border border-gray-300 rounded-lg p-2 w-full" %>
        </div>
        <div class="mb-4">
          <%= f.label :age, class: "block text-gray-700 font-bold mb-2" %>
          <%= f.number_field :age, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:border-primarycolor" %>
        </div>
        <div class="mb-4">
          <%= f.label :gender, class: "block text-gray-700 font-bold mb-2" %>
          <%= f.select :gender, IndividualBeneficiary.genders.keys.map { |k| [k.titleize, k] }, { include_blank: "Select Gender" }, class: "bg-gray-50 focus:border-primarycolor border border-gray-300 rounded-lg p-2 w-full focus:border-primarycolor", required: true %>
        </div>
        <div class="mb-4">
          <%= f.label :phone_number, class: "block text-gray-700 font-bold mb-2" %>
          <%= f.text_field :phone_number, value: @individual_beneficiary&.phone_number.presence || @request&.phone_number, class: "bg-gray-50 focus:border-primarycolor border border-gray-300 rounded-lg p-2 w-full" %>
        </div>
        <h3 class="text-xl my-4 underline font-semibold text-gray-700 mb-3 hover:text-gray-900 transition duration-200">Case Information</h3>
        <div class="mb-4">
          <%= f.label :case_name, class: "block text-gray-700 font-bold mb-2" %>
          <%= f.text_field :case_name, class: "bg-gray-50 focus:border-primarycolor border border-gray-300 rounded-lg p-2 w-full" %>
        </div>
        <div class="mb-4">
          <%= f.label :case_description, class: "block text-gray-700 font-bold mb-2" %>
          <%= f.text_area :case_description, { rows: 10, class: "bg-gray-50 focus:border-primarycolor border border-gray-300 rounded-lg p-2 w-full" } %>
        </div>
        <h3 class="text-xl my-4 font-semibold text-gray-700 mb-3 hover:text-gray-900 transition duration-200 underline">Family Information</h3>
        <div class="mb-4">
          <%= f.label :father_name, class: "block text-gray-700 font-bold mb-2" %>
          <%= f.text_field :father_name, class: "bg-gray-50 focus:border-primarycolor border border-gray-300 rounded-lg p-2 w-full" %>
        </div>
        <div class="mb-4">
          <%= f.label :mother_name, class: "block text-gray-700 font-bold mb-2" %>
          <%= f.text_field :mother_name, class: "bg-gray-50 focus:border-primarycolor border border-gray-300 rounded-lg p-2 w-full" %>
        </div>
        <div class="mb-4">
          <%= f.label :provided_food, class: "block text-gray-700 font-bold mb-2" %>
          <%= f.number_field :provided_food, class: "bg-gray-50 focus:border-primarycolor border border-gray-300 rounded-lg p-2 w-full", step: 0.01 %>
        </div>
        <h3 class="text-xl my-4 underline font-semibold text-gray-700 mb-3 hover:text-gray-900 transition duration-200">Location Information</h3>
        <div class="mb-4">
          <%= f.label :address_note, class: "block text-gray-700 font-bold mb-2" %>
          <%= f.text_area :address_note, value: @individual_beneficiary&.address_note.presence || @request&.address_note, class: "bg-gray-50 focus:border-primarycolor border border-gray-300 rounded-lg p-2 w-full" %>
        </div>
        <div class="mb-4">
          <%= f.label :village, class: "block text-gray-700 font-bold mb-2" %>
          <%= f.text_field :village, value: @individual_beneficiary&.village.presence || @request&.village, class: "bg-gray-50 focus:border-primarycolor border border-gray-300 rounded-lg p-2 w-full" %>
        </div>
        <div class="mb-4">
          <%= f.label :parish, class: "block text-gray-700 font-bold mb-2" %>
          <%= f.text_field :parish, value: @individual_beneficiary&.parish.presence || @request&.parish, class: "bg-gray-50 focus:border-primarycolor border border-gray-300 rounded-lg p-2 w-full" %>
        </div>
        <div data-controller="location" data-location-base-path-value="<%= controller.controller_name %>">
          <!-- District -->
          <div class="mb-4">
            <%= f.label :district_id, "District", class: "block text-gray-700 font-bold mb-2" %>
            <%= f.collection_select :district_id, @districts, :id, :name,
      { include_blank: "Select District", selected: @individual_beneficiary&.district_id || @request&.district_id },
      {
        class: "bg-gray-50 focus:border-primarycolor border border-gray-300 rounded-lg p-2 w-full",
        data: {
          location_target: "district",
          action: "change->location#loadCounties"
        }
      } %>
          </div>
          <!-- County -->
          <div class="mb-4">
            <%= f.label :county_id, "County", class: "block text-gray-700 font-bold mb-2" %>
            <%= f.select :county_id,
      options_from_collection_for_select(@counties, :id, :name, @individual_beneficiary&.county_id || @request&.county_id),
      {},
      {
        class: "bg-gray-50 focus:border-primarycolor border border-gray-300 rounded-lg p-2 w-full",
        data: {
          location_target: "county",
          action: "change->location#loadSubCounties",
          initial_selection: (@individual_beneficiary&.county_id || @request&.county_id)
        }
      } %>
          </div>
          <!-- Sub-county -->
          <div class="mb-4">
            <%= f.label :sub_county_id, "Sub-county", class: "block text-gray-700 font-bold mb-2" %>
            <%= f.select :sub_county_id,
      options_from_collection_for_select(@sub_counties, :id, :name, @individual_beneficiary&.sub_county_id || @request&.sub_county_id),
      {},
      {
        class: "bg-gray-50 focus:border-primarycolor border border-gray-300 rounded-lg p-2 w-full",
        data: {
          location_target: "subCounty",
          initial_selection: (@individual_beneficiary&.sub_county_id || @request&.sub_county_id)
        }
      } %>
          </div>
        </div>
        <div class="mb-4">
          <%= f.label :branch_id, "Branch", class: "block text-gray-700 font-bold mb-2" %>
          <%= f.collection_select :branch_id, @branches, :id, :name,
          { selected: @individual_beneficiary&.branch_id || @request&.branch_id, prompt: "Select Branch" },
          class: "bg-gray-50 focus:border-primarycolor border border-gray-300 rounded-lg p-2 w-full" %>
          <div class="flex md:justify-end lg:justify-end  justify-center text-sm">
            <%= f.submit class: "bg-primarycolor my-4 hover:bg-hoverprimarycolor text-white font-bold py-2 px-4 rounded" %>
          </div>
        </div>
      </div>
    </div>
  </section>
<% end %>