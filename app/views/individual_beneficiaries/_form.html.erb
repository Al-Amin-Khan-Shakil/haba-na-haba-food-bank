<% form_url = if @individual_beneficiary&.persisted?
                individual_beneficiary_path(@individual_beneficiary)
              elsif @event
                event_individual_beneficiaries_path(@event)
              else
                request_individual_beneficiary_path(@request)
              end %>
<% method = @individual_beneficiary&.persisted? ? :patch : :post %>
<%= form_with(model: @individual_beneficiary, url: form_url, method: method, local: true, data: { controller: "location", turbo: true }) do |f| %>
  <section class="p-5">
    <div class="bg-white p-6 rounded-lg shadow-lg">
      <h2 class="text-xl font-bold mb-4 text-gray-900">
        <%= @individual_beneficiary&.persisted? ? "Edit Individual Beneficiary" : "Create Individual Beneficiary" %>
      </h2>
      <div class="mb-4">
        <%= f.label :name, class: "block text-gray-700 font-bold mb-2" %>
        <%= f.text_field :name, value: @individual_beneficiary&.name.presence || @request&.name, class: "bg-gray-200 border border-gray-300 rounded-lg p-2 w-full" %>
      </div>
      <div class="mb-4">
        <%= f.label :age, class: "block text-gray-700 font-bold mb-2" %>
        <%= f.number_field :age, class: "bg-gray-200 border border-gray-300 rounded-lg p-2 w-full" %>
      </div>
      <div class="mb-4">
        <%= f.label :gender, class: "block text-gray-700 font-bold mb-2" %>
        <%= f.select :gender, IndividualBeneficiary.genders.keys.map { |k| [k.titleize, k] }, { include_blank: "Select Gender" }, class: "bg-gray-200 border border-gray-300 rounded-lg p-2 w-full", required: true %>
      </div>
      <div class="mb-4">
        <%= f.label :phone_number, class: "block text-gray-700 font-bold mb-2" %>
        <%= f.text_field :phone_number, value: @individual_beneficiary&.phone_number.presence || @request&.phone_number, class: "bg-gray-200 border border-gray-300 rounded-lg p-2 w-full" %>
      </div>
      <div class="mb-4">
        <%= f.label :case_name, class: "block text-gray-700 font-bold mb-2" %>
        <%= f.text_field :case_name, class: "bg-gray-200 border border-gray-300 rounded-lg p-2 w-full" %>
      </div>
      <div class="mb-4">
        <%= f.label :case_description, class: "block text-gray-700 font-bold mb-2" %>
        <%= f.text_area :case_description, class: "bg-gray-200 border border-gray-300 rounded-lg p-2 w-full" %>
      </div>
      <div class="mb-4">
        <%= f.label :father_name, class: "block text-gray-700 font-bold mb-2" %>
        <%= f.text_field :father_name, class: "bg-gray-200 border border-gray-300 rounded-lg p-2 w-full" %>
      </div>
      <div class="mb-4">
        <%= f.label :mother_name, class: "block text-gray-700 font-bold mb-2" %>
        <%= f.text_field :mother_name, class: "bg-gray-200 border border-gray-300 rounded-lg p-2 w-full" %>
      </div>
      <div class="mb-4">
        <%= f.label :sur_name, class: "block text-gray-700 font-bold mb-2" %>
        <%= f.text_field :sur_name, class: "bg-gray-200 border border-gray-300 rounded-lg p-2 w-full" %>
      </div>
      <div class="mb-4">
        <%= f.label :provided_food, class: "block text-gray-700 font-bold mb-2" %>
        <%= f.number_field :provided_food, class: "bg-gray-200 border border-gray-300 rounded-lg p-2 w-full", step: 0.01 %>
      </div>
      <div class="mb-4">
        <%= f.label :address_note, class: "block text-gray-700 font-bold mb-2" %>
        <%= f.text_area :address_note, value: @individual_beneficiary&.address_note.presence || @request&.address_note, class: "bg-gray-200 border border-gray-300 rounded-lg p-2 w-full" %>
      </div>
      <div class="mb-4">
        <%= f.label :village, class: "block text-gray-700 font-bold mb-2" %>
        <%= f.text_field :village, value: @individual_beneficiary&.village.presence || @request&.village, class: "bg-gray-200 border border-gray-300 rounded-lg p-2 w-full" %>
      </div>
      <div class="mb-4">
        <%= f.label :parish, class: "block text-gray-700 font-bold mb-2" %>
        <%= f.text_field :parish, value: @individual_beneficiary&.parish.presence || @request&.parish, class: "bg-gray-200 border border-gray-300 rounded-lg p-2 w-full" %>
      </div>
      <div data-controller="location" data-location-base-path-value="<%= controller.controller_name %>">
        <%= f.label :district_id %>
        <%= f.collection_select :district_id, @districts, :id, :name,
          { include_blank: "Select District", selected: @individual_beneficiary&.district_id || @request&.district_id },
          {
            data: {
              location_target: "district",
              action: "change->location#loadCounties"
            }
          } %>
        <%= f.label :county_id %>
        <%= f.select :county_id,
          options_from_collection_for_select(@counties, :id, :name, @individual_beneficiary&.county_id || @request&.county_id),
          {},
          {
            data: {
              location_target: "county",
              action: "change->location#loadSubCounties",
              initial_selection: (@individual_beneficiary&.county_id || @request&.county_id)
            }
          } %>
        <%= f.label :sub_county_id %>
        <%= f.select :sub_county_id,
          options_from_collection_for_select(@sub_counties, :id, :name, @individual_beneficiary&.sub_county_id || @request&.sub_county_id),
          {},
          {
            data: {
              location_target: "subCounty",
              initial_selection: (@individual_beneficiary&.sub_county_id || @request&.sub_county_id)
            }
          } %>
      </div>
      <div class="mb-4">
        <%= f.label :branch_id, "Branch", class: "block text-gray-700 font-bold mb-2" %>
        <%= f.collection_select :branch_id, @branches, :id, :name,
          { selected: @individual_beneficiary&.branch_id || @request&.branch_id, prompt: "Select Branch" },
          class: "bg-gray-200 border border-gray-300 rounded-lg p-2 w-full" %>
      </div>
      <div class="mb-4">
        <%= f.label :event_id, "Event", class: "block text-gray-700 font-bold mb-2" %>
        <%= f.collection_select :event_id, @events, :id, :title,
          { prompt: "Select Event" },
          class: "bg-gray-200 border border-gray-300 rounded-lg p-2 w-full" %>
      </div>
      <div class="flex justify-end">
        <%= f.submit class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
      </div>
    </div>
  </section>
<% end %>