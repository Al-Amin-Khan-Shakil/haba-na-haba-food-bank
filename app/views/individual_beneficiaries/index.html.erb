<%# app/views/individual_beneficiaries/index.html.erb %>
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="sm:flex sm:items-center sm:justify-between mb-8">
    <h1 class="text-2xl font-bold leading-tight text-gray-900">Individual Beneficiaries</h1>
  </div>
  
    <div class="mb-6 font-Outfit text-[#5a607a]">
    <div class="filter-form space-y-4 mt-4 ">
      <%= form_with url: individual_beneficiaries_path, method: :get, local: true, class: "space-y-4", data: { controller: "filter", action: "submit->filter#handleFilterSubmit" } do |form| %>
        <div class="flex flex-wrap gap-4">
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :name, "Name", class: "block text-gray-700" %>
            <%= form.text_field :name, value: params[:name], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :case_name, "Case", class: "block text-gray-700" %>
            <%= form.text_field :case_name, value: params[:case_name], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
          <%= form.label :gender, "Gender", class: "block text-gray-700" %>
          <%= form.select :gender,
          options_for_select(IndividualBeneficiary.genders.keys.map { |k| [k.humanize.titleize, k] }, params[:gender]),
          { include_blank: "Select" },
          class: "form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :phone_number, "Phone", class: "block text-gray-700" %>
            <%= form.text_field :phone_number, value: params[:phone_number], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
          
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :min_age, "Min Age", class: "block text-gray-700" %>
            <%= form.number_field :min_age, value: params[:min_age], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :max_age, "Max Age", class: "block text-gray-700" %>
            <%= form.number_field :max_age, value: params[:max_age], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :district_id, "District", class: "block text-gray-700" %>
            <%= form.collection_select :district_id, @districts, :id, :name, { prompt: "Select District" }, { class: 'district-select form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-lightGreen focus:border-lightGreen', 'data-context-path': "individual_beneficiaries" } %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :county_id, "County", class: "block text-gray-700" %>
            <%= form.collection_select :county_id, @counties, :id, :name, { prompt: "Select County" }, { class: 'county-select form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-lightGreen focus:border-lightGreen', 'data-context-path': "individual_beneficiaries" } %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :sub_county_id, "Sub-County", class: "block text-gray-700" %>
            <%= form.collection_select :sub_county_id, @sub_counties, :id, :name, { prompt: "Select Sub-County" }, { class: 'sub-county-select form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-lightGreen focus:border-lightGreen' } %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :branch_id, "Branch", class: "block text-gray-700" %>
            <%= form.collection_select :branch_id, @branches, :id, :name, { prompt: "Select branch" }, { class: 'form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-lightGreen focus:border-lightGreen' } %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :start_date, "Start Date", class: "block text-gray-700" %>
            <%= form.date_field :start_date, value: params[:start_date], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :end_date, "End Date", class: "block text-gray-700" %>
            <%= form.date_field :end_date, value: params[:end_date], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :provided_food, "Provided", class: "block text-gray-700" %>
            <%= form.select :provided_food,
                            [["-- Select --", ""], ["Provided", "provided"], ["Not Provided", "not_provided"]],
                            {},
                            class: "form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
          </div>
        </div>
        <div class="mt-4">
          <%= form.submit "Filter", class: "inline-block bg-blue-600 text-white py-1 px-4 rounded hover:bg-lime-500" %>
          <%= link_to "Reset", individual_beneficiaries_path, class: "inline-block bg-blue-600 text-white py-1 px-4 rounded hover:bg-lime-500"%>
        </div>
      <% end %>
    </div>
  </div>
  <div class="bg-white shadow overflow-hidden sm:rounded-lg">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Age</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Gender</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider hidden md:table-cell">Phone</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider hidden sm:table-cell">Case</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider hidden lg:table-cell">Village</th>
            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @individual_beneficiaries.each do |beneficiary| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center">
                  <div class="text-sm font-medium text-gray-900">
                    <%= beneficiary.name %>
                    <div class="md:hidden text-xs text-gray-500"><%= beneficiary.phone_number %></div>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= beneficiary.age %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full
                  <%= beneficiary.gender == 'Male' ? 'bg-blue-100 text-blue-800' : 'bg-pink-100 text-pink-800' %>">
                  <%= beneficiary.gender %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 hidden md:table-cell">
                <%= beneficiary.phone_number %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 hidden sm:table-cell">
                <%= beneficiary.case_name %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 hidden lg:table-cell">
                <%= beneficiary.village %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <div class="flex space-x-2 justify-end">
                  <%= link_to 'View', beneficiary, class: "text-blue-600 hover:text-blue-900" %>
                  <%= link_to 'Edit', edit_individual_beneficiary_path( beneficiary), class: "text-indigo-600 hover:text-indigo-900" %>
                  <%= button_to 'Delete', beneficiary, method: :delete, data: { confirm: 'Are you sure?' }, class: "text-red-600 hover:text-red-900" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>