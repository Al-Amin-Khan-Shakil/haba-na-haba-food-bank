<%# app/views/individual_beneficiaries/index.html.erb %>
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="sm:flex sm:items-center sm:justify-between mb-8">
    <h1 class="text-2xl font-bold leading-tight text-gray-900">Individual Beneficiaries</h1>
  </div>
  
    <div class="mb-6 font-Outfit text-[#5a607a]">
    <div class="filter-form bg-white p-6 rounded-lg shadow-md">
  <%= form_with url: individual_beneficiaries_path, method: :get, local: true, class: "space-y-6", data: { controller: "filter", action: "submit->filter#handleFilterSubmit" } do |form| %>
    <h3 class="text-lg font-semibold text-gray-800 mb-4">Filter Individual Beneficiaries</h3>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Personal Information -->
      <div class="space-y-2">
        <%= form.label :name, "Name", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :name, value: params[:name], class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
      </div>
      
      <div class="space-y-2">
        <%= form.label :case_name, "Case Name", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :case_name, value: params[:case_name], class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
      </div>
      
      <div class="space-y-2">
        <%= form.label :gender, "Gender", class: "block text-sm font-medium text-gray-700" %>
        <%= form.select :gender,
          options_for_select(IndividualBeneficiary.genders.keys.map { |k| [k.humanize.titleize, k] }, params[:gender]),
          { include_blank: "Select Gender" },
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
      </div>
      
      <!-- Contact Information -->
      <div class="space-y-2">
        <%= form.label :phone_number, "Phone Number", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :phone_number, value: params[:phone_number], class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
      </div>
      
      <!-- Age Range -->
      <div class="space-y-2">
        <%= form.label :min_age, "Minimum Age", class: "block text-sm font-medium text-gray-700" %>
        <%= form.number_field :min_age, value: params[:min_age], class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
      </div>
      
      <div class="space-y-2">
        <%= form.label :max_age, "Maximum Age", class: "block text-sm font-medium text-gray-700" %>
        <%= form.number_field :max_age, value: params[:max_age], class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
      </div>
      
      <!-- Location Information -->
      <div class="space-y-2">
        <%= form.label :district_id, "District", class: "block text-sm font-medium text-gray-700" %>
        <%= form.collection_select :district_id, @districts, :id, :name, { prompt: "Select District" }, { class: 'district-select mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50', 'data-context-path': "individual_beneficiaries" } %>
      </div>
      
      <div class="space-y-2">
        <%= form.label :county_id, "County", class: "block text-sm font-medium text-gray-700" %>
        <%= form.collection_select :county_id, @counties, :id, :name, { prompt: "Select County" }, { class: 'county-select mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50', 'data-context-path': "individual_beneficiaries" } %>
      </div>
      
      <div class="space-y-2">
        <%= form.label :sub_county_id, "Sub-County", class: "block text-sm font-medium text-gray-700" %>
        <%= form.collection_select :sub_county_id, @sub_counties, :id, :name, { prompt: "Select Sub-County" }, { class: 'sub-county-select mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50' } %>
      </div>
      
      <!-- Additional Fields -->
      <div class="space-y-2">
        <%= form.label :branch_id, "Branch", class: "block text-sm font-medium text-gray-700" %>
        <%= form.collection_select :branch_id, @branches, :id, :name, { prompt: "Select Branch" }, { class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50' } %>
      </div>
      
      <div class="space-y-2">
        <%= form.label :start_date, "Start Date", class: "block text-sm font-medium text-gray-700" %>
        <%= form.date_field :start_date, value: params[:start_date], class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
      </div>
      
      <div class="space-y-2">
        <%= form.label :end_date, "End Date", class: "block text-sm font-medium text-gray-700" %>
        <%= form.date_field :end_date, value: params[:end_date], class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
      </div>
      
      <div class="space-y-2">
        <%= form.label :provided_food, "Food Provided", class: "block text-sm font-medium text-gray-700" %>
        <%= form.select :provided_food,
                        [["-- Select --", ""], ["Provided", "provided"], ["Not Provided", "not_provided"]],
                        {},
                        class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primarycolor focus:ring focus:ring-primarycolor focus:ring-opacity-50" %>
      </div>
    </div>
    
    <!-- Action Buttons -->
    <div class="flex justify-end space-x-3 pt-4">
      <%= link_to "Reset", individual_beneficiaries_path, class: "px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primarycolor" %>
      <%= form.submit "Filter", class: "px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-primarycolor hover:bg-green-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primarycolor" %>
    </div>
  <% end %>
</div>
  </div>
  <div class="bg-white shadow overflow-hidden sm:rounded-lg">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Age</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Gender</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider hidden md:table-cell">Phone</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider hidden sm:table-cell">Case</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider hidden lg:table-cell">Village</th>
            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @individual_beneficiaries.each do |beneficiary| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center">
                  <div class="text-sm font-medium text-gray-900">
                    <%= beneficiary.name %>
                    <div class="md:hidden text-xs text-gray-500"><%= beneficiary.phone_number %></div>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= beneficiary.age %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full
                  <%= beneficiary.gender == 'Male' ? 'bg-blue-100 text-blue-800' : 'bg-pink-100 text-pink-800' %>">
                  <%= beneficiary.gender %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 hidden md:table-cell">
                <%= beneficiary.phone_number %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 hidden sm:table-cell">
                <%= beneficiary.case_name %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 hidden lg:table-cell">
                <%= beneficiary.village %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <div class="flex space-x-2 justify-end">
                  <%= link_to 'View', beneficiary, class: "text-blue-600 hover:text-blue-900" %>
                  <%= link_to 'Edit', edit_individual_beneficiary_path( beneficiary), class: "text-indigo-600 hover:text-indigo-900" %>
                  <%= button_to 'Delete', beneficiary, method: :delete, data: { confirm: 'Are you sure?' }, class: "text-red-600 hover:text-red-900" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>