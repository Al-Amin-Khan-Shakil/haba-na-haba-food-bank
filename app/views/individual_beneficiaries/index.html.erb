<div class="sm:p-4 md:p-6 lg:p-8 bg-gray-50">
  <div class="bg-gradient-to-tr from-white from-40% via-primarycolor/50 via-90% to-red-600/40 to-100% shadow-xl rounded-xl p-2 sm:p-3 lg:p-8" data-controller="filter-form">
    <div class="flex justify-between items-end mt-2 mb-4">
      <h2 class="text-3xl lg:text-4xl text-primarytext font-bold text-center">
        <span class="sm:hidden">Individuals</span>
        <span class="hidden sm:inline md:inline">Individual</span>
        <span class="hidden sm:inline">Beneficiaries</span>
      </h2>
      <div class="flex justify-end gap-2">
        <button data-filter-form-target="filterButton" data-action="click->filter-form#toggleForm" class="cursor-pointer bg-primarycolor text-white py-1 px-2 rounded hover:bg-hoverprimarycolor">
          <i class="fa-solid fa-filter"></i>
          <span class="hidden mr-1 lg:inline-block">Filter</span>
        </button>
        <%= link_to individual_beneficiaries_path, data: { filter_form_target: "clearButton", action: "click->filter-form#hideForm" }, class: "cursor-pointer text-gray-500 py-1 px-2 bg-gray-100 border-gray-100 rounded hover:bg-gray-200" do %>
          <i class="fa-solid fa-arrows-rotate"></i> <span class="ml-1 hidden lg:inline-block">Clear</span>
        <% end %>
      </div>
    </div>
    <div data-filter-form-target="form" class="space-y-4 hidden bg-white/50 my-4 rounded-lg p-4 shadow-md text-gray-600">
      <%= form_with url: individual_beneficiaries_path, method: :get, local: true, class: "space-y-4",
      data: {
                     controller: "location", 
      location_base_path_value: "individual_beneficiaries",
      location_context_path_value: individual_beneficiaries_path
              } do |form| %>
        <div class="flex flex-wrap gap-4">
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :name, "Name", class: "block text-gray-700" %>
            <%= form.text_field :name, value: params[:name], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-primarycolor focus:border-primarycolor" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :case_name, "Case", class: "block text-gray-700" %>
            <%= form.text_field :case_name, value: params[:case_name], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-primarycolor focus:border-primarycolor" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :phone_number, "Phone", class: "block text-gray-700" %>
            <%= form.text_field :phone_number, value: params[:phone_number], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-primarycolor focus:border-primarycolor" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :min_age, "Min Age", class: "block text-gray-700" %>
            <%= form.number_field :min_age, value: params[:min_age], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-primarycolor focus:border-primarycolor" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :max_age, "Max Age", class: "block text-gray-700" %>
            <%= form.number_field :max_age, value: params[:max_age], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-primarycolor focus:border-primarycolor" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :district_id, "District", class: "block text-gray-700" %>
            <%= form.collection_select :district_id, @districts, :id, :name, { prompt: "Select District", selected: params[:district_id] }, { class: 'district-select form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-primarycolor focus:border-primarycolor', 'data-context-path': "individual_beneficiaries",
             data: {
                        location_target: "district",
                        action: "change->location#loadCounties"
                      } } %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :county_id, "County", class: "block text-gray-700" %>
            <%= form.collection_select :county_id, @counties, :id, :name, { prompt: "Select County", selected: params[:county_id] }, { class: 'county-select form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-primarycolor focus:border-primarycolor', 'data-context-path': "individual_beneficiaries",
             data: {
                        location_target: "county",
                        action: "change->location#loadSubCounties",
                        initial_selection: @request&.county_id
                      } } %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :sub_county_id, "Sub-County", class: "block text-gray-700" %>
            <%= form.collection_select :sub_county_id, @sub_counties, :id, :name, { prompt: "Select Sub-County", selected: params[:sub_county_id] }, { class: 'sub-county-select form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-primarycolor focus:border-primarycolor',
              data: {
                        location_target: "subCounty",
                        initial_selection: @request&.sub_county_id
                      } } %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :branch_id, "Branch", class: "block text-gray-700" %>
            <%= form.collection_select :branch_id, @branches, :id, :name, { prompt: "Select branch", selected: params[:branch_id] }, { class: 'form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-primarycolor focus:border-primarycolor' } %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :start_date, "Start Date", class: "block text-gray-700" %>
            <%= form.date_field :start_date, value: params[:start_date], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-primarycolor focus:border-primarycolor" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :end_date, "End Date", class: "block text-gray-700" %>
            <%= form.date_field :end_date, value: params[:end_date], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-primarycolor focus:border-primarycolor" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :provided_food, "Provided Food", class: "block text-gray-700" %>
            <%= form.text_field :provided_food,value: params[:provided_food],
                            class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-primarycolor focus:border-primarycolor" %>
          </div>
        </div>
        <div class="mt-4">
          <%= form.submit "Filter", data: { filter_form_target: "submitButton", action: "click->filter-form#hideForm" }, class: "inline-block bg-primarycolor text-white py-1 px-4 rounded hover:bg-hoverprimarycolor" %>
        </div>
      <% end %>
    </div>
    <%= render "list", beneficiaries: @individual_beneficiaries %>
  </div>
</div>