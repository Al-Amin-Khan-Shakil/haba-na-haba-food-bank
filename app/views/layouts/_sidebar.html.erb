<nav class="fixed top-0 z-50 w-full border-b border-gray-200 shadow-sm dark:bg-gray-800 dark:border-gray-700">
  <div class="relative px-3 py-3 bg-white lg:px-5 lg:pl-3">
    <div class="flex justify-between items-center">
      <div class="flex justify-center items-center rtl:justify-end">
        <button data-drawer-target="logo-sidebar" data-drawer-toggle="logo-sidebar" aria-controls="logo-sidebar" type="button" class="inline-flex items-center p-2 text-sm text-gray-500 rounded-lg xl:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 dark:focus:ring-gray-600">
          <span class="sr-only">Open sidebar</span>
          <svg class="w-6 h-6" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            <path clip-rule="evenodd" fill-rule="evenodd" d="M2 4.75A.75.75 0 012.75 4h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 4.75zm0 10.5a.75.75 0 01.75-.75h7.5a.75.75 0 010 1.5h-7.5a.75.75 0 01-.75-.75zM2 10a.75.75 0 01.75-.75h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 10z"></path>
          </svg>
        </button>
        <a href="https://flowbite.com" class="flex absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 ms-2 md:me-24 xl:static xl:transform-none">
          <%= image_tag("hnh_admin_mobile_logo.png", class:"h-8 me-3", alt:"HNH Logo") %>
          <span class="hidden self-center text-xl font-semibold whitespace-nowrap text-primarycolor sm:text-2xl xl:inline-block dark:text-white">Haba Na Haba</span>
        </a>
      </div>
      <div class="flex items-center">
        <div class="flex items-center leading-tight ms-3">
          <div class="flex flex-col gap-0 justify-center items-end mr-4">
            <p class="hidden text-sm text-gray-600 capitalize md:block dark:text-white">
              <%= current_user.first_name %> <%= current_user.last_name %>
            </p>
            <p class="hidden -mt-1 text-xs text-gray-600 capitalize md:block dark:text-white">
              <%= current_user.role.humanize %>
            </p>
          </div>
          <% if current_user && current_user.profile_picture.attached? %>
            <button type="button" class="flex text-sm bg-gray-800 rounded-full focus:ring-4 focus:ring-gray-300 dark:focus:ring-gray-600" aria-expanded="false" data-dropdown-toggle="dropdown-user">
              <span class="sr-only">Open user menu</span>
              <img class="object-cover w-8 h-8 rounded-full" src="<%= current_user.profile_picture.attached? ? url_for(current_user.profile_picture) : 'https://avatars.githubusercontent.com/u/583231?v=4' %>" alt="user photo">
            </button>
          <% end %>
        </div>
        <div class="hidden z-50 my-4 text-base list-none bg-white rounded divide-y divide-gray-100 shadow dark:bg-gray-700 dark:divide-gray-600" id="dropdown-user">
          <div class="px-4 py-3">
            <p>
              <%= link_to user_path(current_user), class:"block font-medium py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-600 dark:hover:text-white" do %>
                <span class="text-gray-700 truncate whitespace-nowrap group-hover:text-primarytext"><%= current_user.first_name %> <%= current_user.last_name %></span>
              <% end %>
            </p>
            <p class="text-sm font-medium text-gray-900 truncate dark:text-gray-300">
              <%= current_user.email %>
            </p>
          </div>
          <ul class="py-1">
            <li>
              <%= link_to authenticated_root_path, class:"block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-600 dark:hover:text-white" do %>
                <span>Settings</span>
              <% end %>
            </li>
            <li>
              <%= link_to destroy_user_session_path, data: { "turbo-method": :delete }, class:"block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-600 dark:hover:text-white" do %>
                <span>Sign out</span>
              <% end %>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</nav>

<aside id="logo-sidebar" class="fixed top-0 left-0 z-40 pt-20 w-64 h-screen border-r border-gray-200 transition-transform -translate-x-full bg-primarycolor xl:translate-x-0 dark:bg-gray-800 dark:border-gray-700" aria-label="Sidebar">
  <div class="overflow-y-auto px-3 pb-4 h-full bg-primarycolor dark:bg-gray-800">
    <ul class="space-y-2 font-medium">
      <li>
        <%= link_to authenticated_root_path, class: "flex items-center p-2 text-gray-900 rounded-lg dark:text-white hover:bg-gray-100 dark:hover:bg-gray-700 group" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white transition duration-75 group-hover:text-gray-800" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h7v7H3V3zm0 11h7v7H3v-7zm11-11h7v7h-7V3zm0 11h7v7h-7v-7z" />
          </svg>
          <span class="ms-3 whitespace-nowrap text-white group-hover:text-primarytext">Dashboard</span>
        <% end %>
      </li>
      
      <li>
        <%= link_to branches_path, class:"flex items-center p-2 text-gray-900 rounded-lg dark:text-white hover:bg-gray-100 dark:hover:bg-gray-700 group" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white group-hover:text-gray-800" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 9l1.5-4.5h15L21 9v10a1 1 0 01-1 1h-4V9H8v11H4a1 1 0 01-1-1V9z" />
          </svg>
          <span class="text-white whitespace-nowrap ms-3 group-hover:text-primarytext">Branches</span>
        <% end %>
      </li>
      
      <li>
        <%= link_to requests_path, class:"flex items-center p-2 text-gray-900 rounded-lg dark:text-white hover:bg-gray-100 dark:hover:bg-gray-700 group" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white group-hover:text-gray-800" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20 13v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16-3V6a2 2 0 00-2-2H6a2 2 0 00-2 2v4m16 0l-4-4m0 0l-4 4m4-4v12" />
          </svg>
          <span class="text-white whitespace-nowrap ms-3 group-hover:text-primarytext">Requests</span>
        <% end %>
      </li>
      
      <li>
        <%= link_to users_path, class:"flex items-center p-2 text-gray-900 rounded-lg dark:text-white hover:bg-gray-100 dark:hover:bg-gray-700 group" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white group-hover:text-gray-800" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-1a4 4 0 00-4-4h-1m-4 5v-1a4 4 0 00-4-4H7a4 4 0 00-4 4v1h5m4-5a4 4 0 100-8 4 4 0 000 8z" />
          </svg>
          <span class="text-white whitespace-nowrap ms-3 group-hover:text-primarytext">Users</span>
        <% end %>
      </li>
      
      <li>
        <%= link_to authenticated_root_path, class:"flex items-center p-2 text-gray-900 rounded-lg dark:text-white hover:bg-gray-100 dark:hover:bg-gray-700 group" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white group-hover:text-gray-800" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 7l1.664-2.5A2 2 0 016.236 3h11.528a2 2 0 011.572.764L21 7M5 10v10a1 1 0 001 1h12a1 1 0 001-1V10M10 13h4" />
          </svg>
          <span class="text-white whitespace-nowrap ms-3 group-hover:text-primarytext">Inventories</span>
        <% end %>
      </li>
      
      <li>
        <details class="">
          <summary class="flex items-center p-2 text-white rounded-lg cursor-pointer hover:bg-gray-100 group">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white group-hover:text-gray-800" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-1a4 4 0 00-4-4h-1M9 20H4v-1a4 4 0 014-4h1m4-6a4 4 0 100-8 4 4 0 000 8z" />
            </svg>
            <span class="text-base ms-3 group-hover:text-primarytext">Beneficiaries</span>
            <i class="ml-2 text-xs transition-transform duration-200 fa-solid fa-chevron-down group-hover:text-primarytext"></i>
          </summary>
          <ul class="pl-3 mt-2 space-y-2 border-l-2 border-white ms-8">
            <li>
              <%= link_to individual_beneficiaries_path, class: "flex items-center px-2 text-white hover:bg-gray-100 rounded-md" do %>
                <span class="w-2 h-2 rounded-full mr-2 text-base bg-primarytext"></span>
                <span class="text-primarytext">Individual</span>
              <% end %>
            </li>
            <li>
              <%= link_to family_beneficiaries_path, class: "flex items-center px-2 text-white hover:bg-gray-100 hover:text-primarytext rounded-md" do %>
                <span class="mr-2 w-2 h-2 text-base rounded-full bg-primarytext"></span>
                <span class="text-primarytext">Family</span>
              <% end %>
            </li>
            <li>
              <%= link_to organization_beneficiaries_path, class: "flex items-center px-2 text-white hover:bg-gray-100 hover:text-primarytext rounded-md" do %>
                <span class="mr-2 w-2 h-2 text-base rounded-full bg-primarytext"></span>
                <span class="text-primarytext">Organization</span>
              <% end %>
            </li>
          </ul>
        </details>
      </li>
      
      <li>
        <%= link_to events_path, class:"flex items-center p-2 text-gray-900 rounded-lg dark:text-white hover:bg-gray-100 dark:hover:bg-gray-700 group" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white group-hover:text-gray-800" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 4h10M5 11h14M5 19h14M5 15h14" />
          </svg>
          <span class="text-white whitespace-nowrap ms-3 group-hover:text-primarytext">Events</span>
        <% end %>
      </li>
      
      <li>
        <%= link_to districts_path, class:"flex items-center p-2 text-gray-900 rounded-lg dark:text-white hover:bg-gray-100 dark:hover:bg-gray-700 group" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white group-hover:text-gray-800" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 11c1.657 0 3-1.343 3-3S13.657 5 12 5s-3 1.343-3 3 1.343 3 3 3z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4.5 8-11a8 8 0 10-16 0c0 6.5 8 11 8 11z" />
          </svg>
          <span class="text-white whitespace-nowrap ms-3 group-hover:text-primarytext">Locations</span>
        <% end %>
      </li>
      
      <p class="py-2 mr-20 text-sm font-normal text-white font-Outfit">PREFERENCE</p>
      
      <li>
      <%= link_to user_path(current_user), class: "flex items-center gap-2 p-2 text-gray-900 rounded-lg dark:text-white hover:bg-gray-100 dark:hover:bg-gray-700 group" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white group-hover:text-gray-800" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15.75A3.75 3.75 0 1 0 12 8.25a3.75 3.75 0 0 0 0 7.5zM19.5 12a7.5 7.5 0 0 0-.225-1.8l1.63-1.26a.75.75 0 0 0 .105-1.14l-1.5-1.5a.75.75 0 0 0-1.14.105l-1.26 1.63a7.5 7.5 0 0 0-1.8-.225 7.5 7.5 0 0 0-1.8.225l-1.26-1.63a.75.75 0 0 0-1.14-.105l-1.5 1.5a.75.75 0 0 0 .105 1.14l1.63 1.26c-.15.57-.225 1.17-.225 1.8s.075 1.23.225 1.8l-1.63 1.26a.75.75 0 0 0-.105 1.14l1.5 1.5c.3.3.78.3 1.08 0l1.26-1.63c.57.15 1.17.225 1.8.225s1.23-.075 1.8-.225l1.26 1.63c.3.3.78.3 1.08 0l1.5-1.5a.75.75 0 0 0-.105-1.14l-1.63-1.26c.15-.57.225-1.17.225-1.8z" />
        </svg>
        <span class="text-white whitespace-nowrap group-hover:text-primarytext">Profile</span>
      <% end %>
    </li>
    
    
      <li>
        <%= link_to destroy_user_session_path, class:"flex items-center p-2 text-gray-900 rounded-lg dark:text-white hover:bg-gray-100 dark:hover:bg-gray-700 group" do %>
            <i class="text-base text-white fa-solid fa-gear group-hover:text-gray-800"></i>
          <span class="text-white whitespace-nowrap ms-3 group-hover:text-primarytext">Log Out</span>
        <% end %>
      </li>
    </ul>
  </div>
</aside>

<div class="p-4 min-h-screen bg-gray-50 xl:ml-64">
  <div class="mt-14 bg-gray-50">
    <%= yield %>
  </div>
</div>