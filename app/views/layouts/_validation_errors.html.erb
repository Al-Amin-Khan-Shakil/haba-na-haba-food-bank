<% if resource&.errors&.any? %>
  <div
    data-controller="flash"
    data-flash-delay-value="30000"
    class="absolute top-16 right-4 z-1 px-4 py-3 rounded shadow-md max-w-sm mt-10
           bg-red-100 text-red-800 transition-opacity duration-1000 opacity-100"
  >
    <h3 class="font-bold mb-1">Please fix these errors:</h3>
    <ul class="list-disc pl-5 text-sm">
      <% resource.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>
