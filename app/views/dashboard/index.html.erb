<div class="sm:p-4 md:p-6 lg:p-8 bg-gray-50">
  <div class="w-full bg-white rounded-lg shadow-sm dark:bg-gray-800 p-4 md:p-6"
       data-controller="chart"
       data-chart-food-data-value="<%= @food_data.to_json %>"
       data-chart-donation-data-value="<%= @donation_data.to_json %>"
       data-chart-dates-value="<%= @dates.to_json %>">
    <div class="flex justify-between mb-5">
      <div class="grid gap-4 grid-cols-2">
        <div>
          <h5 class="inline-flex items-center text-gray-500 dark:text-gray-400 leading-none font-normal mb-2">
            Food Requests
            <svg data-popover-target="food-info" data-popover-placement="bottom" class="w-3 h-3 text-gray-400 hover:text-gray-900 dark:hover:text-white cursor-pointer ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
              <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
            </svg>
            <div data-popover id="food-info" role="tooltip" class="absolute z-10 invisible inline-block text-sm text-gray-500 transition-opacity duration-300 bg-white border border-gray-200 rounded-lg shadow-xs opacity-0 w-72 dark:bg-gray-800 dark:border-gray-600 dark:text-gray-400">
              <div class="p-3 space-y-2">
                <h3 class="font-semibold text-gray-900 dark:text-white">Food Requests Growth</h3>
                <p>Shows the cumulative growth of food requests over time. A growing trend is ideal; stagnation may indicate reduced activity.</p>
                <h3 class="font-semibold text-gray-900 dark:text-white">Calculation</h3>
                <p>For each date bucket, the all-time volume of requests is calculated, including all previous requests plus new ones.</p>
                <a href="#" class="flex items-center font-medium text-blue-600 dark:text-blue-500 dark:hover:text-blue-600 hover:text-blue-700 hover:underline">Read more <svg class="w-2 h-2 ms-1.5 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                  </svg></a>
              </div>
              <div data-popper-arrow></div>
            </div>
          </h5>
          <p class="text-primarytext dark:text-white text-2xl leading-none font-bold"><%= @food_requests.values.sum %></p>
        </div>
        <div>
          <h5 class="inline-flex items-center text-gray-500 dark:text-gray-400 leading-none font-normal mb-2">
            Donation Requests
            <svg data-popover-target="donation-info" data-popover-placement="bottom" class="w-3 h-3 text-gray-400 hover:text-gray-900 dark:hover:text-white cursor-pointer ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
              <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
            </svg>
            <div data-popover id="donation-info" role="tooltip" class="absolute z-10 invisible inline-block text-sm text-gray-500 transition-opacity duration-300 bg-white border border-gray-200 rounded-lg shadow-xs opacity-0 w-72 dark:bg-gray-800 dark:border-gray-600 dark:text-gray-400">
              <div class="p-3 space-y-2">
                <h3 class="font-semibold text-gray-900 dark:text-white">Donation Requests Growth</h3>
                <p>Shows the cumulative growth of donation requests over time. A growing trend is ideal; stagnation may indicate reduced activity.</p>
                <h3 class="font-semibold text-gray-900 dark:text-white">Calculation</h3>
                <p>For each date bucket, the all-time volume of requests is calculated, including all previous requests plus new ones.</p>
                <a href="#" class="flex items-center font-medium text-blue-600 dark:text-blue-500 dark:hover:text-blue-600 hover:text-blue-700 hover:underline">Read more <svg class="w-2 h-2 ms-1.5 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                  </svg></a>
              </div>
              <div data-popper-arrow></div>
            </div>
          </h5>
          <p class="text-primarytext dark:text-white text-2xl leading-none font-bold"><%= @donation_requests.values.sum %></p>
        </div>
      </div>
      <div>
        <button id="lineChartDropdownButton"
                data-dropdown-toggle="lineChartDropdown"
                data-dropdown-placement="bottom"
                type="button"
                class="px-3 py-2 inline-flex items-center text-sm font-medium text-primarytext focus:outline-none bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-primarycolor focus:z-10 focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700">
          <%= @current_time_range.to_s.humanize %>
          <svg class="w-2.5 h-2.5 ms-2.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 4 4 4-4"/>
          </svg>
        </button>
        <div id="lineChartDropdown" class="z-10 hidden bg-white divide-y divide-gray-100 rounded-lg shadow-sm w-44 dark:bg-gray-700">
          <ul class="py-2 text-sm text-gray-700 dark:text-gray-200" aria-labelledby="lineChartDropdownButton">
            <li>
              <a href="#" data-action="click->chart#changeTimeRange" data-time-range="yesterday" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">Yesterday</a>
            </li>
            <li>
              <a href="#" data-action="click->chart#changeTimeRange" data-time-range="today" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">Today</a>
            </li>
            <li>
              <a href="#" data-action="click->chart#changeTimeRange" data-time-range="last_7_days" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">Last 7 days</a>
            </li>
            <li>
              <a href="#" data-action="click->chart#changeTimeRange" data-time-range="last_30_days" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">Last 30 days</a>
            </li>
            <li>
              <a href="#" data-action="click->chart#changeTimeRange" data-time-range="last_90_days" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">Last 90 days</a>
            </li>
            <li>
              <a href="#" data-action="click->chart#changeTimeRange" data-time-range="current_year" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">Current Year</a>
            </li>
          </ul>
        </div>
      </div>
    </div>
    <!-- Add start and end date display -->
    <div class="text-sm text-gray-500 dark:text-gray-400 mb-2">
      Showing data from <%= @start_date.strftime("%d %b %Y") %> to <%= @end_date.strftime("%d %b %Y") %>
    </div>
    <div class="relative">
      <div id="line-chart" style="height: 300px; width: 100%;"></div>
    </div>
  </div>
  <div class="my-6"></div>
  <div class="max-w-[50%] w-full bg-white rounded-lg shadow-sm dark:bg-gray-800 p-4 md:p-6"
       data-controller="pie-chart"
       data-pie-chart-percentages-value="<%= @percentages.to_json %>">
    <div class="flex justify-between items-start w-full">
      <div class="flex-col items-center">
        <div class="flex items-center mb-1">
          <h5 class="text-xl font-bold leading-none text-primarytext dark:text-white me-1">Beneficiaries & Inventory</h5>
          <svg data-popover-target="chart-info" data-popover-placement="bottom" class="w-3.5 h-3.5 text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white cursor-pointer ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm0 16a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Zm1-5.034V12a1 1 0 0 1-2 0v-1.418a1 1 0 0 1 1.038-.999 1.436 1.436 0 0 0 1.488-1.441 1.501 1.501 0 1 0-3-.116.986.986 0 0 1-1.037.961 1 1 0 0 1-.96-1.037A3.5 3.5 0 1 1 11 11.466Z"/>
          </svg>
          <div data-popover id="chart-info" role="tooltip" class="absolute z-10 invisible inline-block text-sm text-gray-500 transition-opacity duration-300 bg-white border border-gray-200 rounded-lg shadow-xs opacity-0 w-72 dark:bg-gray-800 dark:border-gray-600 dark:text-gray-400">
            <div class="p-3 space-y-2">
              <h3 class="font-semibold text-gray-900 dark:text-white">Distribution Overview</h3>
              <p>Shows the percentage distribution of Individual Beneficiaries, Family Beneficiaries, Organization Beneficiaries, and Inventories within the selected time range.</p>
              <h3 class="font-semibold text-gray-900 dark:text-white">Calculation</h3>
              <p>Counts are calculated based on records created within the selected period. Percentages are derived from the total count of all four categories.</p>
              <a href="#" class="flex items-center font-medium text-blue-600 dark:text-blue-500 dark:hover:text-blue-600 hover:text-blue-700 hover:underline">Read more <svg class="w-2 h-2 ms-1.5 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                  <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                </svg></a>
            </div>
            <div data-popper-arrow></div>
          </div>
        </div>
      </div>
      <div class="text-sm text-gray-500 dark:text-gray-400">
        <%= @start_date.strftime("%d %b %Y") %> - <%= @end_date.strftime("%d %b %Y") %>
      </div>
    </div>
    <!-- Pie Chart -->
    <div class="py-6" id="pie-chart"></div>
    <div class="grid grid-cols-1 items-center border-gray-200 border-t dark:border-gray-700 justify-between">
      <div class="flex justify-between items-center pt-5">
        <button
          id="pieChartDropdownButton"
          data-dropdown-toggle="pieChartDropdown"
          data-dropdown-placement="bottom"
          class="text-sm font-medium text-gray-500 dark:text-gray-400 hover:text-gray-900 text-center inline-flex items-center dark:hover:text-white"
          type="button">
          <%= @current_time_range.to_s.humanize %>
          <svg class="w-2.5 m-2.5 ms-1.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 4 4 4-4"/>
          </svg>
        </button>
        <div id="pieChartDropdown" class="z-10 hidden bg-white divide-y divide-gray-100 rounded-lg shadow-sm w-44 dark:bg-gray-700">
          <ul class="py-2 text-sm text-gray-700 dark:text-gray-200" aria-labelledby="pieChartDropdownButton">
            <li>
              <a href="#" data-action="click->pie-chart#changeTimeRange" data-time-range="yesterday" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">Yesterday</a>
            </li>
            <li>
              <a href="#" data-action="click->pie-chart#changeTimeRange" data-time-range="today" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">Today</a>
            </li>
            <li>
              <a href="#" data-action="click->pie-chart#changeTimeRange" data-time-range="last_7_days" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">Last 7 days</a>
            </li>
            <li>
              <a href="#" data-action="click->pie-chart#changeTimeRange" data-time-range="last_30_days" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">Last 30 days</a>
            </li>
            <li>
              <a href="#" data-action="click->pie-chart#changeTimeRange" data-time-range="last_90_days" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">Last 90 days</a>
            </li>
            <li>
              <a href="#" data-action="click->pie-chart#changeTimeRange" data-time-range="current_year" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">Current Year</a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>