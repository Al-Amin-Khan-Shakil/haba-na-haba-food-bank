<div class="max-w-4xl mx-auto my-8 bg-white shadow-md rounded-lg p-6">
  <!-- District Name -->
  <h1 class="text-3xl font-bold text-gray-800 mb-4">
    <%= @district.name %>
  </h1>
  <!-- Counties and Sub-Counties -->
  <div class="space-y-6">
    <% @district.counties.each do |county| %>
      <div class="border border-gray-300 rounded-lg p-4">
        <!-- County Name -->
        <h2 class="text-2xl font-semibold text-gray-700 mb-2">
          County: <%= county.name %>
        </h2>
        <!-- Sub-Counties -->
        <h3 class="text-lg font-medium text-gray-600">Sub-Counties:</h3>
        <ul class="list-disc list-inside text-gray-600">
          <% county.sub_counties.each do |sub_county| %>
            <li><%= sub_county.name %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
  <!-- Back Button -->
  <div class="mt-6">
    <%= link_to "Back to Districts", districts_path, class: "text-blue-500 hover:text-blue-700 font-medium" %>
  </div>
</div>
