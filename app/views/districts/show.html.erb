<div class="sm:p-4 md:p-6 lg:p-8 bg-gray-50">
  <div class="min-w-full bg-gradient-to-tr from-white from-40% via-primarycolor/50 via-90% to-red-600/40 to-100% text-white shadow-xl rounded-xl p-3 sm:p-8 mb-8">
    <div class="cursor-pointer flex justify-between items-center mb-4">
      <%= link_to districts_path, class: "flex items-center text-sm sm:text-base text-gray-500 py-1 px-4 rounded bg-gray-200 hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400 transition duration-300 ease-in-out" do %>
        <i class="fa-solid fa-arrow-left"></i>
        <span class="ml-2 hidden lg:inline-block">Back</span>
      <% end %>
      <h2 class="text-3xl text-primarytext font-bold text-center leading-tight">Details</h2>
    </div>
    <div class="text-xl sm:text-2xl font-bold text-primarytext mb-4 text-center rounded-lg bg-white/60 p-2 shadow-lg hover:shadow-2xl transition-all duration-300 ease-in-out"><%= @district.name %> District</div>
    <div class="grid grid-cols-1 md:grid-cols-2 2xl:grid-cols-3 gap-4 md:gap-6 lg:gap-8">
      <% if @district.counties.present? %>
        <% @district.counties.each do |county| %>
          <div class="bg-white p-3 sm:p-6 rounded-lg shadow-lg hover:shadow-2xl transition-all duration-300 ease-in-out">
            <div class="text-lg sm:text-xl font-semibold text-primarytext mb-4 underline"><%= county&.name %></div>
            <% if county.sub_counties.present? %>
              <% county.sub_counties.each do |sub_county| %>
                <div class="space-y-4">
                  <div class="flex items-start justify-between gap-1.5 sm:gap-3 border-b border-gray-100">
                    <div class="flex-1 flex justify-start items-start">
                      <p class="text-sm sm:text-base text-wrap break-all font-medium text-[#5a607a] truncate capitalize"><%= sub_county&.name %></p>
                    </div>
                  </div>
                </div>
              <% end %>
            <% else %>
              <p class="text-sm sm:text-base text-[#fd7979f6]">No sub-counties available</p>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p class="text-sm sm:text-base text-[#fd7979f6]">No counties available</p>
      <% end %>
    </div>
    <div class="mt-8 flex justify-end items-center gap-4">
      <%= link_to 'Edit', edit_district_path(@district), class: 'cursor-pointer bg-primarycolor text-white py-1 px-4 w-fit rounded hover:bg-hoverprimarycolor transition-all text-sm sm:text-base' %>
      <%= button_to 'Destroy', district_path(@district), method: :delete, data: { confirm: 'Are you sure?' }, class: 'cursor-pointer bg-red-600 text-white py-1 px-4 w-fit rounded hover:bg-red-700 transition-all text-sm sm:text-base' %>
    </div>
  </div>
</div>