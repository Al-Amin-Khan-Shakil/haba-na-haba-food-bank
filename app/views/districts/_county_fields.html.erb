<div class="county border border-gray-300 p-4 rounded-lg shadow-sm">
  <div>
    <%= f.label :name, "County Name", class: "block text-gray-700 font-medium mb-2" %>
    <%= f.text_field :name, class: "w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>
  <%= f.hidden_field :_destroy %>
  <%= link_to "Remove County", "#", class: "remove-county text-red-500 hover:text-red-700 font-medium mt-2 inline-block" %>
  <h4 class="text-lg font-semibold text-gray-800 mt-4 mb-2">Sub-Counties</h4>
  <div class="sub-counties space-y-4" data-template="<%= j(render('sub_county_fields', sub_county: SubCounty.new)) %>">
    <%= f.fields_for :sub_counties do |sub_county_form| %>
      <%= render 'sub_county_fields', sub_county_form: sub_county_form %>
    <% end %>
  </div>
  <%= link_to "Add Sub-County", "#", class: "add-sub-county text-blue-500 hover:text-blue-700 font-medium mt-2 inline-block" %>
</div>
