<%= form_with(model: district, local: true) do |f| %>
  <section class="custom-select md:p-10 sm:px-6 lg:px-8 py-8 sm:text-sm md:text-base lg:text-lg">
    <div class="bg-gradient-to-tr from-white from-40% via-primarycolor/50 via-90% to-red-600/40 to-100% transition duration-300 hover:shadow-xl md:p-12 p-4 rounded-lg shadow-lg filter">
      <div class="flex justify-between items-center h-auto gap-4 my-4">
        <button onclick="history.go(-1)" class="border rounded-lg flex items-center text-sm sm:text-base bg-gray-50 px-5 py-2 transition duration-300 ease-in-out">
          <i class="fa-solid fa-arrow-left"></i>
          <span class="ml-2 hidden lg:inline-block ">Back</span>
        </button>
        <h2 class="text-3xl text-primarytextcolor font-bold text-center leading-tight">
          <%= district.persisted? ? "Edit" : "Create" %> <span class="hidden md:inline-block">District</span>
        </h2>
      </div>
      <div class="bg-white/50 md:p-8 p-4 border rounded-lg">
        <!-- District Name -->
        <div class="mb-6">
          <%= f.label :name, "District Name", class: "block text-gray-700 font-bold mb-2" %>
          <%= f.text_field :name, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
        </div>
        <!-- Counties -->
        <div data-controller="nested-form" data-association="counties" class="space-y-4">
          <div data-nested-form-target="container" class="space-y-4">
            <div class="flex items-center justify-between text-xl font-semibold text-primarytextcolor mt-4 mb-3 hover:text-gray-900 transition duration-200 ">
              <div>
                <%= @counties.present? ? "Counties" : "" %>
              </div>
              <div>
                <!-- Add County Button -->
                <button type="button" data-action="nested-form#addAssociation" data-nested-form-target="addButton" class="flex justify-center items-center md:w-auto bg-primarycolor hover:bg-hoverprimarycolor text-white font-medium py-2 px-4 rounded transition transform hover:scale-105">
                  <i class="fa-solid fa-plus"></i>
                  <span class="ml-2 hidden md:inline-block w-fit">
                    Add County
                  </span>
                </button>
              </div>
            </div>
            <%= f.fields_for :counties do |county_fields| %>
              <div class="nested-fields county-fields border border-gray-300 rounded-lg bg-gray-50 p-4 space-y-4">
                <!-- County Name -->
                <div class="field">
                  <div class="flex justify-between items-center">
                    <%= county_fields.label :name, "County Name", class: "block text-gray-700 font-medium mb-1" %>
                    <button type="button" class="remove-nested text-sm  text-gray-700 py-1 px-3 rounded transition">
                      <i class="fa-solid fa-xmark text-lg"></i>
                    </button>
                  </div>
                  <%= county_fields.text_field :name, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
                  <%= county_fields.hidden_field :_destroy %>
                </div>
                <!-- Sub-Counties -->
                <div class=" sub-counties-container" data-controller="nested-form" data-association="sub_counties">
                  <div class="justify-between flex items-center">
                    <h4 class="text-lg font-medium text-gray-700 mb-2 underline text-primarytextcolor">
                      <%= @sub_counties&.any?(&:persisted?) ? "Sub-counties" : "" %>
                    </h4>
                    <!-- Add Sub-County Button -->
                    <button type="button" data-action="nested-form#addAssociation" class="text-left mb-2 text-sm text-white bg-primarycolor hover:bg-primarycolor text-gray-700 py-1 px-3 rounded transition">
                      <i class="fa-solid fa-plus "></i>
                      <span class="hidden ml-2 md:inline-block">
                        Add Sub-County
                      </span>
                    </button>
                  </div>
                  <div data-nested-form-target="container" class="space-y-4 border-l-2 border-gray-300 pl-4 ml-2">
                    <%= county_fields.fields_for :sub_counties do |sub_county_fields| %>
                      <div class="nested-fields sub-county-fields border border-gray-200 bg-white p-3 rounded-lg">
                        <div class="field border-gray-300 ">
                          <%= sub_county_fields.label :name, "Sub-County Name", class: "block text-gray-700 font-bold text-sm font-medium mb-1" %>
                          <%= sub_county_fields.text_field :name, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
                          <%= sub_county_fields.hidden_field :_destroy %>
                        </div>
                        <button type="button" class="remove-nested mt-2 text-sm  text-red-600 hover:text-red-800 transition">
                          <i class="fa-solid fa-trash mr-1"></i>Remove Sub-County
                        </button>
                      </div>
                    <% end %>
                  </div>
                </div>
                <div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
        <!-- Submit Button -->
        <div class="flex justify-center md:justify-end text-sm items-center mt-12 mb-2">
          <%= link_to "Cancel", :back, class: "bg-gray-200 hover:bg-gray-300 text-gray-700 font-medium py-2 px-4 rounded text-sm transition duration-200 transform hover:scale-105" %>
          <%= f.submit district.persisted? ? "Update" : "Create", class: "ml-2 bg-primarycolor hover:bg-hoverprimarycolor text-white font-bold py-2 px-6 rounded" %>
        </div>
      </div>
    </div>
  </section>
<% end %>
