<%= form_with(model: district) do |f| %>
  <!-- District Name -->
  <div class="mb-6">
    <%= f.label :name, "District Name", class: "block text-gray-700 font-semibold mb-2 text-lg" %>
    <%= f.text_field :name, class: "w-full bg-gray-50 border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-primarycolor" %>
  </div>
  <!-- Counties Section -->
  <h3 class="text-xl font-semibold text-primarytextcolor mb-4">Counties</h3>
  <div data-controller="nested-form" data-association="counties" class="space-y-4">
    <div data-nested-form-target="container" class="space-y-4">
      <!-- Each County -->
      <%= f.fields_for :counties do |county_fields| %>
        <div class="nested-fields county-fields border border-gray-300 rounded-lg bg-gray-50 p-4 space-y-4">
          <div class="field">
            <%= county_fields.label :name, "County Name", class: "block text-gray-700 font-medium mb-1" %>
            <%= county_fields.text_field :name, class: "w-full bg-white border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-primarycolor" %>
            <%= county_fields.hidden_field :_destroy %>
          </div>
          <!-- Sub-Counties -->
          <div class="sub-counties-container border-l-2 border-gray-300 pl-4 ml-2" data-controller="nested-form" data-association="sub_counties">
            <h4 class="text-lg font-medium text-gray-700 mb-2">Sub-Counties</h4>
            <div data-nested-form-target="container" class="space-y-3">
              <%= county_fields.fields_for :sub_counties do |sub_county_fields| %>
                <div class="nested-fields sub-county-fields border border-gray-200 bg-white p-3 rounded-lg">
                  <div class="field">
                    <%= sub_county_fields.label :name, "Sub-County Name", class: "block text-gray-700 font-medium mb-1" %>
                    <%= sub_county_fields.text_field :name, class: "w-full bg-gray-50 border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-primarycolor" %>
                    <%= sub_county_fields.hidden_field :_destroy %>
                  </div>
                  <button type="button" class="remove-nested mt-2 text-sm text-red-600 hover:text-red-800 transition">
                    <i class="fa-solid fa-trash mr-1"></i>Remove Sub-County
                  </button>
                </div>
              <% end %>
            </div>
            <!-- Add Sub-County -->
            <button type="button" data-action="nested-form#addAssociation" class="mt-3 text-sm bg-gray-100 hover:bg-gray-200 text-gray-700 py-1 px-3 rounded transition">
              <i class="fa-solid fa-plus mr-1"></i>Add Sub-County
            </button>
          </div>
          <!-- Remove County -->
          <div>
            <button type="button" class="remove-nested text-sm mt-3 bg-red-100 hover:bg-red-200 text-red-700 py-1 px-3 rounded transition">
              <i class="fa-solid fa-trash mr-1"></i>Remove County
            </button>
          </div>
        </div>
      <% end %>
    </div>
    <!-- Add County Button -->
    <button type="button" data-action="nested-form#addAssociation" data-nested-form-target="addButton" class="w-full md:w-auto bg-primarycolor hover:bg-hoverprimarycolor text-white font-medium py-2 px-4 rounded transition transform hover:scale-105">
      <i class="fa-solid fa-plus mr-2"></i>Add County
    </button>
  </div>
  <!-- Submit -->
  <div class="mt-8">
    <%= f.submit class: "bg-primarycolor hover:bg-hoverprimarycolor text-white font-bold py-2 px-4 rounded transition" %>
  </div>
<% end %>
