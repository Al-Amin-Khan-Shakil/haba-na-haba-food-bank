<!-- app/views/districts/new.html.erb -->
<%= form_with model: @district, local: true, class: "space-y-6" do |f| %>
  <div class="field">
    <%= f.label :name, class: "block text-lg font-medium text-gray-700" %>
    <%= f.text_field :name, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500" %>
  </div>
  <div class="fields space-y-4" id="counties">
    <!-- No initial county fields, these will be added dynamically -->
  </div>
  <%= link_to 'Add County', '#', id: 'add-county', class: 'inline-block bg-indigo-500 text-white px-4 py-2 rounded-md hover:bg-indigo-600' %>
  <%= f.submit 'Create District', class: 'mt-4 inline-block bg-blue-500 text-white px-6 py-3 rounded-md hover:bg-blue-600' %>
<% end %>
