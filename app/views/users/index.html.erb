<div class="sm:p-4 md:p-6 lg:p-8 bg-gray-50">
  <!-- Header with Add New, Title, and Filter/Clear Buttons -->
  <div class="bg-gradient-to-tr from-white from-40% via-primarycolor/50 via-90% to-red-600/40 to-100% shadow-xl rounded-xl p-2 sm:p-3 lg:p-8" data-controller="filter-form">
    <div class="flex justify-between items-end mt-2 mb-4">
      <%= link_to new_user_path, class: "flex items-center gap-2 bg-primarycolor text-white px-1.5 py-1 lg:px-1 rounded hover:bg-hoverprimarycolor" do %>
        <i class="fa-regular fa-plus text-2xl lg:text-base"></i>
        <span class="hidden lg:inline-block">Add New</span>
      <% end %>
      <h2 class="text-xl md:text-2xl lg:text-3xl text-primarytext font-bold text-center">Users</h2>
      <div class="flex justify-end gap-2">
        <button data-filter-form-target="filterButton" data-action="click->filter-form#toggleForm" class="bg-primarycolor text-white py-1 px-2 rounded hover:bg-hoverprimarycolor">
          <i class="fa-solid fa-filter"></i>
          <span class="hidden mr-1 lg:inline-block">Filter</span>
        </button>
        <%= link_to users_path, data: { filter_form_target: "clearButton", action: "click->filter-form#hideForm" }, class: "text-gray-500 py-1 px-2 bg-gray-100 border-gray-100 rounded hover:bg-gray-200" do %>
          <i class="fa-solid fa-arrows-rotate"></i>
          <span class="ml-1 hidden lg:inline-block">Clear</span>
        <% end %>
      </div>
    </div>
    <!-- Filter Form (Initially Hidden) -->
    <div data-filter-form-target="form" class="space-y-4 hidden bg-white/50 my-4 rounded-lg p-4 shadow-md text-gray-600">
      <%= form_with url: users_path, method: :get, local: true, class: "space-y-4" do |form| %>
        <div class="flex flex-wrap gap-4">
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :first_name, "First Name", class: "block text-gray-700" %>
            <%= form.text_field :first_name, value: params[:first_name], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-primarycolor focus:border-primarycolor" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :last_name, "Last Name", class: "block text-gray-700" %>
            <%= form.text_field :last_name, value: params[:last_name], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-primarycolor focus:border-primarycolor" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :phone_number, "Phone ", class: "block text-gray-700" %>
            <%= form.text_field :phone_number, value: params[:phone_number], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-primarycolor focus:border-primarycolor" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :role, "Role", class: "block text-gray-700" %>
            <%= form.select :role, options_for_select(User::ROLES.map { |k| [k.humanize.titleize, k] }, params[:role]), { include_blank: "Select Role" }, class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-primarycolor focus:border-primarycolor" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :branch_id, "Branch", class: "block text-gray-700" %>
            <%= form.collection_select :branch_id, @branches, :id, :name, { prompt: "Select branch", selected: params[:branch_id]  }, { class: 'form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-primarycolor focus:border-primarycolor' } %>
          </div>
        </div>
        <!-- Submit -->
        <div class="mt-4">
          <%= form.submit "Filter", data: { filter_form_target: "submitButton", action: "click->filter-form#hideForm" }, class: "inline-block bg-primarycolor text-white py-1 px-4 rounded hover:bg-hoverprimarycolor" %>
        </div>
      <% end %>
    </div>
    <% if @users.any? %>
      <div class="mt-8 grid md:grid-cols-3 sm:grid-cols-2 grid-cols-1 gap-4">
        <% @users.each do |user| %>
          <div class="relative rounded-lg w-full h-64 bg-gradient-to-r p-5 overflow-hidden shadow-md hover:shadow-lg transition duration-200">
            <!-- Dropdown (Top Left) -->
            <div class="absolute top-2 left-2 z-20">
              <button id="dropdownButton-<%= user.id %>" data-dropdown-toggle="dropdownMenu-<%= user.id %>"
                      class="inline-flex items-center p-2 text-sm font-medium text-gray-500 rounded-lg hover:bg-gray-100 focus:outline-none"
                      type="button">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M6 10a2 2 0 114.001-.001A2 2 0 016 10zm4 0a2 2 0 114.001-.001A2 2 0 0110 10zm4 0a2 2 0 114.001-.001A2 2 0 0114 10z" />
                </svg>
              </button>
              <!-- Dropdown Menu -->
              <div id="dropdownMenu-<%= user.id %>" class="hidden z-30 mt-2 w-28 bg-white divide-y divide-gray-100 rounded-lg shadow dark:bg-gray-700">
                <ul class="py-2 text-sm text-gray-700 dark:text-gray-200" aria-labelledby="dropdownButton-<%= user.id %>">
                  <li>
                    <%= link_to ' Details', user_path(user), class: "text-primarycolor block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white" %>
                  </li>
                  <li>
                    <%= link_to 'Edit', edit_user_path(user), class: "text-primarytext block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white" %>
                  </li>
                  <li>
                    <%= link_to 'Delete', user_path(user), method: :delete, data: { confirm: "Are you sure?" }, class: "block px-4 py-2 text-red-600 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white" %>
                  </li>
                </ul>
              </div>
            </div>
            <!-- Profile Picture (Top Right) -->
            <div class="absolute top-0 right-0 md:w-52 md:h-52 w-44 h-44 rounded-bl-full bg-primarycolor/50 overflow-hidden">
              <% if user.profile_picture.attached? %>
                <%= image_tag user.profile_picture, class: "w-full h-full object-cover rounded-bl-full border-2 border-primarycolor/20" %>
              <% else %>
                <div class="w-full h-full rounded-bl-full bg-gray-100 flex items-center justify-center text-gray-500"></div>
              <% end %>
            </div>
            <!-- User Info (Bottom Left) -->
            <div class="mt-8 absolute bottom-5 left-5">
              <p class="text-gray-800 font-semibold text-sm md:text-base max-w-32">
                <span>  <%= "#{user.first_name} #{user.last_name}" %> </span> <br/>
                <span class="text-sm text-gray-600 capitalize italic"><%= user.role.humanize.titleize %></span>
              </p>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-600 text-center text-lg mt-6 font-medium">📭 No users found.</p>
    <% end %>
  </div>
</div>