<div class="py-8">
  <h1 class="text-3xl font-bold mb-6">Users</h1>
  <div class="mb-4">
    <%= link_to 'New User', new_user_path, class: "bg-blue-500 text-white py-2 px-4 rounded hover:bg-blue-600" %>
  </div>
  <%= form_with url: users_path, method: :get, local: true, class: "space-y-4" do |form| %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= form.label :first_name, "First Name", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :first_name, value: params[:first_name], class: "mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" %>
      </div>
  
      <div>
        <%= form.label :last_name, "Last Name", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :last_name, value: params[:last_name], class: "mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" %>
      </div>
  
      <div>
        <%= form.label :phone_number, "Phone Number", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :phone_number, value: params[:phone_number], class: "mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" %>
      </div>
  
      <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
        <%= form.label :gender, "Gender", class: "block text-gray-700" %>
        <%= form.select :gender,
              options_for_select(User::GENDERS.map { |k| [k.humanize.titleize, k] }, params[:gender]),
              { include_blank: "Select" },
              class: "form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
      </div>
  
      <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
        <%= form.label :role, "Role", class: "block text-gray-700" %>
        <%= form.select :role,
              options_for_select(User::ROLES.map { |k| [k.humanize.titleize, k] }, params[:role]),
              { include_blank: "Select" },
              class: "form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-lightGreen focus:border-lightGreen" %>
      </div>
    </div>
  
    <div>
      <%= form.submit "Filter", class: "bg-blue-600 text-white px-2 py-1 rounded-lg my-4" %>
      <%= link_to "Reset", users_path, class: "bg-blue-600 text-white px-2 py-2 rounded-lg my-4" %>
      <%= "#{@users.size} Results" %>
    </div>
  <% end %>
  

  <% if @users.any? %>
    <table class="min-w-full bg-white border border-gray-300 rounded-md overflow-hidden shadow">
      <thead class="bg-gray-100 border-b">
        <tr>
          <th class="px-4 py-2 text-gray-600 font-bold">Profile</th>
          <th class="text-left px-4 py-2 text-gray-600 font-bold">Name</th>
          <th class="text-left px-4 py-2 text-gray-600 font-bold">Email</th>
          <th class="text-left px-4 py-2 text-gray-600 font-bold">Phone</th>
          <th class="text-left px-4 py-2 text-gray-600 font-bold">Role</th>
          <th class="text-left px-4 py-2 text-gray-600 font-bold">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr class="border-b hover:bg-gray-50">
            <td class="px-4 py-2">
              <% if user.profile_picture.attached? %>
                <%= image user.profile_picture, class: "rounded-full w-12 h-12 object-cover" %>
              <% else %>
                <div class="rounded-full w-12 h-12 bg-gray-200 flex items-center justify-center text-gray-500">
                  <i class="fa-solid fa-user"></i>
                </div>
              <% end %>
            </td>
            <td class="px-4 py-2"><%= "#{user.first_name} #{user.last_name}" %></td>
            <td class="px-4 py-2"><%= user.email %></td>
            <td class="px-4 py-2"><%= user.phone_number %></td>
            <td class="px-4 py-2 capitalize"><%= user.role %></td>
            <td class="px-4 py-2">
              <div class="flex space-x-2">
                <%= link_to 'View', user_path(user), class: "text-blue-500 hover:underline" %>
                <%= link_to 'Edit', edit_user_path(user), class: "text-yellow-500 hover:underline" %>
                <%= link_to 'Delete', user_path(user), method: :delete, data: { confirm: "Are you sure?" }, class: "text-red-500 hover:underline" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= button_to 'Sign Out', destroy_user_session_path, method: :delete, class: 'bg-red-500 text-white py-2 px-4 rounded hover:bg-red-600' %>
  <% else %>
    <p class="text-gray-600">No users found.</p>
  <% end %>
</div>
