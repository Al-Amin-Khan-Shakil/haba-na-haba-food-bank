<div class="sm:p-8 md:p-10 lg:p-12 min-h-[100dvh] bg-gray-50">
  <!-- Header -->
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-4xl font-extrabold text-gray-800 tracking-tight">Users</h1>
    <button class="bg-primarycolor text-white py-2.5 px-6 rounded-lg font-semibold hover:bg-primarycolor/90 transition duration-200 flex items-center gap-2">
      <%= link_to 'New', new_user_path, class: "text-white no-underline" %>
      <span class="hidden sm:inline-block">User</span>
    </button>
  </div>
  <div class="bg-gradient-to-br from-white via-primarycolor/10 to-red-600/10 transition duration-300 hover:shadow-2xl md:p-10 p-6 rounded-3xl shadow-xl border border-gray-100">
    <!-- Filter Form -->
    <div class="mb-6">
      <h2 class="text-xl font-semibold text-gray-800 flex items-center gap-2">
        <i class="fa-solid fa-filter text-primarycolor"></i> Filter Users
      </h2>
    </div>
    <%= form_with url: users_path, method: :get, local: true, class: "space-y-8" do |form| %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6 bg-white/80 backdrop-blur-sm border border-gray-200 rounded-xl p-6">
        <div class="w-full">
          <%= form.label :first_name, "First Name", class: "block text-sm font-semibold text-gray-700 mb-1" %>
          <%= form.text_field :first_name, value: params[:first_name], class: "bg-white border border-gray-200 rounded-lg p-3 w-full focus:outline-none focus:ring-2 focus:ring-primarycolor focus:border-transparent shadow-sm transition duration-150" %>
        </div>
        <div class="w-full">
          <%= form.label :last_name, "Last Name", class: "block text-sm font-semibold text-gray-700 mb-1" %>
          <%= form.text_field :last_name, value: params[:last_name], class: "bg-white border border-gray-200 rounded-lg p-3 w-full focus:outline-none focus:ring-2 focus:ring-primarycolor focus:border-transparent shadow-sm transition duration-150" %>
        </div>
        <div class="w-full">
          <%= form.label :phone_number, "Phone Number", class: "block text-sm font-semibold text-gray-700 mb-1" %>
          <%= form.text_field :phone_number, value: params[:phone_number], class: "bg-white border border-gray-200 rounded-lg p-3 w-full focus:outline-none focus:ring-2 focus:ring-primarycolor focus:border-transparent shadow-sm transition duration-150" %>
        </div>
        <div class="w-full">
          <%= form.label :gender, "Gender", class: "block text-sm font-semibold text-gray-700 mb-1" %>
          <%= form.select :gender,
            options_for_select(IndividualBeneficiary.genders.keys.map { |k| [k.humanize.titleize, k] }, params[:gender]),
            { include_blank: "Select" },
            class: "bg-white border border-gray-200 rounded-lg p-3 w-full focus:outline-none focus:ring-2 focus:ring-primarycolor focus:border-transparent shadow-sm transition duration-150" %>
        </div>
        <div class="w-full">
          <%= form.label :role, "Role", class: "block text-sm font-semibold text-gray-700 mb-1" %>
          <%= form.select :role,
            options_for_select(User::ROLES.map { |k| [k.humanize.titleize, k] }, params[:role]),
            { include_blank: "Select" },
            class: "bg-white border border-gray-200 rounded-lg p-3 w-full focus:outline-none focus:ring-2 focus:ring-primarycolor focus:border-transparent shadow-sm transition duration-150" %>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-4 mt-6">
        <%= form.submit "Filter", class: "bg-primarycolor text-white px-8 py-2.5 rounded-lg font-semibold hover:bg-primarycolor/90 transition duration-200 flex items-center gap-2" do %>
          <i class="fa-solid fa-magnifying-glass"></i>
          <span>Filter</span>
        <% end %>
        <%= link_to "Reset", users_path, class: "bg-gray-100 border border-primarycolor text-primarycolor px-6 py-2.5 rounded-lg font-semibold hover:bg-primarycolor/10 transition duration-200" %>
        <span class="text-sm text-gray-600 font-medium"><%= "#{@users.size} Results" %></span>
      </div>
    <% end %>
    <!-- User Table -->
    <% if @users.any? %>
      <div class="mt-8">
        <!-- Table for larger screens -->
        <div class="hidden sm:block overflow-x-auto rounded-xl border border-gray-200 shadow-lg">
          <table class="min-w-full bg-white rounded-xl">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-4 text-left text-gray-700 font-semibold tracking-wide">Profile</th>
                <th class="px-6 py-4 text-left text-gray-700 font-semibold tracking-wide">Name</th>
                <th class="px-6 py-4 text-left text-gray-700 font-semibold tracking-wide">Email</th>
                <th class="px-6 py-4 text-left text-gray-700 font-semibold tracking-wide">Phone</th>
                <th class="px-6 py-4 text-left text-gray-700 font-semibold tracking-wide">Role</th>
                <th class="px-6 py-4 text-left text-gray-700 font-semibold tracking-wide">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @users.each do |user| %>
                <tr class="border-t hover:bg-gray-50 transition duration-150">
                  <td class="px-6 py-4">
                    <% if user.profile_picture.attached? %>
                      <%= image_tag user.profile_picture, class: "rounded-full w-12 h-12 object-cover border-2 border-primarycolor/20" %>
                    <% else %>
                      <div class="rounded-full w-12 h-12 bg-gray-100 flex items-center justify-center text-gray-500">
                        <i class="fa-solid fa-user text-lg"></i>
                      </div>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 text-gray-800 font-medium"><%= "#{user.first_name} #{user.last_name}" %></td>
                  <td class="px-6 py-4 text-gray-600"><%= user.email %></td>
                  <td class="px-6 py-4 text-gray-600"><%= user.phone_number %></td>
                  <td class="px-6 py-4 capitalize text-gray-600"><%= user.role %></td>
                  <td class="px-6 py-4">
                    <div class="flex space-x-4">
                      <%= link_to 'View', user_path(user), class: "text-blue-600 hover:text-blue-800 font-medium transition duration-150" %>
                      <%= link_to 'Edit', edit_user_path(user), class: "text-yellow-600 hover:text-yellow-800 font-medium transition duration-150" %>
                      <%= link_to 'Delete', user_path(user), method: :delete, data: { confirm: "Are you sure?" }, class: "text-red-600 hover:text-red-800 font-medium transition duration-150" %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <!-- Card layout for mobile -->
        <div class="sm:hidden space-y-4">
          <% @users.each do |user| %>
            <div class="bg-white border border-gray-200 rounded-xl p-4 shadow-md hover:shadow-lg transition duration-200">
              <div class="flex items-center space-x-4">
                <div>
                  <% if user.profile_picture.attached? %>
                    <%= image_tag user.profile_picture, class: "rounded-full w-10 h-10 object-cover border-2 border-primarycolor/20" %>
                  <% else %>
                    <div class="rounded-full w-10 h-10 bg-gray-100 flex items-center justify-center text-gray-500">
                      <i class="fa-solid fa-user text-base"></i>
                    </div>
                  <% end %>
                </div>
                <div class="flex-1">
                  <p class="text-gray-800 font-semibold"><%= "#{user.first_name} #{user.last_name}" %></p>
                  <p class="text-sm text-gray-600"><%= user.email %></p>
                </div>
              </div>
              <div class="mt-3 space-y-2">
                <p class="text-sm text-gray-600"><span class="font-medium">Phone:</span> <%= user.phone_number %></p>
                <p class="text-sm text-gray-600 capitalize"><span class="font-medium">Role:</span> <%= user.role %></p>
                <div class="flex space-x-3 pt-2">
                  <%= link_to 'View', user_path(user), class: "text-blue-600 hover:text-blue-800 text-sm font-medium" %>
                  <%= link_to 'Edit', edit_user_path(user), class: "text-yellow-600 hover:text-yellow-800 text-sm font-medium" %>
                  <%= link_to 'Delete', user_path(user), method: :delete, data: { confirm: "Are you sure?" }, class: "text-red-600 hover:text-red-800 text-sm font-medium" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
      <div class="mt-8">
        <%= button_to 'Sign Out', destroy_user_session_path, method: :delete, class: 'bg-red-600 text-white py-2.5 px-6 rounded-lg font-semibold hover:bg-red-700 transition duration-200' %>
      </div>
    <% else %>
      <p class="text-gray-600 text-center text-lg mt-6 font-medium">📭 No users found.</p>
    <% end %>
  </div>
</div>
