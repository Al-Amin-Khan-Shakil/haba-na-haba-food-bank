<%= form_with model: @user, local: true, data: { turbo: false } do |f| %>
  <section class="custom-select md:p-10 sm:px-6 lg:px-8 py-8 sm:text-sm md:text-base lg:text-lg">
    <div class="bg-gradient-to-tr from-white from-40% via-primarycolor/50 via-90% to-red-600/40 to-100% transition duration-300 hover:shadow-xl md:p-12 p-4 rounded-lg shadow-lg">
      <div class=" flex justify-between items-center h-auto gap-4 my-4">
        <button onclick="history.go(-1)" class="border rounded-lg flex items-center text-sm sm:text-base bg-gray-50 px-5 py-2  transition duration-300 ease-in-out">
          <i class="fa-solid fa-arrow-left"></i>
          <span class="ml-2 hidden lg:inline-block ">Back</span>
        </button>
        <h2 class="text-lg lg:text-3xl text-primarytext font-bold text-center leading-tight">
          <span>
            <%= @user&.persisted? ? "Edit" : "Create" %>
          </span>
          <span class= "hidden md:inline-block">
            User
          </span>
        </h2>
      </div>
      <div class="bg-white md:p-8 p-4 border rounded-lg">
        <% if @user.errors.any? %>
          <div class="mb-6 p-4 bg-red-100 text-red-700 rounded-lg border border-red-200">
            <h2 class="font-bold text-lg mb-2">Please fix the following errors:</h2>
            <ul class="list-disc pl-5">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <% if notice %>
          <div class="mb-6 p-4 bg-green-100 text-green-700 rounded-lg border border-green-200"><%= notice %></div>
        <% end %>
        <% if alert %>
          <div class="mb-6 p-4 bg-yellow-100 text-yellow-700 rounded-lg border border-yellow-200"><%= alert %></div>
        <% end %>
        <h3 class="text-xl my-4 font-semibold text-primarytextcolor mb-3 hover:text-gray-900 transition duration-200 underline">Basic Information</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="mb-4">
            <%= f.label :first_name, "First Name", class: "block text-gray-700 font-bold mb-2" %>
            <%= f.text_field :first_name, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
          </div>
          <div class="mb-4">
            <%= f.label :last_name, "Last Name", class: "block text-gray-700 font-bold mb-2" %>
            <%= f.text_field :last_name, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
          </div>
          <div class="mb-4">
            <%= f.label :email, "Email", class: "block text-gray-700 font-bold mb-2" %>
            <%= f.email_field :email, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
          </div>
          <div class="mb-4">
            <%= f.label :phone_number, "Phone Number", class: "block text-gray-700 font-bold mb-2" %>
            <%= f.text_field :phone_number, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
          </div>
          <div class="mb-4">
            <%= f.label :gender, "Gender", class: "block text-gray-700 font-bold mb-2" %>
            <%= f.select :gender, User::GENDERS, { include_blank: "Select Gender" }, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
          </div>
          <div class="mb-4">
            <%= f.label :role, "Role", class: "block text-gray-700 font-bold mb-2" %>
            <%= f.select :role, User::ROLES, { include_blank: "Select Role" }, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
          </div>
        </div>
        <h3 class="text-xl my-4 font-semibold text-primarytextcolor mb-3 hover:text-gray-900 transition duration-200 underline">Profile Details</h3>
        <div class="grid grid-cols-1 gap-4">
          <div class="mb-4">
            <%= f.label :address, "Address", class: "block text-gray-700 font-bold mb-2" %>
            <%= f.text_area :address, rows: 3, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
          </div>
          <div class="mb-4">
            <%= f.label :profile_picture, "Profile Picture", class: "block text-gray-700 font-bold mb-2" %>
            <%= f.file_field :profile_picture, class: "block w-full text-sm text-gray-500
              file:mr-4 file:py-2 file:px-4
              file:rounded-lg file:border-0
              file:text-sm file:font-semibold
              file:bg-primarycolor file:text-white
              hover:file:bg-hoverprimarycolor" %>
          </div>
        </div>
        <% unless @user.persisted? %>
          <h3 class="text-xl my-4 font-semibold text-primarytextcolor mb-3 hover:text-gray-900 transition duration-200 underline">Account Security</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="mb-4">
              <%= f.label :password, "Password", class: "block text-gray-700 font-bold mb-2" %>
              <%= f.password_field :password, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
            </div>
            <div class="mb-4">
              <%= f.label :password_confirmation, "Password Confirmation", class: "block text-gray-700 font-bold mb-2" %>
              <%= f.password_field :password_confirmation, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
            </div>
          </div>
        <% end %>
        <div class="flex justify-center md:justify-end text-sm items-center mt-6">
          <%= link_to "Cancel", :back, class: "bg-gray-200 hover:bg-gray-300 text-gray-700 font-medium py-2 px-4 rounded text-sm transition duration-200 transform hover:scale-105" %>
          <%= f.submit @user.persisted? ? "Update User" : "Create User", class: "ml-2 bg-primarycolor hover:bg-hoverprimarycolor text-white font-bold py-2 px-4 rounded" %>
        </div>
      </div>
    </div>

  </section>
<% end %>
  <% end %>
  <p class="notice"><%= notice %></p>
  <p class="alert"><%= alert %></p>
  <div class="mb-4">
    <%= f.label :first_name, "First Name", class: "block font-bold mb-2" %>
    <%= f.text_field :first_name, class: "w-full p-2 border rounded" %>
  </div>
  <div class="mb-4">
    <%= f.label :last_name, "Last Name", class: "block font-bold mb-2" %>
    <%= f.text_field :last_name, class: "w-full p-2 border rounded" %>
  </div>
  <div class="mb-4">
    <%= f.label :email, "Email", class: "block font-bold mb-2" %>
    <%= f.email_field :email, class: "w-full p-2 border rounded" %>
  </div>
  <div class="mb-4">
    <%= f.label :phone_number, "Phone Number", class: "block font-bold mb-2" %>
    <%= f.text_field :phone_number, class: "w-full p-2 border rounded" %>
  </div>
  <div class="mb-4">
    <%= f.label :role, "Role", class: "block font-bold mb-2" %>
    <%= f.select :role, User::ROLES, {}, class: "w-full p-2 border rounded" %>
  </div>
  <div class="mb-4">
    <%= f.label :gender, "Gender", class: "block font-bold mb-2" %>
    <%= f.select :gender, User.genders, {}, class: "w-full p-2 border rounded" %>
  </div>
  <div class="mb-4">
    <%= f.label :address, "Address", class: "block font-bold mb-2" %>
    <%= f.text_area :address, class: "w-full p-2 border rounded", rows: 3 %>
  </div>
  <div class="mb-4">
    <%= f.label :profile_picture, "Profile Picture", class: "block font-bold mb-2" %>
    <%= f.file_field :profile_picture, class: "w-full p-2 border rounded" %>
  </div>
  <div class="mb-4">
    <%= f.label :password, "Password", class: "block font-bold mb-2" %>
    <%= f.password_field :password, class: "w-full p-2 border rounded" %>
  </div>
  <div class="mb-4">
    <%= f.label :password_confirmation, "Password Confirmation", class: "block font-bold mb-2" %>
    <%= f.password_field :password_confirmation, class: "w-full p-2 border rounded" %>
  </div>
  <div class="mt-6">
    <%= f.submit class: "bg-blue-500 text-white font-bold py-2 px-4 rounded hover:bg-blue-600" %>
  </div>
<% end %>
