<div class="sm:p-4 md:p-6 lg:p-8 bg-gray-50 ">
  <div class="relative w-full bg-white/90 backdrop-blur-sm rounded-2xl flex flex-col items-center font-sans shadow-2xl overflow-hidden border border-white/20 transition-all duration-300 hover:shadow-3xl">
    <div class="h-[180px] md:h-[220px] w-full bg-gradient-to-tr from-white via-primarycolor/70 via-45% to-red-500/50 to-100% rounded-t-lg flex items-center justify-center relative overflow-hidden group">
      <div class="absolute inset-0 bg-[length:400%_400%] animate-gradient-shift opacity-70 group-hover:opacity-90 transition-opacity duration-500" 
           style="background-image: linear-gradient(45deg, rgba(255,255,255,0.3) 0%, rgba(209,213,219,0.1) 25%, rgba(220,38,38,0.2) 50%, rgba(99,102,241,0.3) 75%, rgba(255,255,255,0.3) 100%);">
      </div>
      <div class="absolute top-1/4 left-1/4 w-12 h-12 md:w-16 md:h-16 rounded-full bg-white/20 backdrop-blur-sm animate-float-1"></div>
      <div class="absolute bottom-1/4 right-1/4 w-14 h-14 md:w-20 md:h-20 rounded-full bg-red-400/15 backdrop-blur-sm animate-float-2"></div>
    </div>
    <div class="flex  items-end space-x-6 md:-mt-12 -mt-8 px-6 w-full relative">
      <div class="z-20 rounded-full bg-white shadow-xl flex border-4 border-white ring-4 ring-primarycolor/30 transition-all duration-500 hover:scale-105 hover:shadow-2xl hover:ring-primarycolor/50">
        <% if @user.profile_picture.attached? %>
          <%= image_tag @user.profile_picture, class: "w-24 h-24 md:w-32 md:h-32 object-cover rounded-full" %>
        <% else %>
          <div class="rounded-full text-gray-400 text-3xl md:text-5xl w-24 h-24 md:w-32 md:h-32 flex items-center justify-center bg-gradient-to-br from-gray-100 to-gray-200">
            <i class="fa-solid fa-user"></i>
          </div>
        <% end %>
      </div>
      <div class="z-10 py-2 md:py-4 rounded-2xl md:absolute md:top-10 md:left-40  left-28  mt-2 md:mt-0 text-left">
        <h2 class="text-xl md:text-2xl font-bold text-gray-800 tracking-tight drop-shadow-sm"><%= "#{@user.first_name} #{@user.last_name}" %></h2>
        <p class="border border-primarycolor mt-1 text-xs md:text-sm font-semibold text-primarytext capitalize tracking-wide bg-primarycolor/10 px-3 py-1 rounded-full inline-block">
          <%= @user.role.titleize %>
        </p>
      </div>
    </div>
    <div class="mt-4 md:mt-6 w-full px-4 md:px-6 space-y-2 md:space-y-2.5">
      <div class="flex flex-col md:flex-row md:justify-between border items-start py-2 md:py-3 px-3 md:px-4 rounded-xl bg-gray-50/80 hover:bg-gray-100/60 transition-colors duration-200">
        <span class="font-medium text-gray-600/90 flex items-center text-sm md:text-base">
          <i class="fas fa-envelope mr-2 md:mr-3 text-primarycolor/70 text-sm md:text-base"></i> Email
        </span>
        <span class="text-center font-medium text-gray-800  text-sm md:text-base">
          <%= @user.email %>
        </span>
      </div>
      <div class="flex flex-col md:flex-row md:justify-between border items-start py-2 md:py-3 px-3 md:px-4 rounded-xl bg-gray-50/80 hover:bg-gray-100/60 transition-colors duration-200">
        <span class="font-medium text-gray-600/90 flex items-center text-sm md:text-base">
          <i class="fas fa-phone mr-2 md:mr-3 text-primarycolor/70 text-sm md:text-base"></i> Phone
        </span>
        <span class="text-center font-medium text-gray-800 text-sm md:text-base">
          <%= @user.phone_number %>
        </span>
      </div>
      <div class="flex justify-between md:flex-row md:justify-between border items-start py-2 md:py-3 px-3 md:px-4 rounded-xl bg-gray-50/80 hover:bg-gray-100/60 transition-colors duration-200">
        <span class="font-medium text-gray-600/90 flex items-center text-sm md:text-base">
          <i class="fas fa-venus-mars mr-2 md:mr-3 text-primarycolor/70 text-sm md:text-base"></i> Gender
        </span>
        <span class="text-right font-medium text-gray-800 capitalize text-sm md:text-base">
          <%= @user.gender %>
        </span>
      </div>
      <div class="flex flex-col border md:flex-row md:justify-between items-start py-2 md:py-3 px-3 md:px-4 rounded-xl bg-gray-50/80 hover:bg-gray-100/60 transition-colors duration-200">
        <span class="font-medium text-gray-600/90 flex items-center text-sm md:text-base">
          <i class="fas fa-map-marker-alt mr-2 md:mr-3 text-primarycolor/70 text-sm md:text-base"></i> Address
        </span>
        <span class="text-right font-medium text-gray-800 truncate max-w-[50%] md:max-w-[55%] text-sm md:text-base">
          <%= @user.address %>
        </span>
      </div>
    </div>
    <div class="mt-6 mb-6 flex flex-col  md:flex-row justify-end space-y-4 md:space-y-0 space-y-reverse md:space-x-4 px-4 md:px-6 w-full gap-2 md:gap-0">
      <%= link_to 'Edit Profile', edit_user_path(@user), class: "flex justify-center items-center px-4  py-2 bg-primarytext  text-xs md:text-sm font-semibold uppercase tracking-wide rounded-lg border border-gray-300/80 text-white hover:bg-sky-50 hover:text-primarytext transition-all duration-300 shadow-sm hover:shadow-md" %>
      <%= link_to 'Back', users_path, class: "flex justify-center  items-center px-4 py-2  text-xs md:text-sm font-semibold uppercase tracking-wide rounded-lg bg-gradient-to-r from-primarycolor to-primarycolor/90 hover:bg-white hover:text-primarytext transition-all duration-300 shadow-md hover:shadow-lg text-white" %>
    </div>
  </div>
</div>