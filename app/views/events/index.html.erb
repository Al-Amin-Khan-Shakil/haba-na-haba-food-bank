<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold mb-6">Events</h1>
  <%= link_to 'New Event', new_event_path, class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 mb-6 inline-block" %>
   <div class="filter-form bg-white p-6 rounded-lg shadow-md my-5">
  <%= form_with url: events_path, method: :get, local: true, class: "space-y-6", data: { controller: "filter", action: "submit->filter#handleFilterSubmit" } do |form| %>
    <h3 class="text-lg font-semibold text-gray-800 mb-4">Filter Events</h3>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Basic Information -->
      <div class="space-y-2">
        <%= form.label :title, "Title", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :title, value: params[:title], class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-lightGreen focus:ring focus:ring-lightGreen focus:ring-opacity-50" %>
      </div>
      
      <div class="space-y-2">
        <%= form.label :description, "Description", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :description, value: params[:description], class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-lightGreen focus:ring focus:ring-lightGreen focus:ring-opacity-50" %>
      </div>      
      <!-- Location Information -->
      <div class="space-y-2">
        <%= form.label :district_id, "District", class: "block text-sm font-medium text-gray-700" %>
        <%= form.collection_select :district_id, @districts, :id, :name, { prompt: "Select District" }, { class: 'district-select mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-lightGreen focus:ring focus:ring-lightGreen focus:ring-opacity-50', 'data-context-path': "individual_beneficiaries" } %>
      </div>
      
      <div class="space-y-2">
        <%= form.label :county_id, "County", class: "block text-sm font-medium text-gray-700" %>
        <%= form.collection_select :county_id, @counties, :id, :name, { prompt: "Select County" }, { class: 'county-select mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-lightGreen focus:ring focus:ring-lightGreen focus:ring-opacity-50', 'data-context-path': "individual_beneficiaries" } %>
      </div>
      
      <div class="space-y-2">
        <%= form.label :sub_county_id, "Sub-County", class: "block text-sm font-medium text-gray-700" %>
        <%= form.collection_select :sub_county_id, @sub_counties, :id, :name, { prompt: "Select Sub-County" }, { class: 'sub-county-select mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-lightGreen focus:ring focus:ring-lightGreen focus:ring-opacity-50' } %>
      </div>
      
      
      <div class="space-y-2">
        <%= form.label :start_date, "Start Date", class: "block text-sm font-medium text-gray-700" %>
        <%= form.date_field :start_date, value: params[:start_date], class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-lightGreen focus:ring focus:ring-lightGreen focus:ring-opacity-50" %>
      </div>
      
      <div class="space-y-2">
        <%= form.label :end_date, "End Date", class: "block text-sm font-medium text-gray-700" %>
        <%= form.date_field :end_date, value: params[:end_date], class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-lightGreen focus:ring focus:ring-lightGreen focus:ring-opacity-50" %>
      </div>
    </div>
    
    <!-- Action Buttons -->
    <div class="flex justify-end space-x-3 pt-4">
      <%= link_to "Reset", events_path, class: "px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-lightGreen" %>
      <%= form.submit "Filter", class: "px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-lightGreen hover:bg-green-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-lightGreen" %>
    </div>
  <% end %>
</div>
  
  <div class="overflow-x-auto">
    <table class="min-w-full bg-white rounded-lg overflow-hidden">
      <thead class="bg-gray-100">
        <tr>
          <th class="py-3 px-4 text-left">Title</th>
          <th class="py-3 px-4 text-left">Location</th>
          <th class="py-3 px-4 text-left">Date</th>
          <th class="py-3 px-4 text-left">Participants</th>
          <th class="py-3 px-4 text-left">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @events.each do |event| %>
          <tr class="border-t border-gray-200 hover:bg-gray-50">
            <td class="py-3 px-4"><%= event.title %></td>
            <td class="py-3 px-4">
              <%= [event.district.name, event.county.name, event.sub_county.name].join(', ') %>
            </td>
            <td class="py-3 px-4">
              <%= event.start_date.to_formatted_s(:short) %> -
              <%= event.end_date.to_formatted_s(:short) %>
            </td>
            <td class="py-3 px-4"><%= event.event_users.count %></td>
            <td class="py-3 px-4 flex space-x-2">
              <%= link_to 'Show', event, class: "text-blue-600 hover:text-blue-800" %>
              <%= link_to 'Edit', edit_event_path(event), class: "text-yellow-600 hover:text-yellow-800" %>
              <%= button_to 'Delete', event, method: :delete, data: { confirm: 'Are you sure?' }, class: "text-red-600 hover:text-red-800" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>