<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold mb-6">Events</h1>
  <%= link_to 'New Event', new_event_path, class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 mb-6 inline-block" %>
  <div class="overflow-x-auto">
    <table class="min-w-full bg-white rounded-lg overflow-hidden">
      <thead class="bg-gray-100">
        <tr>
          <th class="py-3 px-4 text-left">Title</th>
          <th class="py-3 px-4 text-left">Location</th>
          <th class="py-3 px-4 text-left">Date</th>
          <th class="py-3 px-4 text-left">Participants</th>
          <th class="py-3 px-4 text-left">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @events.each do |event| %>
          <tr class="border-t border-gray-200 hover:bg-gray-50">
            <td class="py-3 px-4"><%= event.title %></td>
            <td class="py-3 px-4">
              <%= [event.district.name, event.county.name, event.sub_county.name].join(', ') %>
            </td>
            <td class="py-3 px-4">
              <%= event.start_date.to_formatted_s(:short) %> -
              <%= event.end_date.to_formatted_s(:short) %>
            </td>
            <td class="py-3 px-4"><%= event.event_users.count %></td>
            <td class="py-3 px-4 flex space-x-2">
              <%= link_to 'Show', event, class: "text-blue-600 hover:text-blue-800" %>
              <%= link_to 'Edit', edit_event_path(event), class: "text-yellow-600 hover:text-yellow-800" %>
              <%= button_to 'Delete', event, method: :delete, data: { confirm: 'Are you sure?' }, class: "text-red-600 hover:text-red-800" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>