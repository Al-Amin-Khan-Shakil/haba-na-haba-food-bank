<div class="sm:p-4 md:p-6 lg:p-8 bg-gray-50">
  <div class="bg-gradient-to-tr from-white from-40% via-primarycolor/50 via-90% to-red-600/40 to-100% shadow-xl rounded-xl p-2 sm:p-3 lg:p-8" data-controller="filter-form">
    <div class="flex justify-between items-end mt-2 mb-4">
      <%= link_to new_event_path, class: "flex items-center gap-2 bg-primarycolor text-white px-1.5 py-1 lg:px-1 rounded hover:bg-hoverprimarycolor" do %>
        <i class="fa-regular fa-plus text-2xl lg:text-base"></i>
        <span class="hidden lg:inline-block">Add New</span>
      <% end %>
      <h2 class="text-2xl md:text-3xl lg:text-4xl text-primarytext font-bold text-center">Events</h2>
      <div class="flex justify-end gap-2">
        <button data-filter-form-target="filterButton" data-action="click->filter-form#toggleForm" class="bg-primarycolor text-white py-1 px-2 rounded hover:bg-hoverprimarycolor">
          <i class="fa-solid fa-filter"></i>
          <span class="hidden mr-1 lg:inline-block">Filter</span>
        </button>
        <%= link_to events_path, data: { filter_form_target: "clearButton", action: "click->filter-form#hideForm" }, class: "cursor-pointer text-gray-500 py-1 px-2 bg-gray-100 border-gray-100 rounded hover:bg-gray-200" do %>
          <i class="fa-solid fa-arrows-rotate"></i> <span class="ml-1 hidden lg:inline-block">Clear</span>
        <% end %>
      </div>
    </div>
    <div data-filter-form-target="form" class="space-y-4 hidden bg-white/50 my-4 rounded-lg p-4 shadow-md text-gray-600">
      <%= form_with url: events_path, method: :get, local: true, class: "space-y-4",
            data: {
      controller: "location", 
      location_base_path_value: "events",
      location_context_path_value: events_path
    } do |form| %>
        <div class="flex flex-wrap gap-4">
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :title, "Title", class: "block text-gray-700" %>
            <%= form.text_field :title, value: params[:title], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-primarycolor focus:border-primarycolor" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :district_id, "District", class: "block text-gray-700" %>
            <%= form.collection_select :district_id, @districts, :id, :name, { prompt: "Select District",selected: params[:district_id]  }, { class: 'district-select form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-primarycolor focus:border-primarycolor', 'data-context-path': "individual_beneficiaries",
            data: {
                        location_target: "district",
                        action: "change->location#loadCounties"
                      } } %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :county_id, "County", class: "block text-gray-700" %>
            <%= form.collection_select :county_id, @counties, :id, :name, { prompt: "Select County", selected: params[:county_id] }, { class: 'county-select form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-primarycolor focus:border-primarycolor', 'data-context-path': "individual_beneficiaries",
             data: {
                        location_target: "county",
                        action: "change->location#loadSubCounties",
                        initial_selection: @request&.county_id
                      } } %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :sub_county_id, "Sub-County", class: "block text-gray-700" %>
            <%= form.collection_select :sub_county_id, @sub_counties, :id, :name, { prompt: "Select Sub-County", selected: params[:sub_county_id] }, { class: 'sub-county-select form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-1 focus:ring-primarycolor focus:border-primarycolor',
             data: {
                        location_target: "subCounty",
                        initial_selection: @request&.sub_county_id
                      } } %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :start_date, "Start Date", class: "block text-gray-700" %>
            <%= form.date_field :start_date, value: params[:start_date], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-primarycolor focus:border-primarycolor" %>
          </div>
          <div class="w-1/3 md:w-1/4 lg:w-1/6 flex-grow">
            <%= form.label :end_date, "End Date", class: "block text-gray-700" %>
            <%= form.date_field :end_date, value: params[:end_date], class: "mt-1 block w-full border border-gray-300 rounded focus:ring-1 focus:ring-primarycolor focus:border-primarycolor" %>
          </div>
        </div>
        <div class="mt-4">
          <%= form.submit "Filter", data: { filter_form_target: "submitButton", action: "click->filter-form#hideForm" }, class: "inline-block bg-primarycolor text-white py-1 px-4 rounded hover:bg-hoverprimarycolor" %>
        </div>
      <% end %>
    </div>
    <div class="overflow-x-auto rounded-lg">
      <table class="min-w-full max-h-fit bg-white/80 shadow-md rounded-lg border-x border-gray-100 data-table">
        <thead>
          <tr class="text-primarytext bg-sky-50">
            <th class="px-6 py-3 text-left font-Outfit text-base font-bold tracking-wider w-2/5">Title</th>
            <th class="px-6 py-3 text-left font-Outfit text-base font-bold tracking-wider w-2/5">Period</th>
            <th class="px-6 py-3 text-center font-Outfit text-base font-bold tracking-wider w-1/5">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @events.each do |event| %>
            <tr class="hover:bg-gray-100 border-b border-b-gray-100">
              <td class="px-6 py-4 text-sm font-semibold font-Outfit text-[#5a607a] w-2/5"><%= event&.title %></td>
              <td class="px-6 py-4 text-sm font-semibold font-Outfit text-[#5a607a] w-2/5">
                <%= event&.start_date&.strftime('%B %d, %Y') %> - <%= event&.end_date&.strftime('%B %d, %Y') %>
              </td>
              <td class="px-6 py-3 text-center text-sm font-Outfit text-[#5a607a] w-1/5">
                <div class="relative">
                  <button data-dropdown-toggle="dropdown-<%= event.id %>" class="text-gray-600 focus:outline-none focus:ring-2 focus:ring-gray-300 border border-primarycolor rounded" type="button">
                    <div class="p-1 flex flex-row justify-center items-center  space-between">
                      <span class="hidden md:block lg:block mr-1" >Actions</span>
                      <i class="fa-solid fa-chevron-down"></i>
                    </div>
                  </button>
                  <div id="dropdown-<%= event.id %>" class="cursor-pointer absolute right-0 mt-2 w-36 bg-white border rounded-lg shadow-lg z-10 hidden overflow-hidden font-Outfit font-semibold text-left">
                    <%= link_to 'Details', event_path(event), class: 'block px-4 py-2 text-primarycolor hover:bg-gray-100' %>
                    <%= link_to 'Edit', edit_event_path(event), class: 'block px-4 py-2 text-primarytext hover:bg-gray-100' %>
                    <%= button_to 'Delete', event_path(event), method: :delete, data: { confirm: 'Are you sure?' }, class: 'cursor-pointer block px-4 py-2 text-red-600 hover:bg-gray-100 text-left' %>
                  </div>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>