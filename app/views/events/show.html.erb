<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold"><%= @event.title %></h1>
    <div class="flex space-x-2">
      <%= link_to 'Edit', edit_event_path(@event), class: "bg-yellow-500 text-white px-4 py-2 rounded hover:bg-yellow-600" %>
      <%= link_to 'Back', events_path, class: "bg-gray-500 text-white px-4 py-2 rounded hover:bg-gray-600" %>
    </div>
  </div>
  <div class="bg-white rounded-lg shadow-md p-6 mb-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <h2 class="text-xl font-semibold mb-4">Event Details</h2>
        <div class="space-y-3">
          <p><strong>Description:</strong> <%= @event.description %></p>
          <p><strong>Location:</strong>
            <%= @event.district.name %>,
            <%= @event.county.name %>,
            <%= @event.sub_county.name %>
          </p>
          <p><strong>Start:</strong> <%= @event.start_date.to_formatted_s(:long) %></p>
          <p><strong>End:</strong> <%= @event.end_date.to_formatted_s(:long) %></p>
        </div>
      </div>
      <div>
        <h2 class="text-xl font-semibold mb-4">Participants (<%= @event_users.count %>)</h2>
        <% if @event_users.any? %>
          <div class="space-y-2">
            <% @event_users.each do |event_user| %>
              <div class="flex items-center justify-between p-3 bg-gray-50 rounded">
                <div>
                  <p class="font-medium"><%= event_user.user.email %></p>
                  <p class="text-sm text-gray-500">
                    Added <%= time_ago_in_words(event_user.created_at) %> ago
                  </p>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-gray-500">No participants yet.</p>
        <% end %>
      </div>
    </div>
  </div>
  <div class="mb-6 flex justify-around items-center">
    <%= link_to 'Add Individual Beneficiary',
              new_event_individual_beneficiary_path(@event),
              class: "bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded" %>
    <%= link_to 'Add Family Beneficiary',
              new_event_family_beneficiary_path(@event),
              class: "bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded" %>
    <%= link_to 'Add Organization Beneficiary',
              new_event_organization_beneficiary_path(@event),
              class: "bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded" %>
  </div>
  <div data-controller="event-tabs" class="bg-white rounded-lg shadow overflow-hidden">
    <div class="border-b border-gray-200">
      <nav class="flex -mb-px">
        <button
        data-event-tabs-target="button"
          data-action="click->event-tabs#switch"
          data-tab="#individual-tab"
          class="tab-button py-4 px-6 text-center border-b-2 font-medium text-sm"
          >
          Individual Beneficiaries
        </button>
        <button
        data-event-tabs-target="button"
          data-action="click->event-tabs#switch"
          data-tab="#family-tab"
          class="tab-button py-4 px-6 text-center border-b-2 font-medium text-sm"
          >
          Family Beneficiaries
        </button>
        <button
        data-event-tabs-target="button"
          data-action="click->event-tabs#switch"
          data-tab="#organization-tab"
          class="tab-button py-4 px-6 text-center border-b-2 font-medium text-sm"
          >
          Organization Beneficiaries
        </button>
        <button
        data-event-tabs-target="button"
          data-action="click->event-tabs#switch"
          data-tab="#inventory-tab"
          class="tab-button py-4 px-6 text-center border-b-2 font-medium text-sm"
          >
          Inventories
        </button>
      </nav>
    </div>
    <!-- Tab Contents -->
    <div id="individual-tab" data-event-tabs-target="content" class="tab-content p-6 hidden">
      <%= render "individual_beneficiaries/list", beneficiaries: @individual_beneficiaries %>
    </div>
    <div id="family-tab" data-event-tabs-target="content" class="tab-content p-6 hidden">
      <%= render "family_beneficiaries/list", beneficiaries: @family_beneficiaries %>
    </div>
    <div id="organization-tab" data-event-tabs-target="content" class="tab-content p-6 hidden">
      <%= render "organization_beneficiaries/list", beneficiaries: @organization_beneficiaries %>
    </div>
    <div id="inventory-tab" data-event-tabs-target="content" class="tab-content p-6 hidden">
      <%= render "inventories/list", inventories: @inventories %>
    </div>
  </div>
</div>