<div class="bg-primarycolor max-w-[350px] bg-gradient-to-t from-white to-primarycolor rounded-[40px] p-[25px_35px] border-[5px] border-white shadow-[rgba(133,189,215,0.88)_0px_30px_30px_-20px] m-5">
  <h2 class="text-center font-extrabold text-[30px] text-primarytext">Log in</h2>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-5" }) do |f| %>
    <div class="mb-4">
      <%= f.label :email, class: "block text-sm font-medium text-gray-700" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Enter your email", class: "w-full mt-1 p-4 rounded-[20px] bg-white border-none shadow-[0_10px_10px_-5px_#cff0ff] focus:outline-none focus:border-[#12B1D1] border-l-2 border-r-2" %>
    </div>
    <div class="mb-4">
      <%= f.label :password, class: "block text-sm font-medium text-gray-700" %>
      <%= f.password_field :password, autocomplete: "current-password", placeholder: "Enter your password", class: "w-full mt-1 p-4 rounded-[20px] bg-white border-none shadow-[0_10px_10px_-5px_#cff0ff] focus:outline-none focus:border-[#12B1D1] border-l-2 border-r-2" %>
    </div>
    <% if devise_mapping.rememberable? %>
      <div class="flex items-center mb-4">
        <%= f.check_box :remember_me, class: "mr-2" %>
        <%= f.label :remember_me, class: "text-sm text-gray-700" %>
      </div>
    <% end %>
    <%= f.submit "Log in", class: "w-full font-bold text-white bg-primarytext py-4 mt-6 rounded-[20px] shadow-[rgba(133,189,215,0.88)_0px_20px_10px_-15px] transition-transform duration-200 hover:scale-105 hover:shadow-[rgba(133,189,215,0.88)_0px_23px_10px_-20px] active:scale-95 active:shadow-[rgba(133,189,215,0.88)_0px_15px_10px_-10px]" %>
  <% end %>
  <div class="mt-3 ml-2">
    <%= link_to "Forgot your password?", new_password_path(resource_name), class: "text-[11px] text-[#0099ff] hover:underline" %>
  </div>
  <div class="mt-6 text-center">
  </div>
</div>
