<%= form_with(model: branch, local: true) do |form| %>
  <section class="custom-select md:p-10 sm:px-6 lg:px-8 py-8 sm:text-sm md:text-base lg:text-lg">
    <div class="bg-gradient-to-tr from-white from-40% via-primarycolor/50 via-90% to-red-600/40 to-100% transition duration-300 hover:shadow-xl md:p-12 p-4 rounded-lg shadow-lg">
      <div class="flex justify-between items-center h-auto gap-4 my-4">
        <button onclick="history.go(-1)" class="border rounded-lg flex items-center text-sm sm:text-base bg-gray-50 px-5 py-2 transition duration-300 ease-in-out">
          <i class="fa-solid fa-arrow-left"></i>
          <span class="ml-2 hidden lg:inline-block">Back</span>
        </button>
        <h2 class="text-3xl text-primarytextcolor font-bold text-center leading-tight">
          <%= branch.persisted? ? "Edit Branch" : "Create Branch" %>
        </h2>
      </div>
      <div class="bg-white/50 md:p-8 p-4 border rounded-lg">
        <div class="mb-4">
          <%= form.label :name, class: "block text-gray-700 font-bold mb-2" %>
          <%= form.text_field :name, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
        </div>
        <div class="mb-4">
          <%= form.label :phone_number, class: "block text-gray-700 font-bold mb-2" %>
          <%= form.text_field :phone_number, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
        </div>
        <div class="mb-4">
          <%= form.label :address, class: "block text-gray-700 font-bold mb-2" %>
          <%= form.text_field :address, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
        </div>
        <h3 class="text-xl my-4 font-semibold text-primarytextcolor mb-3 hover:text-gray-900 transition duration-200 underline">Assign Districts</h3>
        <div class="mb-4">
          <% if @unassigned_districts.any? %>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <% @unassigned_districts.each do |district| %>
                <div class="flex items-center bg-white border rounded p-2">
                  <%= check_box_tag "branch[district_ids][]", district.id, @branch.districts.include?(district), id: "district_#{district.id}", class: "mr-2 h-4 w-4 text-primarycolor focus:ring-primarycolor border-gray-300 rounded" %>
                  <%= label_tag "district_#{district.id}", district.name, class: "text-gray-700" %>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-gray-600 italic mt-2">All districts are already assigned. No available districts to assign.</p>
          <% end %>
        </div>
        <h3 class="text-xl my-4 font-semibold text-primarytextcolor mb-3 hover:text-gray-900 transition duration-200 underline">Assign Staff</h3>
        <div class= "grid md:grid-cols-3 sm:grid-cols-2 grid-cols-1 gap-5 ">
          <% User.all.each do |user| %>
            <div class="p-4 flex items-center mb-2 shadow-md rounded-lg my-5">
              <%= check_box_tag "branch[user_ids][]", user.id, @branch.users.include?(user),id:"user_#{user.id}" ,class: "mr-2 h-4 w-4 text-primarycolor focus:ring-primarycolor border-gray-300 rounded" %>
              <div class="w-14 h-14 ml-2 mr-1">
                <%=  image_tag user.profile_picture, alt: 'user.profile_picture', class: "rounded-full w-full h-full object-cover" %>
              </div>
              <div class="leading-tight">
                <%= label_tag "user_#{user.id}", "#{user.first_name}  #{user.last_name}", class: "" %>
                <div class="italic text-sm text-gray-700">
                  <%= user.role%>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        <div class="flex justify-center md:justify-end text-sm items-center mt-12 cursor-pointer">
          <%= link_to "Cancel", :back, class: "bg-gray-200 hover:bg-gray-300 text-gray-700 font-medium py-2 px-4 rounded text-sm transition duration-200 transform hover:scale-105" %>
          <%= form.submit branch.persisted? ? "Update" : "Create", class: "ml-2 bg-primarycolor hover:bg-hoverprimarycolor text-white font-bold py-2 px-6 rounded" %>
        </div>
      </div>
    </div>
  </section>
<% end %>
