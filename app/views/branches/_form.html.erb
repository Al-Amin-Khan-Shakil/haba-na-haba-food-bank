<%= form_with(model: branch, local: true) do |form| %>
  <section class="custom-select md:p-10 sm:px-6 lg:px-8 py-8 sm:text-sm md:text-base lg:text-lg">
    <div class="bg-gradient-to-tr from-white from-40% via-primarycolor/50 via-90% to-red-600/40 to-100% transition duration-300 hover:shadow-xl md:p-12 p-4 rounded-lg shadow-lg">
      <div class="flex justify-between items-center h-auto gap-4 my-4">
        <button onclick="history.go(-1)" class="rounded-lg flex items-center text-sm sm:text-base bg-gray-50 px-5 py-2 transition duration-300 ease-in-out">
          <i class="fa-solid fa-arrow-left"></i>
          <span class="ml-2 hidden lg:inline-block">Back</span>
        </button>
        <h2 class="text-lg lg:text-3xl text-primarytext font-bold text-center leading-tight">
          <span><%= branch.persisted? ? "Edit" : "Create" %></span>
          <span class="hidden md:inline-block">Branch</span>
        </h2>
      </div>
      <% if branch.errors.any? %>
        <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-4 rounded">
          <h2 class="font-bold text-red-700">
            <%= pluralize(branch.errors.count, "error") %> prohibited this branch from being saved:
          </h2>
          <ul class="list-disc pl-5 mt-2 text-red-600">
            <% branch.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <div class="bg-white md:p-8 p-4 border rounded-lg">
        <h3 class="text-xl my-4 font-semibold text-primarytextcolor mb-3 hover:text-gray-900 transition duration-200 underline">Branch Details</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="mb-4">
            <%= form.label :name, class: "block text-gray-700 font-bold mb-2" %>
            <%= form.text_field :name, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
          </div>
          <div class="mb-4">
            <%= form.label :phone_number, class: "block text-gray-700 font-bold mb-2" %>
            <%= form.text_field :phone_number, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
          </div>
          <div class="mb-4 md:col-span-2">
            <%= form.label :address, class: "block text-gray-700 font-bold mb-2" %>
            <%= form.text_area :address,rows:3, class: "bg-gray-50 border border-gray-300 rounded-lg p-2 w-full focus:outline-none focus:border-primarycolor focus:ring-1 focus:ring-primarycolor" %>
          </div>
        </div>
        <h3 class="text-xl my-4 font-semibold text-primarytextcolor mb-3 hover:text-gray-900 transition duration-200 underline">Assign Districts</h3>
        <div class="mb-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-2 mt-2">
            <% @unassigned_districts.each do |district| %>
              <div class="flex items-center">
                <%= check_box_tag "branch[district_ids][]", district.id, @branch.districts.include?(district),
                      id: "district_#{district.id}",
                      class: "mr-2 rounded border-gray-300 text-primarycolor focus:ring-primarycolor" %>
                <%= label_tag "district_#{district.id}", district.name, class: "text-gray-700" %>
              </div>
            <% end %>
          </div>
        </div>
        <div class="flex justify-center md:justify-end text-sm items-center mt-6">
          <%= link_to "Cancel", :back, class: "bg-gray-200 hover:bg-gray-300 text-gray-700 font-medium py-2 px-4 rounded text-sm transition duration-200 transform hover:scale-105" %>
          <%= form.submit branch.persisted? ? "Update" : "Create", class: "ml-2 bg-primarycolor hover:bg-hoverprimarycolor text-white font-bold py-2 px-4 rounded" %>
        </div>
      </div>
    </div>
  </section>
<% end %>
