<h1>Branches</h1>
<%= link_to 'New Branch', new_branch_path, class: "bg-green-500 text-white py-2 px-4 rounded" %>
<table class="table-auto w-full mt-4">
  <thead>
    <tr>
      <th class="px-4 py-2">Name</th>
      <th class="px-4 py-2">Phone</th>
      <th class="px-4 py-2">Address</th>
      <th class="px-4 py-2">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @branches.each do |branch| %>
      <tr>
        <td class="border px-4 py-2"><%= branch.name %></td>
        <td class="border px-4 py-2"><%= branch.phone_number %></td>
        <td class="border px-4 py-2"><%= branch.address %></td>
        <td class="border px-4 py-2">
          <%= link_to 'Show', branch_path(branch), class: "text-blue-500" %> |
          <%= link_to 'Edit', edit_branch_path(branch), class: "text-yellow-500" %> |
          <%= link_to 'Destroy', branch_path(branch), method: :delete, data: { confirm: "Are you sure?" }, class: "text-red-500" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
