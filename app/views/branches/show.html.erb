<div class="sm:p-4 md:p-6 lg:p-8 bg-gray-50">
  <div class="min-w-full bg-gradient-to-tr from-white from-40% via-primarycolor/50 via-90% to-red-600/40 to-100% text-white shadow-xl rounded-xl p-3 sm:p-8 mb-8">
    <div class="flex justify-between items-center mb-4">
      <%= link_to branches_path, class: "flex items-center text-sm sm:text-base text-gray-500 py-1 px-4 rounded bg-gray-200 hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400 transition duration-300 ease-in-out" do %>
        <i class="fa-solid fa-arrow-left"></i>
        <span class="ml-2 hidden lg:inline-block">Back</span>
      <% end %>
      <h2 class="text-3xl text-primarytext font-bold text-center leading-tight">Details</h2>
    </div>
    <div class="bg-white/50 md:p-6 p-2 shadow rounded-lg">
      <p class="text-primarytext text-2xl font-bold text-center leading-tight p-2 shadow-lg hover:shadow-xl transition-all duration-300 ease-in-out rounded-lg mb-4"><%= @branch.name %></p>
      <div class="text-[#5a607a] bg-white/20 md:p-4 p-2 border-l border-b rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 ease-in-out">
        <p><span class="inline-block w-[85px] font-bold">Phone:</span><span> <%= @branch.phone_number %></span></p>
        <p><span class="inline-block w-[85px] font-bold">Address:</span><span> <%= @branch.address %></span></p>
        <p class="text-lg font-semibold text-primarytext my-2">Assigned Districts</p>
        <% if @branch.districts.any? %>
          <ul class="list-none flex gap-2 flex-wrap text-[#5a607a]">
            <% @branch.districts.each do |district| %>
              <li class="p-2 bg-white shadow rounded-lg"><%= district.name %></li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-gray-500">No districts assigned.</p>
        <% end %>
      </div>
    </div>
    <div class="mt-8 flex justify-end items-center gap-4">
      <%= link_to 'Edit', edit_branch_path(@branch), class: 'bg-primarycolor text-white py-1 px-4 w-fit rounded hover:bg-hoverprimarycolor transition-all text-sm sm:text-base' %>
      <%= button_to 'Destroy', branch_path(@branch), method: :delete, data: { confirm: 'Are you sure?' }, class: 'bg-red-600 text-white py-1 px-4 w-fit rounded hover:bg-red-700 transition-all text-sm sm:text-base' %>
    </div>
  </div>
</div>
</div>
