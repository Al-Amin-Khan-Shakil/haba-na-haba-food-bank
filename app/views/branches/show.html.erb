<div class="max-w-3xl mx-auto mt-8 bg-white p-6 rounded-xl shadow-md">
  <h1 class="text-2xl font-bold mb-4 text-gray-800">Branch Details</h1>
  <div class="mb-6">
    <p><strong class="text-gray-600">Name:</strong> <%= @branch.name %></p>
    <p><strong class="text-gray-600">Phone Number:</strong> <%= @branch.phone_number %></p>
    <p><strong class="text-gray-600">Address:</strong> <%= @branch.address %></p>
  </div>
  <div>
    <h2 class="text-xl font-semibold text-gray-700 mb-2">Assigned Districts</h2>
    <% if @branch.districts.any? %>
      <ul class="list-disc list-inside text-gray-700 space-y-1">
        <% @branch.districts.each do |district| %>
          <li><%= district.name %></li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-gray-500">No districts assigned.</p>
    <% end %>
  </div>
  <div class="mt-6 flex space-x-4">
    <%= link_to 'Edit Branch', edit_branch_path(@branch), class: "px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600" %>
    <%= link_to 'Back to Branches', branches_path, class: "px-4 py-2 bg-gray-300 text-gray-800 rounded hover:bg-gray-400" %>
  </div>
</div>
